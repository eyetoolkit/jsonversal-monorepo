{
  "name": "jsonversal-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "description": "jsonversal monorepo — one site, four sections (/tools /sec /devops /codegen)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm astro dev --root apps/main",
    "build": "turbo run build",
    "build:main": "pnpm astro build --root apps/main",
    "preview": "pnpm astro preview --root apps/main"
  },
  "devDependencies": {
    "astro": "^4.16.18",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}