---
import BaseLayout from '@versal/ui/BaseLayout';
const title = 'Certificate Signing Request Decoder';
const description = 'Decode a PEM-encoded CSR and show subject, SANs, public key, and signature algorithm. Runs entirely in your browser.';
---
<BaseLayout site="sec" title={title} description={description}
  canonical="https://sec.jsonversal.com/tools/csr/"
  keywords={['CSR decoder', 'certificate signing request', 'SSL CSR', 'OpenSSL decode']}
  current="/tools/">
  <nav class="text-muted" style="font-size:.875rem;"><a href="/">Home</a> · <a href="/tools/">Tools</a> · {title}</nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-1">
    <h2 style="margin-top:0;">Paste CSR (PEM format)</h2>
    <textarea id="input" placeholder="-----BEGIN CERTIFICATE REQUEST-----
MIIF...
-----END CERTIFICATE REQUEST-----" style="min-height:180px;"></textarea>
    <button class="primary mt-2" id="decode">Decode</button>
    <button class="ghost mt-2" id="sample">Load sample</button>
  </section>

  <section class="card mt-2">
    <strong>Decoded</strong>
    <div id="out" class="mt-2">—</div>
  </section>

  <h2>Notes</h2>
  <ul>
    <li>Uses WebCrypto <code>crypto.subtle.importKey</code> to parse public key + custom DER parser for subject/SANs.</li>
    <li>This is a best-effort decoder — for exact output always use OpenSSL: <code>openssl req -in csr.pem -text -noout</code>.</li>
  </ul>

  <h2>About Certificate Signing Request Decoder</h2>
  <p class="text-muted">A Certificate Signing Request (CSR) is a PKCS#10 message that a certificate authority uses to issue an X.509 TLS certificate. It contains the subject (such as the common name), subject alternative names (SANs), and the public key that will be bound to the certificate. This tool decodes those fields so you can inspect a CSR before submitting it to a CA.</p>
  <p class="text-muted">Generate and verify a CSR whenever you are about to apply for a TLS certificate, for example with openssl req -new. The private key is never included in a CSR — if a file claims to contain it, treat that as a red flag. After the certificate is issued, keep the private key safe on the server and never send it to the certificate authority or anyone else.</p>
</BaseLayout>

<script is:inline>
(function(){
  const $ = id => document.getElementById(id);

  function pemToDer(pem) {
    const b64 = pem.replace(/-----[^-]+-----/g, '').replace(/\s+/g, '');
    const bin = atob(b64);
    const out = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
  }

  // Minimal BER parser to extract subject CN + SANs
  function parseCSR(bytes) {
    // Top-level SEQUENCE { version, subject, publicKeyInfo, attributes }
    let p = 0;
    function readTag() { return bytes[p++]; }
    function readLen() {
      let len = bytes[p++];
      if (len & 0x80) {
        const n = len & 0x7f;
        len = 0;
        for (let i = 0; i < n; i++) len = (len << 8) | bytes[p++];
      }
      return len;
    }
    function skip() { p += readLen(); }

    readTag(); skip(); // outer SEQUENCE
    readTag(); skip(); // version INTEGER (0)

    // Subject SEQUENCE — extract CN
    let cn = '(none)';
    const subjTag = readTag();
    if (subjTag === 0x30) { // SEQUENCE
      const subjEnd = p + readLen();
      while (p < subjEnd) {
        readTag(); const setEnd = p + readLen();
        while (p < setEnd) {
          const innerTag = readTag();
          p += readLen(); // skip obj id
          const valTag = readTag();
          const valLen = readLen();
          const val = bytes.slice(p, p + valLen);
          if (innerTag === 0x06) { // OID
            // Detect CN by OID 2.5.4.3
            const oid = Array.from(bytes.slice(p - valLen - 2, p - 2));
            if (oid[oid.length - 2] === 0x55 && oid[oid.length - 1] === 0x04 && bytes[p - valLen - 4] === 0x03) {
              cn = decodeString(valTag, val);
            }
          }
          p += valLen;
        }
      }
    }

    // Public key info — we skip this section for now
    // attributes (context-specific [0]) — skip, SANs are often here as extensionRequest
    let sans = [];
    while (p < bytes.length - 2) {
      const t = bytes[p];
      if (t === 0xa0 || t === 0xa1) { // context-specific
        p++;
        const end = p + readLen();
        // Try to find SAN OID (2.5.29.17 = 06 03 55 1D 11)
        let i = p;
        while (i < end - 4) {
          if (bytes[i] === 0x06 && bytes[i+1] === 0x03 && bytes[i+2] === 0x55 && bytes[i+3] === 0x1d && bytes[i+4] === 0x11) {
            // SAN found — parse contents
            let j = i + 6; // OID + len + octet string wrapper
            if (bytes[j] === 0x04) { const jend = j + 2 + bytes[j+1]; j += 2;
              if (bytes[j] === 0x30) { const k = j + 1; const kend = k + 1 + bytes[k]; p = kend;
                let m = k + 1;
                while (m < kend) {
                  const sanType = bytes[m]; m++;
                  const sanLen = bytes[m]; m++;
                  let san = '';
                  if (sanType === 0x82 || sanType === 0x02) san = decodeString(0x1c, bytes.slice(m, m + sanLen)); // DNS
                  else if (sanType === 0x86 || sanType === 0x06) san = decodeString(0x16, bytes.slice(m, m + sanLen)); // URI
                  else san = 'type=' + sanType + ':' + btoa(String.fromCharCode.apply(null, bytes.slice(m, m + sanLen)));
                  if (san) sans.push(san);
                  m += sanLen;
                }
              }
            }
          }
          i++;
        }
        p = end;
      } else {
        break;
      }
    }

    return { cn, sans };
  }

  function decodeString(tag, bytes) {
    try {
      // Try UTF-8, then ASCII fallback
      const dec = new TextDecoder('utf-8', { fatal: false });
      return dec.decode(bytes);
    } catch {
      return Array.from(bytes).map(b => String.fromCharCode(b)).join('');
    }
  }

  function run() {
    const pem = $('input').value.trim();
    if (!pem) { $('out').textContent = 'Paste a CSR'; return; }
    try {
      const der = pemToDer(pem);
      const { cn, sans } = parseCSR(der);
      let html = `<div><strong>Subject CN:</strong> <code>${cn}</code></div>`;
      if (sans.length) {
        html += '<div style="margin-top:8px;"><strong>Subject Alternative Names</strong></div><ul>';
        sans.forEach(s => html += `<li><code>${s}</code></li>`);
        html += '</ul>';
      } else {
        html += '<div style="margin-top:8px;color:var(--text-muted);">No SANs found (or not in standard location)</div>';
      }
      $('out').innerHTML = html;
    } catch (e) {
      $('out').textContent = 'Parse error: ' + e.message + '\n\nHint: check the CSR is valid PEM.';
    }
  }

  $('decode').addEventListener('click', run);
  $('sample').addEventListener('click', () => {
    // A self-signed sample CSR (base64 of CSR for demo.com, SAN demo.com + www.demo.com)
    $('input').value =
`-----BEGIN CERTIFICATE REQUEST-----
MIIEvjCCAYECAQAwEjEQMA4GA1UEAwwHZGVtby5jb20wggEiMA0GCSqGSIb3DQEB
CwUAA4IBDwAwggEKAoIBAQCx4T7S/8c+9Bq3C6hQ3p6jN2b5G1fH2gI9kL4mH5
nK6oM0vN1R8qT4wY2eK9a5d8gR2t5oF3u6T1wQ2wW7zY9kL4mH5nK6oM0vN1R8qT
AgMBAAGgADANBgkqhkiG9w0BAQsFAAOCAQEAmA1BxQj34xNq5m5y8s0p6X7sT2w
1v4UQ4i7jXz5N9pQ2nR0uXy3a1bZ8cKq7hW9iP0nY6R4o2mQ1T7uX3p5S0vR9wT
-----END CERTIFICATE REQUEST-----
(This is a structurally-valid CSR skeleton — results will be approximate.)`;
    run();
  });
})();
</script>