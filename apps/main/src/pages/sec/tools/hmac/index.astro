---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "HMAC Generator  — Sign Messages with SHA-256";
const description = "Compute HMAC-SHA256, HMAC-SHA384, or HMAC-SHA512 signatures for any message and secret key, in hex and base64. Runs locally with Web Crypto.";
const faqs = [
  {
    "question": "How do I compute an HMAC?",
    "answer": "Enter your message and secret key, select the hash algorithm (SHA-256, SHA-1, or MD5), and click Compute. The HMAC is computed using the Web Crypto API entirely in your browser. The result is shown as a hex string."
  },
  {
    "question": "Why use HMAC instead of a regular hash?",
    "answer": "A regular hash (SHA-256) is not authenticated \u2014 anyone can compute it. HMAC adds a secret key to the computation, producing a tamper-evident digest. If the message or key changes, the HMAC value changes. Used for API signatures and message authentication."
  }
];
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';
---

<ToolPage
  site="sec"
  title={title}
  description={description}
  canonical="https://jsonversal.com/sec/tools/hmac/"
  current="/sec/tools/hmac/"
  faqs={faqs}
  about={[
    {
      "heading": "Why HMAC-SHA256 became the default",
      "body": [
        "A plain digest is public knowledge: anyone can recompute SHA-256 over your payload, so it detects corruption but offers no protection against forgery. HMAC folds a shared secret into the computation, which means producing a valid tag requires a value the verifier alone holds. That combination — keyed, fixed-length, no key exchange, cheap to verify — is why Stripe, GitHub and Slack webhook signatures all settled on HMAC-SHA256.",
        "The key is zero-padded to the 64-byte block size, or hashed first if it is longer, and the two XOR pads are what make the construction resistant to length-extension style attacks that would break a naive `hash(key || message)`. The result is always 256 bits for SHA-256 regardless of message size, and any single-bit change anywhere in the input yields an unrelated tag."
      ]
    },
    {
      "heading": "Details that break real integrations",
      "body": [
        "Encoding is part of the contract, not a presentation choice. This page prints lowercase hex and standard base64, and base64 of a tag contains `+` and `/`, both of which need percent-encoding in a query string or a URL path segment. Most libraries default to lowercase hex, so match whatever your provider documents rather than assuming the base64 form is interchangeable.",
        "Any key length is accepted because Web Crypto pads to the block size internally — a short key works, and a short key is still a weak key. Use at least 32 random bytes drawn from a CSPRNG. Whitespace is part of the message: signing a JSON string signs the exact bytes including spaces and newlines, so both sides must serialise identically or the tags will never match."
      ]
    },
    {
      "heading": "Signing is not verifying",
      "body": [
        "This page signs and does not verify, and verification is where the subtle bug lives. Comparing two tags with `===` short-circuits at the first differing byte, leaking through response timing how much of a forged tag was correct — enough to recover a valid tag one byte at a time. Use `crypto.subtle.verify('HMAC', key, tag, message)`, which compares in constant time internally and returns the boolean without you writing the loop.",
        "One boundary condition to note: the UI rejects an empty message, so a zero-length body cannot be signed here. If a provider allows one, sign it with your own code. And keep the two properties separate in your head — an HMAC proves the message came from someone holding the secret and was not altered, but says nothing about confidentiality. For that, combine HMAC with an authenticated cipher such as AES-GCM."
      ]
    }
  ]}
>

  <section class="card mt-1">
    <h2 class="h2-card">Input</h2>
    <label class="text-muted" for="msg">Message</label>
    <label for="msg" class="sr-only">Input</label>
    <textarea id="msg" placeholder="Message to sign..." style="min-height:120px;"></textarea>
    <label class="text-muted" style="margin-top:12px;" for="secret">Secret key</label>
    <label for="secret" class="sr-only">Secret key</label> <input id="secret" type="text" placeholder="Shared secret key" />
    <label class="text-muted" style="margin-top:12px;" for="algo">Algorithm</label>
    <label for="algo" class="sr-only">Input</label> <select id="algo">
      <option value="SHA-256">SHA-256 (recommended)</option>
      <option value="SHA-384">SHA-384</option>
      <option value="SHA-512">SHA-512</option>
    </select>
    <div class="row mt-2">
      <button class="primary" id="compute">Compute</button>
    </div>
  </section>

  <section class="card mt-2">
    <strong>HMAC (hex)</strong>
    <pre id="hex-out" class="mt-2" style="display:none;white-space:pre-wrap;word-break:break-all;"></pre>
    <button class="ghost mt-1" id="copy-hex" style="display:none;">Copy hex</button>
    <strong style="display:block;margin-top:16px;">HMAC (base64)</strong>
    <pre id="b64-out" class="mt-2" style="display:none;white-space:pre-wrap;word-break:break-all;"></pre>
    <button class="ghost mt-1" id="copy-b64" style="display:none;">Copy base64</button>
  </section>

  <section class="card mt-2">
    <strong>Error</strong>
    <div id="err" class="mt-2" style="display:none;"></div>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>HMAC wraps the chosen hash algorithm with a secret key: the key is padded, XOR-mixed into two inner/outer pads, and hashed in a specific order.</li>
    <li>The result has the same length as the underlying hash  — 256, 384, or 512 bits  — regardless of message or key length.</li>
    <li>Computing the same HMAC requires the shared secret, so a valid signature proves the message came from someone who knows the key.</li>
    <li>Everything is calculated in your browser with <code>crypto.subtle</code>; no data is sent anywhere.</li>
  </ul>

  <h2>About HMAC</h2>
  <p class="text-muted">HMAC (Hash-based Message Authentication Code) is a keyed hash: it combines a hash function such as SHA-256 with a shared secret to produce a signature that verifies both integrity and authenticity. Unlike a plain hash, which anyone can recompute, an HMAC is unpredictable without the key  — changing even one bit of the message produces a completely different signature. The secret is the root of trust, and the message can be stored or transmitted openly.</p>
  <p class="text-muted">Use HMAC whenever two parties share a secret and need to prove messages were not tampered with or forged: API request signing, webhook payload verification, and session tokens are the most common cases. Never use a plain hash for these  — an attacker can recompute MD5 or SHA-256 without the key. Keep the secret key out of client-side code, rotate it periodically, and use separate keys for different purposes. The signature authenticates, but it does not encrypt: if confidentiality is also needed, combine HMAC with encryption (for example, AES-GCM).</p>
</ToolPage>

<style>
  .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  #err { color: var(--danger); }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);
  const enc = new TextEncoder();

  function toHex(buf) {
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }
  function toB64(buf) {
    const bin = Array.from(new Uint8Array(buf)).map(b => String.fromCharCode(b)).join('');
    return btoa(bin);
  }

  async function run() {
    const msg = $('msg').value;
    const secret = $('secret').value;
    const algo = $('algo').value;
    const err = $('err');
    err.style.display = 'none';
    if (!msg) { showToast('Please enter a message.'); return; }
    if (!secret) { showToast('Please enter a secret key.'); return; }

    try {
      const key = await crypto.subtle.importKey('raw', enc.encode(secret), { name: 'HMAC', hash: algo }, false, ['sign']);
      const sig = await crypto.subtle.sign('HMAC', key, enc.encode(msg));
      $('hex-out').textContent = toHex(sig);
      $('b64-out').textContent = toB64(sig);
      $('hex-out').style.display = 'block';
      $('b64-out').style.display = 'block';
      $('copy-hex').style.display = 'inline-block';
      $('copy-b64').style.display = 'inline-block';
    } catch (e) {
      err.textContent = 'Error: ' + e.message;
      err.style.display = 'block';
    }
  }

  $('compute').addEventListener('click', run);

  $('copy-hex').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText($('hex-out').textContent);
      $('copy-hex').textContent = 'Copied!';
      setTimeout(() => { $('copy-hex').textContent = 'Copy hex'; }, 1200);
    } catch {}
  });
  $('copy-b64').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText($('b64-out').textContent);
      $('copy-b64').textContent = 'Copied!';
      setTimeout(() => { $('copy-b64').textContent = 'Copy base64'; }, 1200);
    } catch {}
  });
})();
</script>
