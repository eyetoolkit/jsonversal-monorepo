---
import BaseLayout from '@versal/ui/BaseLayout';
const title = 'Password-Based Encryption (PBKDF2 + AES-GCM)';
const description = 'Encrypt and decrypt text with a password using PBKDF2 key derivation and AES-256-GCM. Everything happens in your browser with Web Crypto — the key is derived locally and never leaves your device.';
---
<BaseLayout site="sec" title={title} description={description}
  canonical="https://jsonversal.com/sec/tools/password-encrypt/"
  keywords={['password-based encryption', 'PBKDF2', 'AES-GCM', 'encrypt text', 'decrypt text']}
  current="/sec/tools/">
  <nav class="text-muted" style="font-size:.875rem;"><a href="/">Home</a> · <a href="/tools/">Tools</a> · {title}</nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-1">
    <div class="row">
      <h2 style="margin-top:0;margin-bottom:0;">Operation</h2>
      <select id="mode" aria-label="Operation">
        <option value="encrypt" selected>Encrypt</option>
        <option value="decrypt">Decrypt</option>
      </select>
    </div>

    <div class="row mt-2">
      <div style="flex:1;min-width:220px;">
        <label class="text-muted" for="pw">Password</label>
        <input id="pw" type="password" autocomplete="off" placeholder="Passphrase used to derive the key" />
      </div>
      <div>
        <label class="text-muted" for="iters">Iterations (min 10000)</label>
        <input id="iters" type="number" min="10000" step="10000" value="100000" />
      </div>
      <div style="flex:1;min-width:220px;">
        <label class="text-muted" id="salt-label" for="salt">Salt (optional — random 16 bytes if blank)</label>
        <input id="salt" type="text" placeholder="Optional custom salt text" />
      </div>
    </div>

    <label class="text-muted mt-2" id="data-label" for="data">Plaintext to encrypt</label>
    <textarea id="data" placeholder="Type the message you want to encrypt…"></textarea>

    <div class="row mt-1">
      <button class="primary" id="run">Encrypt</button>
      <button class="ghost" id="copy-result">Copy result</button>
      <button class="ghost" id="sample">Load sample</button>
    </div>
    <div class="text-dim" id="size" style="font-size:.85rem;margin-top:8px;"></div>
  </section>

  <section class="card mt-2">
    <label class="text-muted" for="result">Result</label>
    <textarea id="result" readonly placeholder="Output appears here…"></textarea>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <strong>Error</strong>
    <pre id="err-out" style="color:var(--danger);"></pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li><strong>Encrypt</strong> derives a 256-bit AES key from your password with PBKDF2 (SHA-256), using a random 16-byte salt and the iteration count you choose, then seals the message with AES-256-GCM using a random 12-byte IV.</li>
    <li>The output payload is <code>v1:salt:iv:ciphertext</code>, where each part is base64 — the salt and IV travel with the ciphertext so the recipient needs only the password to decrypt.</li>
    <li><strong>Decrypt</strong> parses the payload, re-derives the same key with your password and the same iteration count, and verifies the GCM authentication tag. A wrong password or a corrupted payload fails authentication and reports <em>wrong password or corrupted data</em>.</li>
    <li>AES-GCM authenticates as well as encrypts: any tampering is detected, not silently accepted. Key derivation runs fully locally via <code>crypto.subtle</code> — nothing is uploaded.</li>
  </ul>

  <h2>About Password-Based Encryption</h2>
  <p class="text-muted">Password-based encryption converts a human-memorable secret into a strong symmetric key. The iteration count slows down brute-force attacks: 100000 PBKDF2 rounds means each guess costs a measurable amount of CPU, so weak passphrases are much harder to crack than with a single hash round. Higher is stronger but slower — on modern hardware 100000–600000 rounds is a reasonable range for interactive use.</p>
  <p class="text-muted">Two warnings: first, the iteration count is deliberately not stored in the payload, so you must remember the same value you used to encrypt. Second, GCM requires a unique IV per encryption — this tool generates a fresh random IV every time, so encrypting the same message twice gives different ciphertexts. Store the full <code>v1:</code> payload; losing the salt or IV makes the data unrecoverable even with the correct password.</p>
</BaseLayout>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .row > div { display: flex; flex-direction: column; gap: 4px; }
  textarea { min-height: 110px; }
  .mt-2 { margin-top: 16px; }
  .mt-1 { margin-top: 8px; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  function bufToB64(buf) {
    let bin = '';
    const bytes = new Uint8Array(buf);
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  }
  function b64ToBuf(b64) {
    const bin = atob(b64.replace(/\s+/g, ''));
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer;
  }

  function showErr(msg) {
    $('err-out').textContent = msg;
    $('err-section').style.display = 'block';
  }
  function hideErr() {
    $('err-section').style.display = 'none';
  }
  function parseIters() {
    const v = parseInt($('iters').value, 10);
    if (isNaN(v) || v < 10000) return 100000;
    return Math.min(v, 10000000);
  }

  function mode() { return $('mode').value; }

  function updateModeUI() {
    const m = mode();
    $('run').textContent = m === 'encrypt' ? 'Encrypt' : 'Decrypt';
    if (m === 'encrypt') {
      $('data-label').textContent = 'Plaintext to encrypt';
      $('data').placeholder = 'Type the message you want to encrypt…';
      $('salt').disabled = false;
      $('salt-label').textContent = 'Salt (optional — random 16 bytes if blank)';
    } else {
      $('data-label').textContent = 'Ciphertext to decrypt';
      $('data').placeholder = 'Paste the full v1:salt:iv:ciphertext payload…';
      $('salt').disabled = true;
      $('salt-label').textContent = 'Salt (ignored when decrypting — comes from the payload)';
    }
    hideErr();
  }

  async function deriveKey(password, saltBytes, iters) {
    const pwKey = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
    return crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: saltBytes, iterations: iters, hash: 'SHA-256' },
      pwKey,
      { name: 'AES-GCM', length: 256 },
      false,
      ['encrypt', 'decrypt']
    );
  }

  function setBusy(b) {
    const btn = $('run');
    btn.disabled = b;
    btn.textContent = b ? 'Working…' : (mode() === 'encrypt' ? 'Encrypt' : 'Decrypt');
  }

  $('run').addEventListener('click', async () => {
    hideErr();
    const password = $('pw').value;
    if (!password) { showErr('Enter a password first.'); return; }

    setBusy(true);
    try {
      if (mode() === 'encrypt') {
        const data = $('data').value;
        const iters = parseIters();
        const saltText = $('salt').value.trim();
        const saltBytes = saltText ? new TextEncoder().encode(saltText) : crypto.getRandomValues(new Uint8Array(16));
        const key = await deriveKey(password, saltBytes, iters);
        const iv = crypto.getRandomValues(new Uint8Array(12));
        const ct = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, new TextEncoder().encode(data));
        const out = 'v1:' + bufToB64(saltBytes) + ':' + bufToB64(iv) + ':' + bufToB64(ct);
        $('result').value = out;
        $('size').textContent = 'Encrypted payload: ' + ct.byteLength + ' bytes (base64 output: ' + out.length + ' chars).';
      } else {
        const payload = $('data').value.trim();
        const parts = payload.split(':');
        if (parts.length !== 4 || parts[0] !== 'v1') {
          showErr('Invalid payload. Expected format: v1:salt:iv:ciphertext (4 base64 parts).');
          return;
        }
        let saltBytes, iv, ct;
        try {
          saltBytes = new Uint8Array(b64ToBuf(parts[1]));
          iv = new Uint8Array(b64ToBuf(parts[2]));
          ct = b64ToBuf(parts[3]);
        } catch {
          showErr('Invalid payload — the base64 parts could not be decoded.');
          return;
        }
        const iters = parseIters();
        const key = await deriveKey(password, saltBytes, iters);
        try {
          const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, ct);
          $('result').value = new TextDecoder().decode(plain);
          $('size').textContent = 'Decrypted ' + plain.byteLength + ' bytes.';
        } catch {
          showErr('Decryption failed — wrong password or corrupted data.');
          return;
        }
      }
    } catch (e) {
      showErr(mode() === 'encrypt' ? 'Encryption failed: ' + e.message : 'Decryption failed: ' + e.message);
    } finally {
      setBusy(false);
    }
  });

  $('copy-result').addEventListener('click', async () => {
    if (!$('result').value) return;
    try {
      await navigator.clipboard.writeText($('result').value);
      $('copy-result').textContent = 'Copied!';
      setTimeout(() => { $('copy-result').textContent = 'Copy result'; }, 1200);
    } catch {}
  });

  $('sample').addEventListener('click', () => {
    $('mode').value = 'encrypt';
    updateModeUI();
    $('pw').value = 'sample-password-123';
    $('iters').value = '100000';
    $('salt').value = '';
    $('data').value = 'Top secret sample message — encrypt me!';
    $('result').value = '';
    $('size').textContent = '';
    hideErr();
  });

  $('mode').addEventListener('change', updateModeUI);

  if (!(window.crypto && crypto.subtle)) {
    showErr('Web Crypto (crypto.subtle) is unavailable — this tool requires HTTPS or localhost.');
    $('run').disabled = true;
  }
})();
</script>
