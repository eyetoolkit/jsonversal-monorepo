---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "Hash & HMAC Generator  — MD5, SHA-1 to SHA-512";
const description = "Generate MD5, SHA-1, SHA-256, SHA-384, SHA-512 hashes and HMAC signatures from text or files. Everything runs in your browser via the Web Crypto API.";
const faqs = [
  {
    "question": "How do I generate a hash from a string?",
    "answer": "Enter your text, select the algorithm (MD5, SHA-1, SHA-256, SHA-384, or SHA-512), and the hash is computed instantly in your browser. The result is shown as a hexadecimal string with an option to copy it."
  },
  {
    "question": "Is the hashing done locally?",
    "answer": "Yes. All hashing uses the Web Crypto API (SubtleCrypto.digest) entirely in your browser. Your input text never leaves your device and is not stored or logged anywhere."
  },
  {
    "question": "What is the difference between SHA-256 and SHA-512?",
    "answer": "SHA-256 produces a 256-bit (64-character hex) hash; SHA-512 produces a 512-bit (128-character hex) hash. SHA-512 is more collision-resistant but slightly slower. For most security uses SHA-256 is sufficient; use SHA-512 when maximum cryptographic strength is required."
  }
];
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';
---

<ToolPage
  site="sec"
  title={title}
  description={description}
  canonical="https://jsonversal.com/sec/tools/hash-generator/"
  current="/sec/tools/hash-generator/"
  faqs={faqs}
  about={[
    {
      "heading": "The keyed half: what HMAC mode changes",
      "body": [
        "In Hash mode this is a plain digest with a single-algorithm selector. Flip Mode to HMAC and a key field appears; the output then comes from `crypto.subtle.sign('HMAC', key, data)`, which is a keyed construction rather than a bare hash. The key is imported with `extractable=false` and `usages:['sign']`, so the raw secret cannot be read back out of the CryptoKey object even in the same page context.",
        "Structurally, HMAC pads the key out to the block size and XORs it into two constants to produce an inner and an outer pad, then computes `H(outer || H(inner || message))`. That nesting is why the output is always exactly as long as the underlying hash no matter how long the message or key is, and why the tag is unforgeable without the secret even though the hash function itself is public."
      ]
    },
    {
      "heading": "Where this differs from the plain hash view",
      "body": [
        "Three differences are worth knowing if you use both pages. This one computes one algorithm at a time and you choose which, where the sibling page computes all of them simultaneously. This one outputs hex only. And this one bundles a working MD5 implementation, because Web Crypto has no MD5 — that is a compatibility feature, not an endorsement, so keep confining it to reproducing legacy checksums.",
        "Text is encoded as UTF-8 through `TextEncoder`, and results recompute as you type in Hash mode, which makes the avalanche effect visible as you hold the Shift key: one character in, a completely unrelated digest out. Switching algorithm or mode also recomputes immediately, so you can watch SHA-256 and SHA-512 diverge on identical input rather than taking the difference on faith."
      ]
    },
    {
      "heading": "Two caveats in the file path",
      "body": [
        "File input takes the same route as typed text, which is the point: every algorithm, keyed or unkeyed, reads the raw bytes rather than a UTF-8 decoding of them. The distinction is invisible for ASCII and decisive for everything else, because decoding a binary file to text replaces every invalid byte sequence with U+FFFD and produces a digest of the wrong data while looking perfectly successful. SubtleCrypto's digest is a one-shot API rather than a stream, so the whole file is read into memory before hashing; for inputs in the hundreds of megabytes a native command-line tool is the better choice.",
        "One consequence of routing every algorithm through the same byte path is that a loaded file cannot be re-hashed from the input field, because the field holds a description rather than the content. Hashing that description instead would silently produce a digest of a placeholder string, so re-running is a no-op until you load the file again. For the same reason a very large file is held in memory as a single ArrayBuffer; everything smaller is byte-exact."
      ]
    }
  ]}
>

  <div class="card mt-2">
    <div class="row" style="gap:8px;margin-bottom:12px;">
      <label class="text-muted">Algorithm</label>
      <select id="algo">
        <option value="MD5">MD5 (fast, non-secure)</option>
        <option value="SHA-1">SHA-1 (legacy, non-secure)</option>
        <option value="SHA-256" selected>SHA-256</option>
        <option value="SHA-384">SHA-384</option>
        <option value="SHA-512">SHA-512</option>
      </select>
      <label class="text-muted" style="margin-left:12px;">Mode</label>
      <select id="mode">
        <option value="hash" selected>Hash</option>
        <option value="hmac">HMAC</option>
      </select>
      <label class="text-muted" id="keyLabel" style="margin-left:12px;display:none;">HMAC Key</label>
      <input id="hmacKey" type="text" placeholder="secret-key" style="display:none;padding:6px 10px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface-2);" />
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div>
        <strong>Input</strong>
        <label for="input" class="sr-only">Input</label>
        <textarea id="input" spellcheck="false" placeholder='Type or paste text to hash…' style="min-height:180px;margin-top:8px;"></textarea>
      </div>
      <div>
        <strong>Output</strong>
        <label for="output" class="sr-only">Output</label>
        <textarea id="output" readonly placeholder='Hex hash appears here' style="min-height:180px;margin-top:8px;background:var(--surface-2);font-family:var(--font-mono);"></textarea>
      </div>
    </div>
    <div class="row mt-1" style="gap:8px;">
      <button class="primary" id="run">Generate</button>
      <button class="ghost" id="copy">Copy</button>
      <button class="ghost" id="clear">Clear</button>
      <button class="ghost" id="fileBtn" style="margin-left:auto;">Upload file to hash…</button>
      <input type="file" id="fileInput" style="display:none;" />
    </div>
  </div>

  <h2>How it works</h2>
  <ul>
    <li><strong>Hash</strong>  — one-way function that maps any input size to a fixed-size fingerprint. The same input always produces the same output; tiny input changes produce completely different hashes (avalanche effect).</li>
    <li><strong>HMAC</strong>  — Hash-based Message Authentication Code. Combines a secret key with the input so that only someone with the key can produce the correct MAC. Used for API signature verification (AWS, Stripe, GitHub webhooks).</li>
    <li><strong>MD5 / SHA-1</strong> are kept for legacy checksums  — do not use them for security-sensitive operations.</li>
    <li>All algorithms except MD5 use the browser's native Web Crypto API. MD5 is implemented in pure JS since the spec does not include it.</li>
  </ul>
</ToolPage>

<style>
  textarea { width: 100%; box-sizing: border-box; font-size: .85rem; }
</style>

<script>
  import { md5Bytes } from '../../../../lib/md5.js';
  (function () {
  const $ = id => document.getElementById(id);

  $('mode').addEventListener('change', () => {
    const isHmac = $('mode').value === 'hmac';
    $('hmacKey').style.display = isHmac ? '' : 'none';
    $('keyLabel').style.display = isHmac ? '' : 'none';
    run();
  });

  /** RFC 2104 HMAC over arbitrary bytes. SubtleCrypto has no MD5-HMAC, so it is built here. */
  function hmacMD5(keyBytes, msgBytes) {
    const BLOCK = 64;
    let key = keyBytes;
    if (key.length > BLOCK) key = hexToBytes(md5Bytes(key));
    const oKeyPad = new Uint8Array(BLOCK);
    const iKeyPad = new Uint8Array(BLOCK);
    for (let i = 0; i < BLOCK; i++) {
      const k = key[i] || 0;
      oKeyPad[i] = k ^ 0x5c;
      iKeyPad[i] = k ^ 0x36;
    }
    const inner = concat(iKeyPad, msgBytes);
    const innerDigest = hexToBytes(md5Bytes(inner));
    return md5Bytes(concat(oKeyPad, innerDigest));
  }

  function concat(a, b) {
    const out = new Uint8Array(a.length + b.length);
    out.set(a);
    out.set(b, a.length);
    return out;
  }

  function hexToBytes(hex) {
    const out = new Uint8Array(hex.length / 2);
    for (let i = 0; i < out.length; i++) out[i] = parseInt(hex.substr(i * 2, 2), 16);
    return out;
  }

  function toHex(buf) {
    return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
  }

  /** Single entry point: every algorithm takes the same byte path, so a UTF-8 round trip
   never corrupts binary input. */
  async function digestBytes(algo, bytes, hmacKey) {
    if (hmacKey) {
      if (algo === 'MD5') return hmacMD5(hmacKey, bytes);
      const ck = await crypto.subtle.importKey('raw', hmacKey, { name: 'HMAC', hash: algo }, false, ['sign']);
      return toHex(await crypto.subtle.sign('HMAC', ck, bytes));
    }
    if (algo === 'MD5') return md5Bytes(bytes);
    return toHex(await crypto.subtle.digest(algo, bytes));
  }

  async function runHash() {
    const algo = $('algo').value;
    const isHmac = $('mode').value === 'hmac';
    const keyBytes = isHmac ? new TextEncoder().encode($('hmacKey').value) : null;
    const bytes = new TextEncoder().encode($('input').value);
    $('output').value = await digestBytes(algo, bytes, keyBytes);
  }

  $('run').addEventListener('click', runHash);
  $('input').addEventListener('input', () => $('mode').value === 'hash' ? runHash() : null);
  $('algo').addEventListener('change', runHash);
  $('copy').addEventListener('click', () => navigator.clipboard.writeText($('output').value));
  $('clear').addEventListener('click', () => { $('input').value = ''; $('output').value = ''; });
  $('fileBtn').addEventListener('click', () => $('fileInput').click());
  $('fileInput').addEventListener('change', async (e) => {
    const f = e.target.files[0];
    if (!f) return;
    const bytes = new Uint8Array(await f.arrayBuffer());
    // 用真实字节计算，同时把输入框换成占位说明（避免再次点击时对占位文本求哈希）
    const algo = $('algo').value;
    const isHmac = $('mode').value === 'hmac';
    const keyBytes = isHmac ? new TextEncoder().encode($('hmacKey').value) : null;
    $('output').value = await digestBytes(algo, bytes, keyBytes);
    $('input').value = `[${f.name} — ${bytes.byteLength} bytes loaded]`;
  });
})();
</script>
