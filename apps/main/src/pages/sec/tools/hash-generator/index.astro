---
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'Hash & HMAC Generator — MD5, SHA-1 to SHA-512';
const description = 'Generate MD5, SHA-1, SHA-256, SHA-384, SHA-512 hashes and HMAC signatures from text or files. Everything runs in your browser via the Web Crypto API.';
const faqs = [
  {
    "question": "How do I generate a hash from a string?",
    "answer": "Enter your text, select the algorithm (MD5, SHA-1, SHA-256, SHA-384, or SHA-512), and the hash is computed instantly in your browser. The result is shown as a hexadecimal string with an option to copy it."
  },
  {
    "question": "Is the hashing done locally?",
    "answer": "Yes. All hashing uses the Web Crypto API (SubtleCrypto.digest) entirely in your browser. Your input text never leaves your device and is not stored or logged anywhere."
  },
  {
    "question": "What is the difference between SHA-256 and SHA-512?",
    "answer": "SHA-256 produces a 256-bit (64-character hex) hash; SHA-512 produces a 512-bit (128-character hex) hash. SHA-512 is more collision-resistant but slightly slower. For most security uses SHA-256 is sufficient; use SHA-512 when maximum cryptographic strength is required."
  }
];
---

<BaseLayout
  site="sec"
  title={title}
  description={description}
  canonical="https://jsonversal.com/sec/tools/hash-generator/" current="/sec/tools/hash-generator/"
  keywords={['hash generator', 'md5 hash online', 'sha256 generator', 'sha512 hash', 'hmac generator', 'web crypto hash', 'checksum online']}
  faqs={faqs}
>
  <ToolNav currentHref={Astro.url.pathname} />

  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/sec/">Security</a><span class="sep">·</span><a href="/sec/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <div class="card mt-2">
    <div class="row" style="gap:8px;margin-bottom:12px;">
      <label class="text-muted">Algorithm</label>
      <select id="algo">
        <option value="MD5">MD5 (fast, non-secure)</option>
        <option value="SHA-1">SHA-1 (legacy, non-secure)</option>
        <option value="SHA-256" selected>SHA-256</option>
        <option value="SHA-384">SHA-384</option>
        <option value="SHA-512">SHA-512</option>
      </select>
      <label class="text-muted" style="margin-left:12px;">Mode</label>
      <select id="mode">
        <option value="hash" selected>Hash</option>
        <option value="hmac">HMAC</option>
      </select>
      <label class="text-muted" id="keyLabel" style="margin-left:12px;display:none;">HMAC Key</label>
      <input id="hmacKey" type="text" placeholder="secret-key" style="display:none;padding:6px 10px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface-2);" />
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div>
        <strong>Input</strong>
        <label for="input" class="sr-only">Input</label>
        <textarea id="input" spellcheck="false" placeholder='Type or paste text to hash…' style="min-height:180px;margin-top:8px;"></textarea>
      </div>
      <div>
        <strong>Output</strong>
        <label for="output" class="sr-only">Output</label>
        <textarea id="output" readonly placeholder='Hex hash appears here' style="min-height:180px;margin-top:8px;background:var(--surface-2);font-family:var(--font-mono);"></textarea>
      </div>
    </div>
    <div class="row mt-1" style="gap:8px;">
      <button class="primary" id="run">Generate</button>
      <button class="ghost" id="copy">Copy</button>
      <button class="ghost" id="clear">Clear</button>
      <button class="ghost" id="fileBtn" style="margin-left:auto;">Upload file to hash…</button>
      <input type="file" id="fileInput" style="display:none;" />
    </div>
  </div>

  <h2>How it works</h2>
  <ul>
    <li><strong>Hash</strong> — one-way function that maps any input size to a fixed-size fingerprint. The same input always produces the same output; tiny input changes produce completely different hashes (avalanche effect).</li>
    <li><strong>HMAC</strong> — Hash-based Message Authentication Code. Combines a secret key with the input so that only someone with the key can produce the correct MAC. Used for API signature verification (AWS, Stripe, GitHub webhooks).</li>
    <li><strong>MD5 / SHA-1</strong> are kept for legacy checksums — do not use them for security-sensitive operations.</li>
    <li>All algorithms except MD5 use the browser's native Web Crypto API. MD5 is implemented in pure JS since the spec does not include it.</li>
  </ul>
</BaseLayout>

<style>
  textarea { width: 100%; box-sizing: border-box; font-size: .85rem; }
</style>

<script is:inline client:load>
(function () {
  const $ = id => document.getElementById(id);
  let md5Module = null;

  $('mode').addEventListener('change', () => {
    const isHmac = $('mode').value === 'hmac';
    $('hmacKey').style.display = isHmac ? '' : 'none';
    $('keyLabel').style.display = isHmac ? '' : 'none';
    run();
  });

  // Minimal MD5 implementation (Web Crypto doesn't have it)
  function md5(str) {
    function leftRotate(l, i) { return (l << i) | (l >>> (32 - i)); }
    const s = [[7,12,17,22],[5,9,14,20],[4,11,16,23],[6,10,15,21]];
    const K = new Uint32Array([0xd76aa478,0xe8c7b756,0x242070db,0xc1bdceee,0xf57c0faf,0x4787c62a,0xa8304613,0xfd469501,0x698098d8,0x8b44f7af,0xffff5bb1,0x895cd7be,0x6b901122,0xfd987193,0xa679438e,0x49b40821,0xf61e2562,0xc040b340,0x265e5a51,0xe9b6c7aa,0xd62f105d,0x02441453,0xd8a1e681,0xe7d3fbc8,0x21e1cde6,0xc33707d6,0xf4d50d87,0x455a14ed,0xa9e3e905,0xfcefa3f8,0x676f02d9,0x8d2a4c8a,0xfffa3942,0x8771f681,0x6d9d6122,0xfde5380c,0xa4beea44,0x4bdecfa9,0xf6bb4b60,0xbebfbc70,0x289b7ec6,0xeaa127fa,0xd4ef3085,0x04881d05,0xd9d4d039,0xe6db99e5,0x1fa27cf8,0xc4ac5665,0xf4292244,0x432aff97,0xab9423a7,0xfc93a039,0x655b59c3,0x8f0ccc92,0xffeff47d,0x85845dd1,0x6fa87e4f,0xfe2ce6e0,0xa3014314,0x4e0811a1,0xf7537e82,0xbd3af235,0x2ad7d2bb,0xeb86d391]);
    const bytes = new TextEncoder().encode(str);
    const msgLen = bytes.length;
    const padded = new Uint8Array(msgLen + 65);
    padded.set(bytes); padded[msgLen] = 0x80;
    const bits = BigInt(msgLen) * 8n;
    const view = new DataView(padded.buffer, msgLen + 1 & ~7);
    view.setBigUint64(0, bits, true);
    let a = 0x67452301, b = 0xefcdab89, c = 0x98badcfe, d = 0x10325476;
    for (let off = 0; off < padded.length; off += 64) {
      const M = new Uint32Array(padded.buffer, off, 16);
      let A = a, B = b, C = c, D = d;
      for (let i = 0; i < 64; i++) {
        let F, g;
        if (i < 16) { F = (B & C) | (~B & D); g = i; }
        else if (i < 32) { F = (D & B) | (~D & C); g = (5*i + 1) % 16; }
        else if (i < 48) { F = B ^ C ^ D; g = (3*i + 5) % 16; }
        else { F = C ^ (B | ~D); g = (7*i) % 16; }
        const temp = D;
        D = C; C = B;
        B = B + leftRotate((A + F + K[i] + M[g]) >>> 0, s[i>>4][i%4]);
        A = temp;
      }
      a = (a + A) >>> 0; b = (b + B) >>> 0; c = (c + C) >>> 0; d = (d + D) >>> 0;
    }
    const hex = (n) => n.toString(16).padStart(8, '0');
    return hex(a) + hex(b) + hex(c) + hex(d);
  }

  async function runHash() {
    const input = $('input').value;
    const algo = $('algo').value;
    const isHmac = $('mode').value === 'hmac';
    const data = new TextEncoder().encode(input);

    let hex;
    if (algo === 'MD5' && !isHmac) {
      hex = md5(input);
    } else if (algo === 'MD5' && isHmac) {
      // HMAC-MD5
      const keyStr = $('hmacKey').value;
      const keyBytes = new TextEncoder().encode(keyStr);
      const blockSize = 64;
      let key = keyBytes;
      if (key.length > blockSize) { key = new TextEncoder().encode(md5(keyStr)); }
      const oKeyPad = new Uint8Array(blockSize), iKeyPad = new Uint8Array(blockSize);
      for (let i = 0; i < blockSize; i++) { oKeyPad[i] = (key[i] || 0) ^ 0x5c; iKeyPad[i] = (key[i] || 0) ^ 0x36; }
      const inner = md5(new TextDecoder().encode(iKeyPad) + input);
      hex = md5(new TextDecoder().encode(oKeyPad) + inner);
    } else if (isHmac) {
      const keyStr = $('hmacKey').value;
      const cryptoKey = await crypto.subtle.importKey('raw', new TextEncoder().encode(keyStr), { name: 'HMAC', hash: algo }, false, ['sign']);
      const sig = await crypto.subtle.sign('HMAC', cryptoKey, data);
      hex = Array.from(new Uint8Array(sig)).map(b => b.toString(16).padStart(2,'0')).join('');
    } else {
      const buf = await crypto.subtle.digest(algo, data);
      hex = Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
    }
    $('output').value = hex;
  }

  $('run').addEventListener('click', runHash);
  $('input').addEventListener('input', () => $('mode').value === 'hash' ? runHash() : null);
  $('algo').addEventListener('change', runHash);
  $('copy').addEventListener('click', () => navigator.clipboard.writeText($('output').value));
  $('clear').addEventListener('click', () => { $('input').value = ''; $('output').value = ''; });
  $('fileBtn').addEventListener('click', () => $('fileInput').click());
  $('fileInput').addEventListener('change', async (e) => {
    const f = e.target.files[0];
    if (!f) return;
    const buf = await f.arrayBuffer();
    $('input').value = `[${f.name} (${buf.byteLength} bytes)]`;
    const algo = $('algo').value;
    let hex;
    if (algo === 'MD5') hex = md5(new TextDecoder().decode(new Uint8Array(buf)));
    else { const h = await crypto.subtle.digest(algo, buf); hex = Array.from(new Uint8Array(h)).map(b => b.toString(16).padStart(2,'0')).join(''); }
    $('output').value = hex;
  });
})();
</script>
