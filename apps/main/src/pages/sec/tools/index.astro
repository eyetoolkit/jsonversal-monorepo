---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolGrid from '@versal/ui/ToolGrid.astro';

const tools = [
  { title: 'Hash Generator', description: 'MD5, SHA-1, SHA-256, SHA-384, SHA-512 — local, nothing uploaded.', href: '/sec/tools/hash/' },
  {
    title: 'Hash Generator',
    description: 'Generate MD5, SHA-1, SHA-256, SHA-384, SHA-512 hashes and HMAC signatures. All client-side, Web Crypto API.',
    href: '/sec/tools/hash-generator/',
  },
  { title: 'AES Encryption / Decryption', description: 'AES-GCM or AES-CBC with PBKDF2 key derivation from a passphrase.', href: '/sec/tools/aes/' },
  { title: 'BCrypt Hash & Verify', description: 'Hash passwords with adaptive BCrypt cost and verify hashes.', href: '/sec/tools/bcrypt/' },
  { title: 'HMAC Calculator', description: 'HMAC-SHA256/384/512 message authentication codes.', href: '/sec/tools/hmac/' },
  { title: 'Random Password Generator', description: 'CSPRNG-based strong passwords with entropy display.', href: '/sec/tools/password-generator/' },
  { title: 'File Checksum Calculator', description: 'SHA-256 / SHA-1 checksums of local files, computed in-browser.', href: '/sec/tools/file-checksum/' },
  { title: 'Password Strength Analyzer', description: 'Score + entropy + crack-time estimate + actionable hints.', href: '/sec/tools/password-strength/' },
  { title: 'Content-Security-Policy Generator', description: 'Build a strict CSP header with resource directives and flags.', href: '/sec/tools/csp/' },
  { title: 'CSR Decoder', description: 'Decode a PEM Certificate Signing Request and show CN + SANs.', href: '/sec/tools/csr/' },
  { title: 'TOTP Authenticator', description: 'Generate 6-digit TOTP codes from a Base32 secret (RFC 6238).', href: '/sec/tools/totp/' },
  { title: 'Random Token Generator', description: 'CSPRNG hex / base64 / base64url / UUID tokens for API keys.', href: '/sec/tools/random-token/' },
  { title: 'RSA Key Pair Generator', description: 'Generate RSA-OAEP key pairs in PEM and encrypt/decrypt text.', href: '/sec/tools/rsa-keygen/' },
  { title: 'JWT Generator & Signer', description: 'Build and sign JWTs with HS256 / HS384 / HS512 locally.', href: '/sec/tools/jwt-generator/' },
  { title: 'X.509 Certificate Decoder', description: 'Decode PEM certificates: subject, issuer, validity, SANs, key usage.', href: '/sec/tools/x509-decoder/' },
  { title: 'Hash Identifier', description: 'Identify hash formats: MD5/SHA families, bcrypt, crypt, JWT, UUID, AWS keys.', href: '/sec/tools/hash-identifier/' },
  { title: 'Passphrase Generator', description: 'Diceware-style memorable passphrases with entropy estimates.', href: '/sec/tools/passphrase-generator/' },
  { title: 'Password-Based Encryption', description: 'PBKDF2 + AES-GCM encrypt/decrypt of text with a password.', href: '/sec/tools/password-encrypt/' },
  { title: 'Secret & API Key Scanner', description: 'Detect and redact leaked credentials in logs, configs and env dumps.', href: '/sec/tools/secret-scanner/' },
];
---

<BaseLayout site="sec" title="All Security Tools" current="/sec/tools/">
  <div class="tool-head">
    <h1>Security Tools</h1>
    <p class="desc">Everything runs locally. Never paste production keys into shared chats. Use the filter to zero in on a tool.</p>
  </div>

  <ToolGrid tools={tools} />
</BaseLayout>