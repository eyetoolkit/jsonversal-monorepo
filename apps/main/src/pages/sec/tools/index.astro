---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolGrid from '@versal/ui/ToolGrid.astro';

const tools = [
  { title: 'AES Encryption / Decryption', description: 'Encrypt and decrypt text with AES-GCM or AES-CBC using your own key. All cryptographic operations run locally in your browser.', href: '/sec/tools/aes/' },
  { title: 'BCrypt Hash & Verify', description: 'Generate bcrypt password hashes with a configurable cost factor, and verify a plaintext password against a bcrypt hash. Everything runs in your browser.', href: '/sec/tools/bcrypt/' },
  { title: 'File Checksum Calculator', description: 'Compute the SHA-256, SHA-1, SHA-384, or SHA-512 checksum of any local file, with its size. Your file is processed locally and never uploaded.', href: '/sec/tools/file-checksum/' },
  { title: 'Hash & HMAC Generator — MD5, SHA-1 to SHA-512', description: 'Generate MD5, SHA-1, SHA-256, SHA-384, SHA-512 hashes and HMAC signatures from text or files. Everything runs in your browser via the Web Crypto API.', href: '/sec/tools/hash-generator/' },
  { title: 'Hash Generator — MD5, SHA-1, SHA-256 Online', description: 'Compute MD5, SHA-1, SHA-256, SHA-384, SHA-512 of any text or file. All hashing happens in your browser.', href: '/sec/tools/hash/' },
  { title: 'HMAC Generator — Sign Messages with SHA-256', description: 'Compute HMAC-SHA256, HMAC-SHA384, or HMAC-SHA512 signatures for any message and secret key, in hex and base64. Runs locally with Web Crypto.', href: '/sec/tools/hmac/' },
  { title: 'JWT Decoder — Decode and Verify Tokens', description: 'Decode JWT tokens instantly. View header, payload, and signature. Check expiration and verify signatures. 100% browser-based, nothing sent to servers.', href: '/sec/tools/jwt-decoder/' },
  { title: 'JWT Generator & Signer', description: 'Build and sign JWTs with HS256, HS384, or HS512 in your browser. Edit header and payload, supply a secret, and get a ready-to-use token. Nothing is uploaded.', href: '/sec/tools/jwt-generator/' },
  { title: 'Passphrase Generator (Diceware-style)', description: 'Generate memorable passphrases from a 256-word diceware-style list, with separators, digits, symbols and live entropy estimates. All randomness is local.', href: '/sec/tools/passphrase-generator/' },
  { title: 'Random Password Generator', description: 'Generate strong random passwords with custom length and character sets, plus a live entropy estimate. Everything is generated locally — never transmitted.', href: '/sec/tools/password-generator/' },
  { title: 'Random Token Generator', description: 'Generate cryptographically secure random tokens in hex, base64, base64url, or UUID format, using the browser\\\'s CSPRNG.', href: '/sec/tools/random-token/' },
  { title: 'RSA Key Pair Generator', description: 'Generate RSA key pairs (2048/3072/4096-bit) in your browser with Web Crypto, view PEM output, and encrypt/decrypt text. Private keys never leave your device.', href: '/sec/tools/rsa-keygen/' },
  { title: 'Secret & API Key Scanner', description: 'Paste logs or config files to detect leaked credentials — AWS keys, GitHub and GitLab tokens, Stripe, Slack, OpenAI, JWTs and private keys. Scans locally.', href: '/sec/tools/secret-scanner/' },
  { title: 'X.509 Certificate Decoder', description: 'Decode PEM X.509 certificates in your browser — subject, issuer, validity, public key, SANs and extensions. A compact DER/ASN.1 parser, nothing uploaded.', href: '/sec/tools/x509-decoder/' },
];
---

<BaseLayout site="sec" title="All Security Tools" current="/sec/tools/" canonical="https://jsonversal.com/sec/tools/">
  <div class="tool-head">
    <h1>Security Tools</h1>
    <p class="desc">Everything runs locally. Never paste production keys into shared chats. Use the filter to zero in on a tool.</p>
  </div>

  <ToolGrid tools={tools} />
</BaseLayout>