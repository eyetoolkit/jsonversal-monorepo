---
import BaseLayout from '@versal/ui/BaseLayout';
const title = 'Hash Identifier';
const description = 'Identify the algorithm behind a hash by its format — MD5, SHA family, bcrypt, crypt formats, JWTs, UUIDs, AWS keys and more — plus a hex ↔ base64 converter. All detection is local.';
---
<BaseLayout site="sec" title={title} description={description}
  canonical="https://jsonversal.com/sec/hash-identifier/"
  keywords={['hash identifier', 'identify hash type', 'hash detector', 'hash算法识别', 'recognize hash', 'hash-identifier', 'hash-identifier']}
  current="/sec/hash-identifier/"
>
  <nav aria-label="Breadcrumb" class="crumbs"><a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span></nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-1">
    <h2 class="h2-card">Identify hashes</h2>
    <label for="hashes" class="sr-only">Identify hashes</label>
    <textarea id="hashes" placeholder="Paste one hash per line, then click Identify…"></textarea>
    <div class="row mt-1">
      <button class="primary" id="identify">Identify</button>
      <button class="ghost" id="clear">Clear results</button>
    </div>
  </section>

  <section class="card mt-2" id="table-section" style="display:none;">
    <h2 class="h2-card">Results</h2>
    <table>
      <thead>
        <tr><th>Hash</th><th>Length</th><th>Charset</th><th>Likely algorithm(s)</th><th>Confidence</th></tr>
      </thead>
      <tbody id="results"></tbody>
    </table>
  </section>

  <section class="card mt-2">
    <h2 class="h2-card">Hex ↔ Base64 converter</h2>
    <div class="row">
      <div style="flex:1;min-width:200px;">
        <label class="text-muted" for="conv-hex">Hex</label>
        <input id="conv-hex" type="text" placeholder="e.g. 5d41402abc4b2a76b9719d911017c592" spellcheck="false" />
      </div>
      <div style="flex:1;min-width:200px;">
        <label class="text-muted" for="conv-b64">Base64</label>
        <input id="conv-b64" type="text" placeholder="e.g. XUFAKrxLKnbZcZ2REBfFkg==" spellcheck="false" />
      </div>
    </div>
    <div class="text-dim" id="conv-err" style="font-size:.85rem;margin-top:6px;"></div>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <strong>Error</strong>
    <pre id="err-out" style="color:var(--danger);"></pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Hash algorithms are identified by <em>shape</em>: the character set (hex, base64, or crypt-style) and the digest length. A 32-character hex string is 128 bits — the signature of MD5 and its relatives; 64 hex characters is 256 bits, typical of SHA-256.</li>
    <li>Prefixes pin things down further: <code>$2a$</code> / <code>$2b$</code> / <code>$2y$</code> is bcrypt, <code>$1$</code> is MD5 crypt, <code>$5$</code> / <code>$6$</code> are SHA-256 / SHA-512 crypt, <code>eyJ…</code> is a JWT, <code>AKIA…</code> is an AWS access key.</li>
    <li>Many digests share a length, so the tool reports <em>ambiguity</em> honestly: 32 hex chars could be MD5, NTLM, LM, or MD4 — you cannot tell from the format alone.</li>
    <li>The converter treats hex and base64 as byte encodings of the same underlying value, so you can switch between them losslessly.</li>
  </ul>

  <h2>About Hash Identifier</h2>
  <p class="text-muted">When you inherit a database dump, a config file, or a legacy auth table, the first question is usually "what hashed this?" The answer is almost always recoverable from the format: standardized prefixes and canonical digest lengths make modern schemes self-describing. This tool answers that question instantly and, just as importantly, tells you when the answer is <em>ambiguous</em> — because a length match is a necessary but not sufficient clue.</p>
  <p class="text-muted">Identification is a starting point, not a verdict. If you only have a ciphertext digest (for example a 64-char hex string) there is no way to know whether it was produced by SHA-256, SHA3-256, or BLAKE2s without the original input; and a "MD5" label says nothing about whether the value is unsalted, salted, or doubled. Use the result to guide your next step — checking salting, iteration counts, or password-recovery tooling — rather than to conclude anything definitive.</p>
</BaseLayout>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .row > div { display: flex; flex-direction: column; gap: 4px; }
  textarea { min-height: 130px; }
  .mt-2 { margin-top: 16px; }
  .mt-1 { margin-top: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: .85rem; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; color: var(--text-muted); }
  td code { font-family: var(--font-mono); font-size: .8rem; word-break: break-all; }
  .ok { color: #3fb950; }
  .warn { color: #d29922; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function base64PadCount(t) {
    const m = t.match(/=+$/);
    return m ? m[0].length : 0;
  }
  function base64Bits(t) {
    const pad = base64PadCount(t);
    return Math.round((t.length - pad) * 6 / 8) * 8;
  }

  // Returns null when no match, otherwise a result object.
  function detect(raw) {
    const t = raw.trim();
    if (!t) return null;
    const res = { len: t.length, bits: null, charset: 'text', algs: [], confidence: 'no match', note: [] };

    // Crypt / modular formats first — they start with $ or specific letters.
    if (/^\$2[abxy]\$/.test(t)) {
      res.algs = ['bcrypt ($2a$ / $2b$ / $2y$)'];
      res.charset = 'crypt (modular)';
      res.confidence = 'unique match';
      return res;
    }
    if (/^\$1\$/.test(t)) {
      res.algs = ['MD5 crypt (Unix $1$)'];
      res.charset = 'crypt (modular)';
      res.confidence = 'unique match';
      return res;
    }
    if (/^\$5\$/.test(t)) {
      res.algs = ['SHA-256 crypt (Unix $5$)'];
      res.charset = 'crypt (modular)';
      res.confidence = 'unique match';
      return res;
    }
    if (/^\$6\$/.test(t)) {
      res.algs = ['SHA-512 crypt (Unix $6$)'];
      res.charset = 'crypt (modular)';
      res.confidence = 'unique match';
      return res;
    }
    if (/^(\$H\$|\$P\$)/.test(t)) {
      res.algs = ['phpBB (MD5-based, $H$ / $P$)'];
      res.charset = 'crypt (modular)';
      res.confidence = 'unique match';
      return res;
    }

    // JWT: three base64url segments.
    if (/^eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}$/.test(t)) {
      res.algs = ['JWT (header.payload.signature)'];
      res.charset = 'base64url';
      res.confidence = 'unique match (format)';
      return res;
    }

    // UUID.
    if (/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/.test(t)) {
      res.algs = ['UUID (version depends on the 13th hex digit)'];
      res.bits = 128;
      res.charset = 'hex + hyphens';
      res.confidence = 'unique match (format)';
      return res;
    }

    // AWS access key ID.
    if (/^AKIA[0-9A-Z]{16}$/.test(t)) {
      res.algs = ['AWS Access Key ID'];
      res.charset = 'mixed (20 chars)';
      res.confidence = 'unique match (format)';
      return res;
    }

    // Hexadecimal digests.
    if (/^[0-9a-fA-F]+$/.test(t) && t.length % 2 === 0) {
      res.charset = 'hex';
      res.bits = t.length * 4;
      const map = {
        32: { algs: ['MD5', 'NTLM', 'LM', 'MD4'], conf: 'ambiguous — also matches NTLM, LM, MD4' },
        40: { algs: ['SHA-1', 'SHA-0', 'RIPEMD-160'], conf: 'ambiguous — also matches SHA-0, RIPEMD-160' },
        56: { algs: ['SHA-224', 'SHA3-224'], conf: 'ambiguous — also matches SHA3-224' },
        64: { algs: ['SHA-256', 'SHA3-256', 'BLAKE2s'], conf: 'ambiguous — also matches SHA3-256, BLAKE2s' },
        96: { algs: ['SHA-384', 'SHA3-384'], conf: 'ambiguous — also matches SHA3-384' },
        128: { algs: ['SHA-512', 'SHA3-512', 'BLAKE2b'], conf: 'ambiguous — also matches SHA3-512, BLAKE2b' }
      };
      if (map[t.length]) {
        res.algs = map[t.length].algs.slice();
        res.confidence = map[t.length].conf;
        if (t.length === 32) res.note.push('possible generic 128-bit hash');
      } else {
        res.algs = ['unknown hex digest'];
        res.confidence = 'no standard length match';
      }
      return res;
    }

    // Base64 candidates (must be plausible: alphabet + optional padding).
    if (/^[A-Za-z0-9+/]+={0,2}$/.test(t) && t.length >= 16) {
      res.charset = 'base64';
      res.bits = base64Bits(t);
      const pad = base64PadCount(t);
      if ((t.length === 43 && pad === 0) || (t.length === 44 && pad === 1)) {
        res.algs = ['SHA-256 (base64) — possible'];
        res.confidence = 'possible — format only';
      } else if (t.length === 32) {
        res.algs = ['generic hash (base64) — possible'];
        res.confidence = 'weak — format only';
        res.note.push('possible generic 128-bit hash');
      } else {
        res.algs = ['base64-encoded data — likely a hash or random token'];
        res.confidence = 'weak — format only';
      }
      return res;
    }

    res.algs = ['unknown / not a standard hash format'];
    res.confidence = 'no match';
    return res;
  }

  function lengthLabel(r) {
    if (r.bits) return r.bits + ' bits' + (r.charset === 'hex' ? ' (' + r.len + ' hex chars)' : ' (' + r.len + ' chars)');
    return r.len + ' chars';
  }

  function truncate(s) {
    if (s.length <= 26) return s;
    return s.slice(0, 12) + '…' + s.slice(-10);
  }

  function run() {
    const text = $('hashes').value;
    if (!text.trim()) { showErr('Paste at least one hash first.'); return; }
    hideErr();
    const lines = text.split('\n').map(l => l.trim()).filter(Boolean);
    const rows = [];
    for (const line of lines) {
      const r = detect(line);
      if (!r) continue;
      const note = r.note.length ? ' · ' + r.note.join('; ') : '';
      const confClass = r.confidence.indexOf('unique') === 0 ? 'ok' : 'warn';
      rows.push(
        '<tr>' +
        '<td><code title="' + esc(line) + '">' + esc(truncate(line)) + '</code></td>' +
        '<td>' + esc(lengthLabel(r)) + '</td>' +
        '<td>' + esc(r.charset) + '</td>' +
        '<td>' + esc(r.algs.join(', ')) + '</td>' +
        '<td class="' + confClass + '">' + esc(r.confidence) + note + '</td>' +
        '</tr>'
      );
    }
    if (!rows.length) {
      $('results').innerHTML = '<tr><td colspan="5" class="text-dim">Nothing to identify.</td></tr>';
    } else {
      $('results').innerHTML = rows.join('');
    }
    $('table-section').style.display = 'block';
  }

  function showErr(msg) {
    $('err-out').textContent = msg;
    $('err-section').style.display = 'block';
  }
  function hideErr() {
    $('err-section').style.display = 'none';
  }

  $('identify').addEventListener('click', run);
  $('clear').addEventListener('click', () => {
    $('results').innerHTML = '';
    $('table-section').style.display = 'none';
  });

  // ---- Hex ↔ base64 converter ----
  function bufToB64(buf) {
    let bin = '';
    const bytes = new Uint8Array(buf);
    for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  }
  function b64ToBuf(b64) {
    const bin = atob(b64.replace(/\s+/g, ''));
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes.buffer;
  }
  function hexToBytes(hex) {
    const bytes = new Uint8Array(hex.length / 2);
    for (let i = 0; i < bytes.length; i++) bytes[i] = parseInt(hex.substr(i * 2, 2), 16);
    return bytes;
  }
  function bytesToHex(bytes) {
    let s = '';
    for (let i = 0; i < bytes.length; i++) s += bytes[i].toString(16).padStart(2, '0');
    return s;
  }

  function setConvErr(msg) {
    $('conv-err').textContent = msg;
  }

  $('conv-hex').addEventListener('input', () => {
    const v = $('conv-hex').value.trim();
    if (!v) { $('conv-b64').value = ''; setConvErr(''); return; }
    if (!/^[0-9a-fA-F]+$/.test(v) || v.length % 2 !== 0) {
      $('conv-b64').value = '';
      setConvErr('Hex must contain only 0-9 / a-f and have an even number of characters.');
      return;
    }
    setConvErr('');
    $('conv-b64').value = bufToB64(hexToBytes(v));
  });

  $('conv-b64').addEventListener('input', () => {
    let v = $('conv-b64').value.replace(/\s+/g, '');
    if (!v) { $('conv-hex').value = ''; setConvErr(''); return; }
    while (v.length % 4 !== 0) v += '=';
    if (!/^[A-Za-z0-9+/]*={0,2}$/.test(v)) {
      $('conv-hex').value = '';
      setConvErr('Base64 contains invalid characters.');
      return;
    }
    try {
      setConvErr('');
      $('conv-hex').value = bytesToHex(new Uint8Array(b64ToBuf(v)));
    } catch {
      $('conv-hex').value = '';
      setConvErr('Could not decode base64 — check the input.');
    }
  });
})();
</script>
