---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = 'JWT Decoder  — Decode and Verify Tokens';
const description = 'Decode JWT tokens instantly. View header, payload, and signature. Check expiration and verify signatures. 100% browser-based, nothing sent to servers.';
const faqs = [
  {
    question: 'How do I decode a JWT token?',
    answer: 'Paste your JWT into the input and the decoder immediately shows the header and payload in plain JSON. It also checks the expiry (exp) claim and shows whether the token is still valid or has expired.',
  },
  {
    question: 'Can I verify a JWT signature?',
    answer: 'The decoder shows the signature section after decoding, but requires a secret or public key for verification. For HMAC verification, use the JWT Generator tool which shares the same secret between encode and decode.',
  },
];
---

<ToolPage
  site="sec"
  title={title}
  description={description}
  canonical="https://jsonversal.com/sec/tools/jwt-decoder/"
  keywords={['JWT decoder', 'JWT decoder online', 'decode JWT', 'JWT verifier', 'JWT debugger', 'JWT parser', 'JWT token decode']}
  current="/sec/tools/jwt-decoder/"
  faqs={faqs}
    about={[
        [
          "What a JWT actually contains",
          [
            "A JWT is three base64url segments separated by dots: a header naming the algorithm, a payload carrying the claims, and a signature over the first two. Decoding is not verifying. Anyone can decode a token and read its contents; what requires a secret is confirming the signature was not altered.",
            "Because the payload is only base64url-encoded and not encrypted, treat everything inside as visible to anyone holding the token. Putting a password or a private key in a claim is a common and serious mistake."
          ]
        ],
        [
          "Signature verification",
          [
            "For HS256, HS384 and HS512 the signature is an HMAC over the header and payload using a shared secret, computed with the Web Crypto API in this browser. If verification fails with a valid-looking token, the usual causes are a mismatched secret, a token that has expired, or a signing library that produced a non-standard HMAC.",
            "RS256 and ES256 cannot be verified with a shared secret — they need the issuer's public key. The signing tool on this site produces HS-family tokens, which is the right choice for internal services but not for tokens a third party must verify."
          ]
        ],
        [
          "Claims worth checking",
          [
            "`exp` and `nbf` are timestamps in seconds since the epoch; an expired token is rejected even with a valid signature. `aud` should match the service receiving the token — a token minted for another service is still validly signed, just not for you. `iss` identifies the issuer and is how you decide which key to verify with."
          ]
        ]
      ]}
  >
  <section class="card mt-2">
    <h2 class="h2-card">JWT Token</h2>
    <label for="jwt-input" class="sr-only">JWT Token</label>
    <textarea id="jwt-input" spellcheck="false" placeholder="Paste your JWT token here (eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)"></textarea>
    <div class="row mt-2">
      <button class="primary" id="decode-btn">Decode</button>
      <button class="ghost" id="clear-btn">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="header-section" style="display:none;">
    <div class="row" style="margin-bottom:10px;">
      <h2 class="h2-flat">Header</h2>
      <span class="badge" id="alg-badge"></span>
    </div>
    <pre id="header-out" class="output-text" style="min-height:40px; max-height:480px;"></pre>
  </section>

  <section class="card mt-2" id="payload-section" style="display:none;">
    <div class="row" style="margin-bottom:10px;">
      <h2 class="h2-flat">Payload</h2>
      <span class="badge" id="exp-badge"></span>
    </div>
    <pre id="payload-out" class="output-text" style="min-height:40px; max-height:480px;"></pre>
    <div class="text-dim mt-2" id="claims-summary" style="font-size:.85rem;"></div>
  </section>

  <section class="card mt-2" id="sig-section" style="display:none;">
    <h2 class="h2-flat">Signature</h2>
    <pre id="sig-out" class="output-text" style="min-height:40px; max-height:480px; word-break:break-all; font-size:.8rem; color:var(--muted);"></pre>
    <p class="text-dim mt-1" id="sig-note" style="font-size:.8rem;"></p>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <h2 class="h2-error">Error</h2>
    <pre id="err-out" class="output-text" style="min-height:40px; color:var(--danger);"></pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>A JWT has three Base64URL-encoded parts separated by dots (<code>header.payload.signature</code>).</li>
    <li>The header and payload are decoded and parsed as JSON  — they are <strong>not encrypted</strong>, anyone can read them.</li>
    <li>The signature proves the token was issued by whoever holds the secret key. Without a key you can decode but not verify.</li>
    <li>All decoding runs locally in your browser  — your JWT is never sent to any server.</li>
  </ul>

  <h2>About JWT Decoder</h2>
  <p class="text-muted">JWT (JSON Web Token) is a compact standard (RFC 7519) for transmitting claims between parties as a signed, URL-safe token. A JWT consists of three parts: the header declares the algorithm, the payload holds the claims (user ID, roles, expiration, etc.), and the signature binds and verifies them. Because the header and payload are merely Base64-encoded (not encrypted), never put sensitive data like passwords inside a JWT  — treat it like a wearing a transparent ID badge that anyone can read.</p>
  <p class="text-muted">Use this decoder to inspect tokens from Auth0, Firebase, Supabase, or your own service during development and debugging. For production verification with HMAC (HS*) secrets or RSA (RS*) keys, you need the corresponding secret or public key  — use it alongside the JWT Generator on this site to create and verify a matching pair.</p>
</ToolPage>

<style>
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    font-size: .75rem;
    font-weight: 600;
    background: rgba(59,130,246,.15);
    color: var(--accent);
    border: 1px solid currentColor;
  }
  .badge.ok { background: rgba(34,197,94,.15); color: var(--success); border-color: var(--success); }
  .badge.expired { background: rgba(239,68,68,.15); color: var(--danger); border-color: var(--danger); }
  textarea { min-height: 100px; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  function b64urlDecode(str) {
    str = str.replace(/-/g, '+').replace(/_/g, '/');
    while (str.length % 4) str += '=';
    return decodeURIComponent(escape(atob(str)));
  }

  function formatJSON(str) {
    try { return JSON.stringify(JSON.parse(str), null, 2); }
    catch { return str; }
  }

  function fmtTimestamp(ts) {
    if (!ts) return null;
    const d = new Date(ts * 1000);
    return d.toLocaleString() + ' (' + ts + ')';
  }

  function hideAll() {
    ['header-section','payload-section','sig-section','err-section'].forEach(id => {
      $(id).style.display = 'none';
    });
  }

  $('decode-btn').addEventListener('click', () => {
    hideAll();
    const raw = $('jwt-input').value.trim();
    if (!raw) { showToast('Paste a JWT token first.'); return; }

    const parts = raw.split('.');
    if (parts.length !== 3) {
      $('err-out').textContent = 'Invalid JWT format. Expected 3 dot-separated parts (header.payload.signature).';
      $('err-section').style.display = 'block';
      return;
    }

    const [headerB64, payloadB64, sigB64] = parts;

    try {
      const headerRaw = b64urlDecode(headerB64);
      const headerObj = JSON.parse(headerRaw);
      $('header-out').textContent = formatJSON(headerRaw);
      $('alg-badge').textContent = headerObj.alg || 'unknown';
      $('header-section').style.display = 'block';

      const payloadRaw = b64urlDecode(payloadB64);
      const payloadObj = JSON.parse(payloadRaw);
      $('payload-out').textContent = formatJSON(payloadRaw);

      const expTs = payloadObj.exp;
      if (expTs) {
        const now = Math.floor(Date.now() / 1000);
        const badge = $('exp-badge');
        if (expTs < now) {
          badge.textContent = 'EXPIRED';
          badge.className = 'badge expired';
        } else {
          const left = expTs - now;
          const hours = Math.floor(left / 3600);
          const mins = Math.floor((left % 3600) / 60);
          badge.textContent = `Expires in ${hours}h ${mins}m`;
          badge.className = 'badge ok';
        }
        $('exp-badge').parentElement.style.display = 'flex';
      } else {
        $('exp-badge').parentElement.style.display = 'none';
      }

      const stdKeys = ['iss','sub','aud','exp','nbf','iat','jti'];
      const custom = Object.keys(payloadObj).filter(k => !stdKeys.includes(k));
      const parts2 = [];
      if (payloadObj.sub) parts2.push(`sub: ${payloadObj.sub}`);
      if (payloadObj.iss) parts2.push(`iss: ${payloadObj.iss}`);
      if (payloadObj.iat) parts2.push(`iat: ${fmtTimestamp(payloadObj.iat)}`);
      if (payloadObj.exp) parts2.push(`exp: ${fmtTimestamp(payloadObj.exp)}`);
      if (custom.length) parts2.push(`+${custom.length} custom claim(s): ${custom.join(', ')}`);
      $('claims-summary').textContent = parts2.join(' · ');
      $('payload-section').style.display = 'block';

      $('sig-out').textContent = sigB64;
      const alg = headerObj.alg || '';
      const isHMAC = /^HS(256|384|512)$/.test(alg);
      $('sig-note').textContent = isHMAC
        ? 'HMAC algorithm detected. Provide the secret key below to verify this signature.'
        : `"${alg}" algorithm detected. Verification requires the public key or certificate.`;
      $('sig-section').style.display = 'block';

    } catch (e) {
      $('err-out').textContent = 'Failed to decode: ' + e.message;
      $('err-section').style.display = 'block';
    }
  });

  $('clear-btn').addEventListener('click', () => {
    $('jwt-input').value = '';
    hideAll();
  });
})();
</script>