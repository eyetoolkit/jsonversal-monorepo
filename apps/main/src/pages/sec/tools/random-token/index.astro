---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "Random Token Generator";
const description = "Generate cryptographically secure random tokens in hex, base64, base64url, or UUID format, using the browser\\";
const faqs = [
  {
    "question": "How do I generate a random token?",
    "answer": "Choose the token length (8\u2013128 characters) and character set (alphanumeric, hex, URL-safe, or custom). Click Generate and a cryptographically random token is produced using crypto.getRandomValues()."
  },
  {
    "question": "What is the difference between token types?",
    "answer": "Alphanumeric uses a-z, A-Z, 0-9. Hex uses 0-9, a-f. URL-safe replaces + and / with - and _. Custom lets you define exactly which characters to use."
  }
];
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';
---

<ToolPage
  site="sec"
  title={title}
  description={description}
  canonical="https://jsonversal.com/sec/tools/random-token/"
  current="/sec/tools/random-token/"
  faqs={faqs}
>

  <section class="card mt-1">
    <h2 class="h2-card">Options</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;">
      <div>
        <label class="text-muted" for="enc">Encoding</label>
        <label for="enc" class="sr-only">Options</label> <select id="enc">
          <option value="hex">Hex (lowercase)</option>
          <option value="hex-upper">Hex (uppercase)</option>
          <option value="base64">Base64</option>
          <option value="base64url">Base64 (URL-safe)</option>
          <option value="uuid">UUID format</option>
        </select>
      </div>
      <div>
        <label class="text-muted" for="len">Length (bytes, 4–128)</label>
        <label for="len" class="sr-only">Len</label> <input id="len" type="number" min="4" max="128" value="16" />
        <div class="text-dim" id="len-note" style="display:none;font-size:.85rem;margin-top:4px;">UUID format always uses 16 bytes.</div>
      </div>
      <div>
        <label class="text-muted" for="count">Count (1–10)</label>
        <label for="count" class="sr-only">Count</label> <input id="count" type="number" min="1" max="10" value="1" />
      </div>
    </div>
    <div class="row mt-2">
      <button class="primary" id="gen">Generate</button>
    </div>
  </section>

  <section class="card mt-2">
    <strong>Tokens</strong>
    <div id="out" class="mt-2" style="display:none;"></div>
    <button class="ghost mt-2" id="copy-all" style="display:none;">Copy all</button>
  </section>

  <section class="card mt-2">
    <strong>Error</strong>
    <div id="err" class="mt-2" style="display:none;"></div>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Every token is built from <code>crypto.getRandomValues</code>, the browser's cryptographically secure random source (CSPRNG).</li>
    <li>The selected encoding maps the raw bytes to text: hex uses 2 characters per byte, base64 uses 4 characters per 3 bytes, base64url is the URL-safe variant without padding, and UUID is a formatted 16-byte hex string.</li>
    <li>Entropy is set by the byte length, not the encoding  — 16 bytes is 128 bits of randomness.</li>
    <li>Generation happens entirely on your device; nothing is transmitted or stored.</li>
  </ul>

  <h2>About Random Token Generator</h2>
  <p class="text-muted">Random tokens are unpredictable strings used as credentials or one-time references: API keys, CSRF tokens, session identifiers, password-reset links, and email-verification codes. Their strength depends on how many bits of entropy they hold  — 16 bytes (128 bits) is a common default, and 16–32 bytes is ample for most purposes. The encoding only changes the text length, not the entropy: hex renders 2 characters per byte (a 16-byte token becomes 32 characters), while base64 renders 4 characters per 3 bytes (24 characters, 22 without padding); base64url swaps <code>+ /</code> for <code>- _</code> and drops the padding so the token is safe in URLs, query strings, and filenames.</p>
  <p class="text-muted">Use this generator whenever you need a fresh random credential: a new API key, a session id, a CSRF token, or a one-time reset link. Entropy must come from a cryptographically secure source  — this tool uses <code>crypto.getRandomValues</code>, while <code>Math.random</code> is not designed for security and must never be used for secrets. Store tokens the way you store passwords: hash them in the database so a leak does not expose working credentials, transmit them over HTTPS, and treat anything that cannot be re-derived (like a reset link) as single-use.</p>
</ToolPage>

<style>
  .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  #err { color: var(--danger); }
  #out code { display: inline-block; padding: 6px 10px; margin: 0; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  function randomBytes(n) {
    const b = new Uint8Array(n);
    crypto.getRandomValues(b);
    return b;
  }
  function toHex(bytes, upper) {
    let s = '';
    for (const b of bytes) s += b.toString(16).padStart(2, '0');
    return upper ? s.toUpperCase() : s;
  }
  function toB64(bytes) {
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return btoa(bin);
  }
  function toB64Url(bytes) {
    return toB64(bytes).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  }
  function toUUID(bytes) {
    const hex = toHex(bytes);
    return hex.slice(0, 8) + '-' + hex.slice(8, 12) + '-' + hex.slice(12, 16) + '-' + hex.slice(16, 20) + '-' + hex.slice(20);
  }

  function encode(bytes, enc) {
    switch (enc) {
      case 'hex': return toHex(bytes, false);
      case 'hex-upper': return toHex(bytes, true);
      case 'base64': return toB64(bytes);
      case 'base64url': return toB64Url(bytes);
      case 'uuid': return toUUID(bytes);
      default: return toHex(bytes, false);
    }
  }

  let tokens = [];

  function run() {
    const enc = $('enc').value;
    const count = parseInt($('count').value, 10);
    const err = $('err');
    err.style.display = 'none';

    const isUuid = enc === 'uuid';
    const len = isUuid ? 16 : parseInt($('len').value, 10);

    if (isNaN(count) || count < 1 || count > 10) { showToast('Count must be a number between 1 and 10.'); return; }
    if (!isUuid && (isNaN(len) || len < 4 || len > 128)) { showToast('Length must be a number between 4 and 128 bytes.'); return; }

    tokens = [];
    for (let i = 0; i < count; i++) {
      tokens.push(encode(randomBytes(len), enc));
    }
    $('out').innerHTML = tokens.map((t, i) =>
      '<div style="display:flex;align-items:center;gap:10px;padding:6px 0;border-bottom:1px solid var(--border);">' +
      '<code style="flex:1;white-space:pre-wrap;word-break:break-all;">' + t + '</code>' +
      '<button class="ghost" style="white-space:nowrap;" data-index="' + i + '">Copy</button>' +
      '</div>'
    ).join('');
    $('out').style.display = 'block';
    $('copy-all').style.display = 'inline-block';
  }

  $('enc').addEventListener('change', () => {
    const isUuid = $('enc').value === 'uuid';
    $('len').disabled = isUuid;
    $('len-note').style.display = isUuid ? 'block' : 'none';
  });
  $('gen').addEventListener('click', run);

  $('out').addEventListener('click', async (e) => {
    const btn = e.target.closest('button[data-index]');
    if (!btn) return;
    const i = parseInt(btn.dataset.index, 10);
    try {
      await navigator.clipboard.writeText(tokens[i]);
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy'; }, 1200);
    } catch {}
  });

  $('copy-all').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(tokens.join('\n'));
      $('copy-all').textContent = 'Copied all!';
      setTimeout(() => { $('copy-all').textContent = 'Copy all'; }, 1200);
    } catch {}
  });
})();
</script>
