---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "Hash Generator  — MD5, SHA-1, SHA-256 Online";
const description = "Compute MD5, SHA-1, SHA-256, SHA-384, SHA-512 of any text or file. All hashing happens in your browser.";
const faqs = [
  {
    "question": "How do I hash a string?",
    "answer": "Enter your text, select the algorithm (MD5, SHA-1, SHA-256, SHA-384, or SHA-512), and click Hash. The digest is computed in your browser using the Web Crypto API and displayed as a hexadecimal string."
  },
  {
    "question": "Is hashing reversible?",
    "answer": "No. A cryptographic hash is a one-way function \u2014 you cannot recover the original input from the hash. This is by design. If you need reversible encryption, use the AES or RSA tools instead."
  }
];
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';
---

<ToolPage
  site="sec"
  title={title}
  description={description}
  canonical="https://jsonversal.com/sec/tools/hash/"
  current="/sec/tools/hash/"
  faqs={faqs}
  about={[
    {
      "heading": "One pass, every digest, no key",
      "body": [
        "This page is the unkeyed view. It takes one input and produces every digest of those exact bytes at once — MD5, SHA-1, SHA-256, SHA-384 and SHA-512 — with optional hex and Base64 formatting, and it accepts a local file as the input source. Nothing is keyed and nothing is uploaded. Producing all five in one pass is the practical reason to prefer it when checking an integrity manifest: the digests must all come from the same bytes, and hashing the file five times separately invites a mismatch if it changes between reads.",
        "The four SHA digests come straight from `crypto.subtle.digest`, which is non-incremental and one-shot; SHA-1 and SHA-2 are implemented by every modern browser engine, which is why they need no bundled code. Hex and base64 output can be shown together, hex lowercase. That case detail is not cosmetic when you are string-matching a digest against a reference — half the world's manifests use uppercase hex."
      ]
    },
    {
      "heading": "Text and files are hashed differently",
      "body": [
        "Typed text is encoded with `TextEncoder`, so you get the UTF-8 bytes of that exact string; an uploaded file is read with `arrayBuffer()` and hashed as raw bytes, with no normalisation in either direction. This is the distinction behind most —why are these two files different— moments: a trailing newline, a BOM, or a tab versus spaces are all part of the input, and every one of them changes the digest completely.",
        "The practical consequence is that a checksum is only reproducible if the byte sequence is pinned. If you are hashing structured data to detect unauthorised edits, hash a canonical serialisation — sorted keys, fixed separators, no incidental whitespace — or the pretty-printed form will produce a different value on every reformat, and the check becomes noise. The avalanche effect is the flip side of the same property: change one character anywhere and every output bit is equally likely to flip."
      ]
    },
    {
      "heading": "Where this page stops",
      "body": [
        "There is one difference between this page and the hash-generator, and it concerns only MD5. SubtleCrypto does not implement MD5, so that digest comes from a bundled pure-JavaScript implementation of RFC 1321 rather than the browser's own. It runs over the same bytes as the SHA family, so the MD5 row is a real digest of your input — which matters when you are matching a checksum that a legacy system published. The other four rows go straight through SubtleCrypto, which is constant-time by design and considerably faster for large inputs.",
        "A plain digest proves nothing about origin, because anyone can recompute it. Tamper-evidence needs a keyed construction or a signature; a password store needs a deliberately slow, salted function. And no fast digest belongs in a credential path regardless of how it is obtained — use this page for content fingerprinting, cache keys, deduplication and verifying downloads, and choose the tool that matches the job."
      ]
    }
  ]}
>

  <section class="card mt-1">
    <h2 class="h2-card">Input</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" placeholder="Paste text here, or upload a file..." style="min-height:140px;"></textarea>
    <div style="margin-top:8px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <label class="ghost" style="display:inline-flex;align-items:center;gap:6px;cursor:pointer;padding:8px 14px;border-radius:var(--radius-sm);background:var(--surface-alt);border:1px solid var(--border);">
        Upload file
        <label for="file" class="sr-only">Input</label> <input id="file" type="file" hidden />
      </label>
      <label style="display:flex;align-items:center;gap:6px;"><input id="hex" type="checkbox" checked /> Hex output</label>
      <label style="display:flex;align-items:center;gap:6px;"><input id="b64" type="checkbox" /> Base64 output</label>
      <button class="primary" id="hash">Compute</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2">
    <strong>Hashes</strong>
    <div id="result" class="mt-2">—</div>
  </section>

  <h2>Notes</h2>
  <ul>
    <li>MD5 and SHA-1 are <strong>cryptographically broken</strong>  — use SHA-256 or SHA-512 for new systems.</li>
    <li>All processing uses the browser's <code>SubtleCrypto</code> API (SHA) and a bundled MD5 implementation.</li>
    <li>Nothing is uploaded.</li>
  </ul>

  <h2>About Hash Generator</h2>
  <p class="text-muted">A hash function maps data of any size to a fixed-length digest, and it is one-way: you cannot recover the original input from its output. This tool computes MD5, SHA-1, SHA-256, SHA-384, and SHA-512 digests so you can compare files, verify downloads, or check data integrity. SHA-256 and SHA-512 are the current cryptographic standards, while MD5 and SHA-1 are considered broken for security-sensitive uses.</p>
  <p class="text-muted">Use a hash when you need integrity verification  — for example, confirming that a downloaded file matches its published checksum. Never rely on MD5 or SHA-1 to protect passwords or sign data, and choose SHA-256 or SHA-512 for any new system. Note that a hash proves data was not accidentally corrupted, but it does not authenticate who the data came from.</p>
</ToolPage>

<script>
  import { md5Bytes } from '../../../../lib/md5.js';
  (function(){
  const $ = id => document.getElementById(id);

  // MD5 is not part of SubtleCrypto, so it comes from the shared pure-JS
  // implementation in src/lib/md5.js. It exists for interoperability with legacy
  // systems, not as a recommendation for new work.
  function computeMD5(bytes) {
    if (typeof md5Bytes === 'function') return md5Bytes(bytes);
    return '[MD5 unavailable]';
  }

  const enc = new TextEncoder();

  async function compute(algo, bytes) {
    if (algo === 'MD5') return computeMD5(bytes);
    const map = { 'SHA-1': 'SHA-1', 'SHA-256': 'SHA-256', 'SHA-384': 'SHA-384', 'SHA-512': 'SHA-512' };
    const buf = await crypto.subtle.digest(map[algo], bytes);
    return new Uint8Array(buf);
  }

  function fmt(bytes, useHex, useB64) {
    if (typeof bytes === 'string') return bytes;
    let out = '';
    if (useHex) out += Array.from(bytes).map(b => b.toString(16).padStart(2, '0')).join('');
    if (useB64) {
      const bin = Array.from(bytes).map(b => String.fromCharCode(b)).join('');
      if (out) out += '  ';
      out += btoa(bin);
    }
    return out;
  }

  async function run(data) {
    const algos = ['MD5', 'SHA-1', 'SHA-256', 'SHA-384', 'SHA-512'];
    const hex = $('hex').checked;
    const b64 = $('b64').checked;
    const lines = [];
    for (const a of algos) {
      const bytes = await compute(a, data);
      lines.push(`<strong>${a}</strong>\n${fmt(bytes, hex, b64)}`);
    }
    $('result').innerHTML = lines.map(l => `<pre style="margin-top:8px;">${l}</pre>`).join('');
  }

  $('hash').addEventListener('click', () => {
    const bytes = enc.encode($('input').value);
    run(bytes);
  });
  $('clear').addEventListener('click', () => { $('input').value = ''; $('result').textContent = '—'; });
  $('file').addEventListener('change', async (e) => {
    const f = e.target.files[0];
    if (!f) return;
    const buf = await f.arrayBuffer();
    run(new Uint8Array(buf));
  });

  // 默认跑一次
  $('input').value = 'hello world';
  $('hash').click();
  })();
</script>