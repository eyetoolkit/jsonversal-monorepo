---
import BaseLayout from '@versal/ui/BaseLayout';
import Hero from '@versal/ui/Hero.astro';
import ToolGrid from '@versal/ui/ToolGrid.astro';
import ToolCard from '@versal/ui/ToolCard.astro';

const tools = [
  { title: 'Hash Generator', description: 'Compute MD5, SHA-1, SHA-256, SHA-512 of any text.', href: '/sec/tools/hash/' },
  { title: 'AES Encryption / Decryption', description: 'Encrypt and decrypt text with AES using your own key. AES-GCM supported.', href: '/sec/tools/aes/' },
  { title: 'BCrypt Hash & Verify', description: 'Hash passwords with BCrypt (adaptive cost) and verify a hash.', href: '/sec/tools/bcrypt/' },
  { title: 'HMAC Calculator', description: 'Compute HMAC-SHA256/384/512 signatures for your message and key.', href: '/sec/tools/hmac/' },
  { title: 'Random Password Generator', description: 'Generate strong random passwords with a cryptographically secure RNG.', href: '/sec/tools/password-generator/' },
  { title: 'File Checksum Calculator', description: 'Compute SHA-256 / SHA-1 checksums of local files in your browser.', href: '/sec/tools/file-checksum/' },
  { title: 'Password Strength Analyzer', description: 'Score a password and get a human-readable strength hint.', href: '/sec/tools/password-strength/' },
  { title: 'CSP Generator', description: 'Build a strict Content-Security-Policy header from toggles.', href: '/sec/tools/csp/' },
  { title: 'Certificate Signing Request Decoder', description: 'Decode a PEM-encoded CSR and show subject, SANs, and public key.', href: '/sec/tools/csr/' },
  { title: 'TOTP Authenticator', description: 'Generate 6-digit TOTP codes from a Base32 secret, RFC 6238.', href: '/sec/tools/totp/' },
  { title: 'Random Token Generator', description: 'CSPRNG hex / base64 / base64url / UUID tokens for API keys.', href: '/sec/tools/random-token/' },
  { title: 'RSA Key Pair Generator', description: 'Generate RSA-OAEP key pairs and encrypt/decrypt text locally.', href: '/sec/tools/rsa-keygen/' },
  { title: 'JWT Generator & Signer', description: 'Build and sign JWTs with HS256 / HS384 / HS512 in-browser.', href: '/sec/tools/jwt-generator/' },
  { title: 'X.509 Certificate Decoder', description: 'Decode PEM certificates: subject, issuer, SANs, key usage.', href: '/sec/tools/x509-decoder/' },
  { title: 'Hash Identifier', description: 'Identify hash formats: MD5/SHA families, bcrypt, crypt, JWT, UUID, AWS keys.', href: '/sec/tools/hash-identifier/' },
  { title: 'Passphrase Generator', description: 'Diceware-style memorable passphrases with entropy estimates.', href: '/sec/tools/passphrase-generator/' },
  { title: 'Password-Based Encryption', description: 'PBKDF2 + AES-GCM encrypt/decrypt of text with a password.', href: '/sec/tools/password-encrypt/' },
  { title: 'Secret & API Key Scanner', description: 'Detect and redact leaked credentials in logs, configs and env dumps.', href: '/sec/tools/secret-scanner/' },
];
---

<BaseLayout site="sec" current="/sec/">
  <Hero
    overline="Security · cryptography in your browser"
    sub="No signup, no upload. Everything stays on your device — keys, secrets and passwords never leave your browser."
  >
    Security tools that <span class="grad">run in your browser.</span>
    <Fragment slot="actions">
      <a class="button button-primary" href="/sec/tools/">Browse all security tools</a>
      <a class="button button-ghost" href="/sec/tools/password-generator/">Generate a password</a>
    </Fragment>
  </Hero>

  <div class="section-head">
    <span class="overline">Security toolkit</span>
    <h2>Cryptography &amp; secrets, locally</h2>
    <p>Hash, encrypt and inspect security primitives — AES, bcrypt, HMAC, TOTP, JWT, X.509, CSP and more. All client-side.</p>
  </div>
  <ToolGrid tools={tools} />

  <div class="brand-strip">
    <h2>Related — from the jsonversal brand</h2>
    <div class="grid">
      <ToolCard title="DevOps Tools" description="devops — YAML/JSON, Base64, JWT, crontab." href="/devops/" />
      <ToolCard title="Code Generators" description="codegen — .gitignore, license, CI workflow." href="/codegen/" />
      <ToolCard title="JSON / LLM Tools" description="jsonversal — UUID v7, JSON to TypeScript." href="/tools/" />
    </div>
  </div>
</BaseLayout>