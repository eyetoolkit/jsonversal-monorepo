    font-weight: 500;
    font-size: var(--v-fs-xs);
    color: var(--v-hush);
    margin-top: 4px;
  }
  .flow-node--accent {
    border-color: var(--v-accent);
    background: var(--v-accent-soft);
    color: var(--v-accent-ink);
  }
  .flow-node--bad {
    border-color: #ef4444;
    background: #fef2f2;
    color: #b91c1c;
  }
  .flow-arrow {
    font-weight: 700;
    color: var(--v-hush);
    font-size: var(--v-fs-base);
  }
  .flow-note {
    font-size: var(--v-fs-sm);
    color: var(--v-mute);
    margin: var(--v-s-3) 0 0;
  }
  .flow-note--bad { color: #b91c1c; }

  .cmp {
    border: 1px solid var(--v-line);
    border-radius: var(--v-r-lg);
    overflow: hidden;
    box-shadow: var(--v-sh-xs);
  }
  .cmp__row {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    border-top: 1px solid var(--v-line);
  }
  .cmp__row:first-child { border-top: none; }
  .cmp__cell {
    padding: var(--v-s-4) var(--v-s-5);
    font-size: var(--v-fs-sm);
    color: var(--v-ink-soft);
    border-left: 1px solid var(--v-line);
  }
  .cmp__cell:first-child { border-left: none; font-weight: 600; color: var(--v-ink); }
  .cmp__row--head .cmp__cell {
    font-weight: 700;
    background: var(--v-mist);
    color: var(--v-ink);
  }
  .cmp__cell--bad { background: color-mix(in srgb, #ef4444 7%, var(--v-paper)); color: #b91c1c; }
  .cmp__cell--good { background: color-mix(in srgb, #059669 8%, var(--v-paper)); color: #047857; font-weight: 600; }

  .t-steps {
    margin: 0;
    padding-left: var(--v-s-6);
    display: flex;
    flex-direction: column;
    gap: var(--v-s-3);
    color: var(--v-ink-soft);
    line-height: 1.6;
  }
  .t-steps code {
    background: var(--v-fog);
    padding: 1px 6px;
    border-radius: 6px;
    font-size: 0.9em;
  }

  .t-cta {
    margin-top: var(--v-s-10);
    padding: var(--v-s-8);
    background: var(--v-mist);
    border: 1px solid var(--v-line);
    border-radius: var(--v-r-xl);
    display: flex;
    flex-wrap: wrap;
    gap: var(--v-s-6);
    align-items: center;
    justify-content: space-between;
  }
  .t-cta h3 { margin: 0 0 var(--v-s-2); font-size: var(--v-fs-xl); }
  .t-cta p { margin: 0; color: var(--v-mute); max-width: 520px; line-height: 1.55; }
  .t-cta__links { display: flex; gap: var(--v-s-3); flex-wrap: wrap; }
  .v-btn {
    display: inline-block;
    background: var(--v-accent);
    color: #fff;
    font-weight: 600;
    padding: 12px 20px;
    border-radius: var(--v-r-md);
    text-decoration: none;
    box-shadow: var(--v-sh-sm);
  }
  .v-btn--ghost {
    background: transparent;
    color: var(--v-accent-ink);
    border: 1px solid var(--v-accent);
    box-shadow: none;
  }

  @media (max-width: 720px) {
    .cmp__row { grid-template-columns: 1fr; }
    .cmp__cell { border-left: none; border-top: 1px solid var(--v-line); }
    .cmp__cell:first-child { border-top: none; }
    .flow { flex-direction: column; align-items: stretch; }
    .flow-arrow { transform: rotate(90deg); text-align: center; }
  }
</style>
