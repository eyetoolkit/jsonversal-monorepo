    padding: var(--v-s-12) 0 var(--v-s-8);
    max-width: 880px;
  }
  .trust-hero__kicker {
    display: inline-block;
    font-size: var(--v-fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--v-accent-ink);
    background: var(--v-accent-soft);
    padding: 4px 10px;
    border-radius: var(--v-r-pill);
    margin-bottom: var(--v-s-4);
  }
  .trust-hero h1 {
    font-size: var(--v-fs-3xl);
    line-height: 1.12;
    margin: 0 0 var(--v-s-4);
    letter-spacing: -0.02em;
  }
  .trust-hero__sub {
    font-size: var(--v-fs-lg);
    color: var(--v-mute);
    line-height: 1.6;
    margin: 0;
  }
  .trust-hero__sub a { color: var(--v-accent-ink); font-weight: 600; }

  .t-section {
    padding: var(--v-s-10) 0;
    border-top: 1px solid var(--v-line);
  }
  .t-section__head { margin-bottom: var(--v-s-6); }
  .t-section__kicker {
    font-size: var(--v-fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--v-accent);
  }
  .t-section__head h2 {
    font-size: var(--v-fs-2xl);
    margin: var(--v-s-2) 0 var(--v-s-3);
    letter-spacing: -0.01em;
  }
  .t-section__sub {
    font-size: var(--v-fs-base);
    color: var(--v-mute);
    max-width: 720px;
    line-height: 1.6;
    margin: 0;
  }
  .t-lead {
    font-size: var(--v-fs-lg);
    color: var(--v-ink-soft);
    line-height: 1.65;
    margin: 0 0 var(--v-s-6);
  }
  .t-lead a { color: var(--v-accent-ink); font-weight: 600; }
  .t-body {
    color: var(--v-ink-soft);
    line-height: 1.7;
    margin: 0 0 var(--v-s-4);
  }
  .t-note {
    font-size: var(--v-fs-xs);
    color: var(--v-hush);
    border-top: 1px dashed var(--v-line);
    padding-top: var(--v-s-3);
    margin: 0;
  }
  .t-callout {
    margin: var(--v-s-5) 0 0;
    padding: var(--v-s-5);
    border-left: 4px solid var(--v-accent);
    background: var(--v-accent-soft);
    border-radius: 0 var(--v-r-md) var(--v-r-md) 0;
    color: var(--v-ink-soft);
    line-height: 1.65;
  }

  .stat-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
