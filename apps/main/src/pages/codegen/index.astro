---
import BaseLayout from '@versal/ui/BaseLayout';
import Hero from '@versal/ui/Hero.astro';
import ToolGrid from '@versal/ui/ToolGrid.astro';
import ToolCard from '@versal/ui/ToolCard.astro';

const tools = [
  { title: '.env Template Generator', description: 'Generate a .env template from a JSON object or "key: value" text — keys become UPPER_SNAKE_CASE, values are serialized without quotes.', href: '/codegen/tools/env-generator/' },
  { title: '.gitignore Generator', description: 'Generate a .gitignore file by selecting your language and frameworks. Templated from GitHub\\\'s gitignore repo.', href: '/codegen/tools/gitignore/' },
  { title: 'Base64 Image Viewer', description: 'Convert a base64 data URI into a viewable, downloadable image, or turn an image file into a base64 data URI. Auto-detects PNG, JPEG, GIF, WebP and SVG.', href: '/codegen/tools/base64-image/' },
  { title: 'CSV to JSON Converter', description: 'Convert CSV, TSV or semicolon-separated files into JSON with optional type inference. Handles quoted fields, embedded commas and newlines. No upload.', href: '/codegen/tools/csv-to-json/' },
  { title: 'cURL to Fetch Converter', description: 'Parse a curl command and generate browser or Node fetch() code using async/await — methods, headers, JSON bodies, cookies and basic auth included.', href: '/codegen/tools/curl-to-fetch/' },
  { title: 'cURL to Python (requests)', description: 'Parse a curl command and generate a runnable Python script with requests or httpx — method, headers, JSON and form bodies, cookies, auth and TLS options.', href: '/codegen/tools/curl-to-python/' },
  { title: 'Docker Compose Generator', description: 'Scaffold a docker-compose.yml with services, ports, volumes, and environment variables from a simple form. Runs entirely in your browser.', href: '/codegen/tools/docker-compose/' },
  { title: 'HTML Entity Escaper', description: 'Escape text and code into HTML entities (ampersand, angle brackets, quotes) and unescape it back. Handy before pasting code into pre or code blocks.', href: '/codegen/tools/html-escaper/' },
  { title: 'JSON ↔ XML Converter', description: 'Convert JSON to XML or XML to JSON with a single click. Handles nested objects, arrays, attributes, and text nodes. Runs entirely in your browser.', href: '/codegen/tools/json-xml/' },
  { title: 'JSON Schema to TypeScript', description: 'Convert a JSON Schema (draft-07) into TypeScript interfaces and type aliases — properties, required, enums, unions, $refs and nested objects. No upload.', href: '/codegen/tools/schema-to-typescript/' },
  { title: 'JSON to CSV Converter', description: 'Convert a JSON array of objects into CSV — columns are the union of all keys, missing values stay blank, and rows use CRLF line endings per RFC 4180.', href: '/codegen/tools/json-to-csv/' },
  { title: 'JSON to Python Dict', description: 'Convert a JSON sample into a Python dict literal — valid identifier keys stay bare, invalid keys get quoted, and true/false/null become True/False/None.', href: '/codegen/tools/json-to-python/' },
  { title: 'JSON to SQL Generator', description: 'Generate CREATE TABLE and INSERT statements from a JSON array. Infers column types and safely escapes string values. Runs entirely in your browser.', href: '/codegen/tools/sql-generator/' },
  { title: 'LLM Structured Output Validator', description: 'Validate JSON Schemas for LLM structured output. Presets for OpenAI, Anthropic and Gemini. Preview mock data and check real model output. No upload.', href: '/codegen/tools/llm-structured-output-validator/' },
  { title: 'SQL Formatter', description: 'Format messy SQL into clean, indented statements or minify it to a single line. Handles strings, comments, identifiers and subqueries. No upload.', href: '/codegen/tools/sql-formatter/' },
  { title: 'SQL Validator — Check SQL Syntax Online', description: 'Validate SQL syntax for MySQL, PostgreSQL, SQLite, and SQL Server instantly. Paste your SQL and get error locations and explanations. 100% browser-based.', href: '/codegen/tools/sql-validator/' },
];
---

<BaseLayout site="codegen" current="/codegen/">
  <Hero
    overline="Codegen · generate configs &amp; code in your browser"
    sub="No signup, no upload. Every generator runs 100% locally — your templates never leave your device."
  >
    Code generators that <span class="grad">run in your browser.</span>
    <Fragment slot="actions">
      <a class="button button-primary" href="/codegen/tools/">Browse all generators</a>
      <a class="button button-ghost" href="/codegen/tools/gitignore/">Generate a .gitignore</a>
    </Fragment>
  </Hero>

  <div class="section-head">
    <span class="overline">Codegen toolkit</span>
    <h2>Generate code &amp; config files</h2>
    <p>.gitignore, license, README, CI workflow, commit messages, SQL, Docker Compose and more — instantly.</p>
  </div>
  <ToolGrid tools={tools} />

  <div class="brand-strip">
    <h2>Related — from the jsonversal brand</h2>
    <div class="grid">
      <ToolCard title="DevOps Tools" description="devops — YAML/JSON, Base64, JWT, crontab, regex." href="/devops/" />
      <ToolCard title="JSON / LLM Tools" description="jsonversal — UUID v7, JSON to TS, LLM token calculator." href="/tools/" />
      <ToolCard title="Security Tools" description="sec — Hash, AES, password strength." href="/sec/" />
    </div>
  </div>
</BaseLayout>