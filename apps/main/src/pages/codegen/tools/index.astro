---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolGrid from '@versal/ui/ToolGrid.astro';

const tools = [
  { title: '.gitignore Generator', description: 'Generate .gitignore for any language or framework.', href: '/codegen/tools/gitignore/' },
  { title: 'LLM Structured Output Validator', description: 'Validate JSON Schemas designed for LLM outputs. Presets for OpenAI, Anthropic, Gemini. Test real LLM responses.', href: '/codegen/tools/llm-structured-output-validator/' },
  { title: 'License Generator', description: 'Pick a license, fill in metadata, download the file.', href: '/codegen/tools/license/' },
  { title: 'README Skeleton', description: 'Generate a professional README structure for your repo.', href: '/codegen/tools/readme/' },
  { title: 'GitHub Actions Workflow', description: 'Scaffold CI workflows: Node, Python, Go, Docker.', href: '/codegen/tools/ci-workflow/' },
  { title: 'JSON to Python', description: 'Convert a JSON sample into a ready-to-use Python dict literal.', href: '/codegen/tools/json-to-python/' },
  { title: 'cURL to Fetch', description: 'Turn a curl command into modern browser/Node fetch() code.', href: '/codegen/tools/curl-to-fetch/' },
  { title: '.env Template Generator', description: 'Generate an .env template from JSON or key: value pairs.', href: '/codegen/tools/env-generator/' },
  { title: 'Conventional Commit', description: 'Format commit messages: feat/fix/chore with scope.', href: '/codegen/tools/commit-msg/' },
  { title: 'HTML Entity Escaper', description: 'Escape and unescape HTML entities in any text.', href: '/codegen/tools/html-escaper/' },
  { title: 'JSON to CSV', description: 'Turn a JSON array into CSV with proper quoting.', href: '/codegen/tools/json-to-csv/' },
  { title: 'CSV to JSON', description: 'Parse CSV/TSV into JSON with type inference.', href: '/codegen/tools/csv-to-json/' },
  { title: 'JSON ↔ XML Converter', description: 'Convert JSON to XML or XML to JSON.', href: '/codegen/tools/json-xml/' },
  { title: 'JSON to SQL Generator', description: 'Generate CREATE TABLE + INSERT from JSON arrays.', href: '/codegen/tools/sql-generator/' },
  { title: 'Docker Compose Generator', description: 'Scaffold docker-compose.yml with ports and volumes.', href: '/codegen/tools/docker-compose/' },
  { title: 'JSON Schema to TypeScript', description: 'Convert a JSON Schema (draft-07) into TypeScript interfaces.', href: '/codegen/tools/schema-to-typescript/' },
  { title: 'cURL to Python', description: 'Turn curl commands into runnable Python requests/httpx code.', href: '/codegen/tools/curl-to-python/' },
  { title: 'Base64 Image Viewer', description: 'Decode base64 images for preview/download, or encode files.', href: '/codegen/tools/base64-image/' },
  { title: 'SQL Formatter', description: 'Pretty-print or minify SQL with a real tokenizer.', href: '/codegen/tools/sql-formatter/' },
];
---

<BaseLayout site="codegen" title="All Code Generators" current="/codegen/tools/">
  <div class="tool-head">
    <h1>Code Generators</h1>
    <p class="desc">Generate code and config files instantly in your browser. Use the filter to find a generator.</p>
  </div>

  <ToolGrid tools={tools} />
</BaseLayout>