---
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'cURL to Python (requests)';
const description = 'Parse a curl command (from the browser "Copy as cURL") and generate an equivalent runnable Python script using requests or httpx — method, headers, JSON/form bodies, cookies, basic auth and TLS options included.';
---

<BaseLayout
  site="codegen"
  title={title}
  description={description}
  canonical="https://jsonversal.com/codegen/tools/curl-to-python/"
  keywords={['cURL to Python converter', 'convert curl to python requests', 'curl to python', 'curl python converter', 'curl-to-python', 'curl-to-python', 'curl-to-python']}
  current="/codegen/tools/curl-to-python/"
>
  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-2">
    <h2 class="h2-card">Paste your curl command</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" spellcheck="false" placeholder="curl -X POST https://api.example.com/v1/users -H &quot;Authorization: Bearer sk-123&quot; -H &quot;Content-Type: application/json&quot; -d &quot;&#123;name: Alice, active: true&#125;&quot;"></textarea>
    <div class="row mt-1">
      <label class="text-muted" for="lib">Library</label>
      <label for="lib" class="sr-only">Paste your curl command</label> <select id="lib">
        <option value="requests">requests</option>
        <option value="httpx">httpx</option>
      </select>
      <button class="primary" id="gen">Convert</button>
      <button class="ghost" id="sample">Load sample</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="out-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">Python code</h2>
      <div class="row" style="gap:8px;">
        <span class="text-dim" id="meta" style="font-size:.85rem;"></span>
        <button class="ghost" id="copy">Copy</button>
      </div>
    </div>
    <pre id="output" class="mt-1">—</pre>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <h2 class="h2-error">Error</h2>
    <pre id="err-out" class="mt-1" style="color:var(--danger);">—</pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Tokenizes the command, respecting single and double quotes with escapes.</li>
    <li>Maps <code>-X</code>, <code>-H</code>, <code>-d</code>/<code>--data-raw</code>/<code>--json</code>, <code>-u</code>, <code>-b</code>, <code>-A</code>, <code>-F</code>, <code>-L</code>, <code>--compressed</code> and <code>--insecure</code> to requests/httpx arguments.</li>
    <li>JSON payloads become <code>json=</code> dicts, form payloads become <code>data=</code> dicts, anything else is passed as a raw string.</li>
    <li>Unsupported flags are listed as comments in the output instead of being silently dropped.</li>
  </ul>

  <h2>About cURL to Python</h2>
  <p class="text-muted">When you copy a request out of the browser network tab or a README, curl is the format you get — but a Python script, test or automation job wants <code>requests</code> or <code>httpx</code> instead. This converter reproduces the request semantics: repeated headers are merged into a dict, JSON-looking bodies become <code>json=</code> so they are serialized correctly, cookies become a <code>cookies=</code> dict, and basic auth becomes <code>auth=(user, password)</code>.</p>
  <p class="text-muted">The generated script is complete and runnable: imports, a try/except around the call, a printed status code and response text. Options that have no Python equivalent — like <code>-o</code> file output or exotic curl flags — are kept as comments so you know what was skipped. Defaults differ in one notable way: curl sends <code>Content-Type: application/x-www-form-urlencoded</code> for <code>-d</code> payloads, while requests does not; the converter preserves the headers you actually passed.</p>
</BaseLayout>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  textarea { min-height: 160px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .875rem; }
  pre { min-height: 80px; max-height: 560px; overflow: auto; white-space: pre-wrap; word-break: break-word; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  const SAMPLE = `curl -X POST https://api.example.com/v1/users \\
  -H "Authorization: Bearer sk-123" \\
  -H "Content-Type: application/json" \\
  -H "Accept: application/json" \\
  --data-raw '{"name": "Alice", "email": "alice@example.com", "role": "admin", "active": true, "score": 98.5}'`;

  function tokenize(cmd) {
    const tokens = [];
    let i = 0;
    const s = cmd.trim();
    while (i < s.length) {
      while (i < s.length && /\s/.test(s[i])) i++;
      if (i >= s.length) break;
      let tok = '';
      const c = s[i];
      if (c === '"' || c === "'") {
        const q = c; i++;
        while (i < s.length && s[i] !== q) {
          if (q === '"' && s[i] === '\\' && i + 1 < s.length) { tok += s[i + 1]; i += 2; continue; }
          tok += s[i]; i++;
        }
        i++;
      } else {
        while (i < s.length && !/\s/.test(s[i])) {
          if (s[i] === '"' || s[i] === "'") {
            const q = s[i]; i++;
            while (i < s.length && s[i] !== q) { tok += s[i]; i++; }
            i++;
          } else { tok += s[i]; i++; }
        }
      }
      if (tok !== '' && tok !== '\\') tokens.push(tok);
    }
    return tokens;
  }

  function pyStr(s) {
    let str = String(s)
      .replace(/\\/g, '\\\\')
      .replace(/\n/g, '\\n')
      .replace(/\r/g, '\\r')
      .replace(/\t/g, '\\t');
    if (str.includes('"') && !str.includes("'")) return "'" + str + "'";
    return '"' + str.replace(/"/g, '\\"') + '"';
  }

  function jsonToPy(v, pad) {
    if (v === null) return 'None';
    if (typeof v === 'boolean') return v ? 'True' : 'False';
    if (typeof v === 'number') return String(v);
    if (typeof v === 'string') return pyStr(v);
    if (Array.isArray(v)) {
      if (!v.length) return '[]';
      return '[\n' + v.map(x => pad + '    ' + jsonToPy(x, pad + '    ')).join(',\n') + '\n' + pad + ']';
    }
    const keys = Object.keys(v);
    if (!keys.length) return '{}';
    return '{\n' + keys.map(k => pad + '    ' + pyStr(k) + ': ' + jsonToPy(v[k], pad + '    ')).join(',\n') + '\n' + pad + '}';
  }

  function formToPairs(s) {
    const out = [];
    for (const pair of String(s).split('&')) {
      if (!pair) continue;
      const i = pair.indexOf('=');
      const k = i >= 0 ? pair.slice(0, i) : pair;
      const v = i >= 0 ? pair.slice(i + 1) : '';
      try {
        out.push([decodeURIComponent(k.replace(/\+/g, ' ')), decodeURIComponent(v.replace(/\+/g, ' '))]);
      } catch (e) {
        out.push([k, v]);
      }
    }
    return out;
  }

  function parseCurl(tokens) {
    const headers = [];
    const forms = [];
    let url = null, method = null, data = null, jsonFlag = false;
    let cookie = null, user = null, output = null;
    let insecure = false, location = false, compressed = false;
    const unknown = [];
    let i = 0;
    while (i < tokens.length) {
      const t = tokens[i];
      if (t === 'curl') { i++; continue; }
      if (t === '-X' || t === '--request') { method = tokens[i + 1] || null; i += 2; continue; }
      if (t === '-H' || t === '--header') { headers.push(tokens[i + 1] || ''); i += 2; continue; }
      if (t === '-d' || t === '--data' || t === '--data-raw' || t === '--data-ascii' || t === '--data-binary' || t === '--data-urlencode') { data = tokens[i + 1] || ''; i += 2; continue; }
      if (t === '--json') { jsonFlag = true; data = tokens[i + 1] || ''; i += 2; continue; }
      if (t === '-F' || t === '--form' || t === '--form-string') { forms.push(tokens[i + 1] || ''); i += 2; continue; }
      if (t === '-u' || t === '--user') { user = tokens[i + 1] || ''; i += 2; continue; }
      if (t === '-b' || t === '--cookie') { cookie = tokens[i + 1] || ''; i += 2; continue; }
      if (t === '-A' || t === '--user-agent') { headers.push('User-Agent: ' + (tokens[i + 1] || '')); i += 2; continue; }
      if (t === '-o' || t === '--output') { output = tokens[i + 1] || ''; i += 2; continue; }
      if (t === '-L' || t === '--location') { location = true; i++; continue; }
      if (t === '--compressed') { compressed = true; i++; continue; }
      if (t === '-k' || t === '--insecure') { insecure = true; i++; continue; }
      if (t === '-s' || t === '-S' || t === '--silent' || t === '--show-error' || t === '-v' || t === '--verbose' || t === '-i' || t === '--include' || t === '-I' || t === '--head' || t === '--fail') { i++; continue; }
      if (t.startsWith('-') && t !== '-') { unknown.push(t); i++; continue; }
      if (!url) url = t;
      i++;
    }
    return { url, method, data, jsonFlag, cookie, user, output, insecure, location, compressed, headers, forms, unknown };
  }

  function convert(cmd, lib) {
    const tokens = tokenize(cmd);
    if (!tokens.length) throw new Error('The command is empty. Paste a curl command like: curl https://api.example.com/');
    const p = parseCurl(tokens);
    if (!p.url) throw new Error('Could not find a URL in the curl command. Make sure the command contains a quoted or bare URL.');
    if (p.url.includes('{')) throw new Error('The URL contains a shell brace template such as {id}. Replace it with a concrete value first, then convert again.');
    if (p.data !== null && p.data.startsWith('@')) throw new Error('The data payload is read from a file (@file), which cannot be inlined. Paste the file contents instead.');

    // headers dict
    const headers = {};
    for (const h of p.headers) {
      const idx = h.indexOf(':');
      if (idx > 0) {
        const k = h.slice(0, idx).trim();
        const v = h.slice(idx + 1).trim();
        headers[k] = headers[k] ? headers[k] + '; ' + v : v;
      }
    }

    // cookies
    let cookiesPairs = null;
    if (p.cookie) {
      const parts = p.cookie.split(';').map(s => s.trim()).filter(Boolean);
      const withEq = parts.filter(x => x.includes('='));
      if (withEq.length) {
        cookiesPairs = withEq.map(x => {
          const i = x.indexOf('=');
          return [x.slice(0, i).trim(), x.slice(i + 1).trim()];
        });
      } else {
        headers['Cookie'] = headers['Cookie'] ? headers['Cookie'] + '; ' + p.cookie : p.cookie;
      }
    }

    // auth
    let auth = null;
    if (p.user) {
      const ci = p.user.indexOf(':');
      auth = ci >= 0 ? [p.user.slice(0, ci), p.user.slice(ci + 1)] : [p.user, ''];
    }

    // body
    const ctKey = Object.keys(headers).find(k => k.toLowerCase() === 'content-type');
    const ctVal = ctKey ? headers[ctKey].toLowerCase() : '';
    let jsonBody = null, dataDict = null, dataBody = null;
    if (p.data !== null && p.data !== '') {
      const raw = p.data;
      const looksJson = p.jsonFlag || ctVal.indexOf('application/json') !== -1 || /^[\s]*[\[{]/.test(raw);
      if (looksJson) {
        let parsed = null;
        try { parsed = JSON.parse(raw); } catch (e) {}
        if (parsed !== null) jsonBody = parsed;
        else dataBody = raw;
      } else if (ctVal.indexOf('application/x-www-form-urlencoded') !== -1) {
        dataDict = formToPairs(raw);
      } else {
        dataBody = raw;
      }
    }
    let files = null;
    if (p.forms.length) {
      files = {};
      for (const f of p.forms) {
        const idx = f.indexOf('=');
        if (idx <= 0) continue;
        const k = f.slice(0, idx).trim();
        let v = f.slice(idx + 1).trim();
        files[k] = v.startsWith('@') ? 'open(' + pyStr(v.slice(1)) + ', "rb")' : pyStr(v);
      }
    }

    let method = p.method || (p.data !== null || p.forms.length ? 'POST' : 'GET');
    method = method.toUpperCase();

    const L = [];
    L.push('# Generated by cURL to Python converter (codegen)');
    L.push('# Original command:');
    for (const line of cmd.trim().split('\n')) L.push('#   ' + line.trim());
    L.push('# Method: ' + method);
    L.push('# URL: ' + p.url);
    L.push('');
    L.push('import ' + lib);
    L.push('');
    L.push('url = ' + pyStr(p.url));
    L.push('');
    if (Object.keys(headers).length) {
      L.push('headers = {');
      for (const k of Object.keys(headers)) L.push('    ' + pyStr(k) + ': ' + pyStr(headers[k]) + ',');
      L.push('}');
      L.push('');
    }
    if (jsonBody !== null) {
      L.push('payload = ' + jsonToPy(jsonBody, ''));
      L.push('');
    }
    if (dataDict) {
      L.push('data = {');
      for (const pair of dataDict) L.push('    ' + pyStr(pair[0]) + ': ' + pyStr(pair[1]) + ',');
      L.push('}');
      L.push('');
    }
    if (dataBody !== null) {
      L.push('data = ' + pyStr(dataBody));
      L.push('');
    }
    if (files) {
      L.push('files = {');
      for (const k of Object.keys(files)) L.push('    ' + pyStr(k) + ': ' + files[k] + ',');
      L.push('}');
      L.push('');
    }
    if (auth) {
      L.push('auth = (' + pyStr(auth[0]) + ', ' + pyStr(auth[1]) + ')');
      L.push('');
    }
    if (cookiesPairs) {
      L.push('cookies = {');
      for (const pair of cookiesPairs) L.push('    ' + pyStr(pair[0]) + ': ' + pyStr(pair[1]) + ',');
      L.push('}');
      L.push('');
    }

    const args = ['url'];
    if (Object.keys(headers).length) args.push('headers=headers');
    if (jsonBody !== null) args.push('json=payload');
    if (dataDict) args.push('data=data');
    if (dataBody !== null) args.push('data=data');
    if (files) args.push('files=files');
    if (auth) args.push('auth=auth');
    if (cookiesPairs) args.push('cookies=cookies');
    args.push('timeout=30');
    if (p.insecure) args.push('verify=False');

    const excCls = lib === 'httpx' ? 'httpx.RequestError' : 'requests.RequestException';
    L.push('try:');
    L.push('    response = ' + lib + '.' + method.toLowerCase() + '(' + args.join(', ') + ')');
    L.push('    response.raise_for_status()');
    L.push('    print(response.status_code)');
    L.push('    print(response.text)');
    L.push('except ' + excCls + ' as exc:');
    L.push('    print(f"Request failed: {exc}")');
    L.push('');

    const notes = [];
    if (p.unknown.length) notes.push('# Skipped flags: ' + p.unknown.join(', '));
    if (p.output) notes.push('# Note: -o/--output (' + p.output + ') ignored — the response is printed to stdout.');
    if (p.location) notes.push('# Note: --location redirects are followed automatically by ' + lib + '.');
    if (p.compressed) notes.push('# Note: --compressed — ' + lib + ' handles gzip/deflate transparently.');
    if (notes.length) L.push(notes.join('\n'));

    const headerCount = Object.keys(headers).length;
    return {
      text: L.join('\n').trim(),
      meta: method + ' · ' + headerCount + ' header' + (headerCount === 1 ? '' : 's') +
        (jsonBody !== null ? ' · JSON body' : dataBody !== null ? ' · raw body' : dataDict ? ' · form body' : files ? ' · multipart' : ' · no body'),
    };
  }

  $('gen').addEventListener('click', () => {
    const raw = $('input').value.trim();
    $('err-section').style.display = 'none';
    if (!raw) { showToast('Paste a curl command first.'); return; }
    try {
      const res = convert(raw, $('lib').value);
      $('output').textContent = res.text;
      $('meta').textContent = res.meta;
      $('out-section').style.display = 'block';
    } catch (e) {
      $('err-out').textContent = e.message;
      $('err-section').style.display = 'block';
      $('out-section').style.display = 'none';
    }
  });

  $('sample').addEventListener('click', () => { $('input').value = SAMPLE; });

  $('clear').addEventListener('click', () => {
    $('input').value = '';
    $('out-section').style.display = 'none';
    $('err-section').style.display = 'none';
  });

  $('copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText($('output').textContent);
      $('copy').textContent = 'Copied!';
      setTimeout(() => { $('copy').textContent = 'Copy'; }, 1200);
    } catch {}
  });
})();
</script>
