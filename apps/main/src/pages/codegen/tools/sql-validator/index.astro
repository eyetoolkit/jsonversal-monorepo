---
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'SQL Validator — Check SQL Syntax Online';
const description = 'Validate SQL syntax for MySQL, PostgreSQL, SQLite, and SQL Server instantly. Paste your SQL and get error locations and explanations. 100% browser-based.';
---

<BaseLayout
  site="codegen"
  title={title}
  description={description}
  canonical="https://jsonversal.com/codegen/tools/sql-validator/"
  keywords={['SQL validator', 'validate SQL', 'SQL syntax checker', 'check SQL syntax', 'SQL linter', 'SQL syntax validator', 'sql-validator']}
  current="/codegen/tools/sql-validator/"
>
  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-2">
    <h2 class="h2-card">Your SQL</h2>
    <label for="sql-input" class="sr-only">SQL input</label>
    <textarea id="sql-input" aria-label="SQL input" spellcheck="false" placeholder="Paste your SQL here... SELECT * FROM users WHERE id = 1"></textarea>
    <div class="row mt-1">
      <label class="text-muted" for="dialect">Dialect</label>
      <label for="dialect" class="sr-only">Dialect</label>
      <select id="dialect">
        <option value="mysql">MySQL</option>
        <option value="postgres">PostgreSQL</option>
        <option value="sqlite">SQLite</option>
        <option value="sqlserver">SQL Server</option>
      </select>
      <button class="primary" id="validate-btn">Validate</button>
      <button class="ghost" id="format-btn">Format</button>
      <button class="ghost" id="clear-btn">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="ok-section" style="display:none;">
    <div class="row">
      <span class="icon-ok">&#10003;</span>
      <h2 class="h2-flat" style="margin:0;">Valid SQL</h2>
    </div>
    <p class="text-dim mt-1" id="ok-msg" style="font-size:.85rem;"></p>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <div class="row">
      <span class="icon-err">&#10007;</span>
      <h2 class="h2-flat" style="margin:0;color:var(--danger);">Syntax Error</h2>
    </div>
    <pre id="err-out" class="mt-1" style="color:var(--danger);white-space:pre-wrap;"></pre>
    <div class="text-dim mt-1" id="err-advice" style="font-size:.85rem;"></div>
  </section>

  <section class="card mt-2" id="fmt-section" style="display:none;">
    <div class="row" style="margin-bottom:10px;">
      <h2 class="h2-flat">Formatted SQL</h2>
      <button class="ghost" id="copy-fmt">Copy</button>
    </div>
    <pre id="fmt-out" class="mt-1" style="white-space:pre-wrap;word-break:break-all;max-height:400px;overflow:auto;"></pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>The validator parses your SQL using a browser-native parser — <strong>no database connection required</strong>.</li>
    <li>Select the correct dialect: MySQL, PostgreSQL, SQLite, or SQL Server — each has slightly different syntax rules.</li>
    <li>Common errors caught: missing keywords, unclosed quotes, invalid column names, type mismatches, and more.</li>
    <li>All processing is local — your SQL is never sent to any server.</li>
  </ul>

  <h2>About SQL Validation</h2>
  <p class="text-muted">SQL validators use a parser to read your SQL statement and check it conforms to the grammar rules of your target database. Unlike running <code>EXPLAIN</code> or <code>DESCRIBE</code>, this works without a live database connection and catches purely syntactic errors — missing keywords, mismatched parentheses, invalid identifiers — before you even try to run it. Use this to quickly check a query before pasting it into your application code, or to learn SQL by seeing immediate feedback on mistakes.</p>
  <p class="text-muted">Note: a valid SQL statement doesn't mean the query is correct or efficient — check that your column and table names match your schema, that the logic does what you intend, and that you have appropriate indexes for any WHERE clauses. For performance, use <code>EXPLAIN</code> on a real database.</p>

  <h2>Supported Dialects</h2>
  <table class="mt-1" style="width:100%;border-collapse:collapse;font-size:.9rem;">
    <thead>
      <tr style="border-bottom:1px solid var(--border);">
        <th style="text-align:left;padding:6px 12px;">Dialect</th>
        <th style="text-align:left;padding:6px 12px;">Notes</th>
      </tr>
    </thead>
    <tbody>
      <tr style="border-bottom:1px solid var(--border);">
        <td style="padding:6px 12px;"><code>MySQL</code></td>
        <td style="padding:6px 12px;">USE, LIMIT variations, backtick identifiers</td>
      </tr>
      <tr style="border-bottom:1px solid var(--border);">
        <td style="padding:6px 12px;"><code>PostgreSQL</code></td>
        <td style="padding:6px 12px;">SERIAL, RETURNING, dollar-quoted strings, PSQL-specific syntax</td>
      </tr>
      <tr style="border-bottom:1px solid var(--border);">
        <td style="padding:6px 12px;"><code>SQLite</code></td>
        <td style="padding:6px 12px;">AUTOINCREMENT, affinity rules, limited ALTER TABLE support</td>
      </tr>
      <tr>
        <td style="padding:6px 12px;"><code>SQL Server</code></td>
        <td style="padding:6px 12px;">TOP vs LIMIT, nvarchar literals, square-bracket identifiers</td>
      </tr>
    </tbody>
  </table>
</BaseLayout>

<style>
  .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  textarea { min-height: 120px; }
  pre { min-height: 40px; overflow: auto; white-space: pre-wrap; word-break: break-all; }
  .mt-1 { margin-top: 10px; }
  .mt-2 { margin-top: 16px; }
  .icon-ok { color: var(--success); font-size: 1.2rem; margin-right: 6px; }
  .icon-err { color: var(--danger); font-size: 1.2rem; margin-right: 6px; }
  table { border: 1px solid var(--border); border-radius: var(--radius-sm); }
  th, td { border-bottom: 1px solid var(--border); }
  tr:last-child td { border-bottom: none; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  // Simple SQL tokenizer/validator for common cases
  // For a full validator, integrate sql.js or terse - keeping it client-side

  const KEYWORDS = new Set([
    'SELECT','FROM','WHERE','INSERT','INTO','VALUES','UPDATE','SET','DELETE',
    'CREATE','TABLE','ALTER','DROP','INDEX','VIEW','JOIN','LEFT','RIGHT','INNER','OUTER','ON',
    'AND','OR','NOT','IN','IS','NULL','LIKE','BETWEEN','EXISTS','CASE','WHEN','THEN','ELSE','END',
    'ORDER','BY','GROUP','HAVING','LIMIT','OFFSET','UNION','ALL','DISTINCT','AS','ASC','DESC',
    'PRIMARY','KEY','FOREIGN','REFERENCES','UNIQUE','CHECK','DEFAULT','AUTO_INCREMENT','SERIAL',
    'INTEGER','INT','VARCHAR','TEXT','BOOLEAN','FLOAT','DOUBLE','DECIMAL','DATE','TIMESTAMP',
    'DATETIME','BLOB','JSON','CONSTRAINT','IF','REPLACE','TRUNCATE','GRANT','REVOKE'
  ]);

  const DIALECT_QUIRKS = {
    mysql: {
     bad: ['SERIAL','RETURNING','::','NOW()','CURRENT_SCHEMA()'],
      note: 'MySQL uses AUTO_INCREMENT, backtick identifiers, and LIMIT without OFFSET in older versions.'
    },
    postgres: {
      bad: ['AUTO_INCREMENT','LIMIT 100 FOR UPDATE'],
      note: 'PostgreSQL uses SERIAL, RETURNING, and dollar-quoted strings. Use LIMIT ... OFFSET for pagination.'
    },
    sqlite: {
      bad: ['FOREIGN KEY REFERENCES','DROP COLUMN','RENAME COLUMN'],
      note: 'SQLite has limited ALTER TABLE support. Some syntax differs from other databases.'
    },
    sqlserver: {
      bad: ['LIMIT','SERIAL','NOW()'],
      note: 'SQL Server uses TOP(n) instead of LIMIT, square-bracket [] identifiers, and nvarchar strings.'
    }
  };

  function tokenize(sql) {
    const tokens = [];
    let i = 0;
    while (i < sql.length) {
      let c = sql[i];
      // Skip whitespace
      if (/\s/.test(c)) { i++; continue; }
      // String
      if (c === "'" || c === '"') {
        const q = c;
        let s = q;
        i++;
        while (i < sql.length) {
          if (sql[i] === q && sql[i-1] !== '\\') { s += q; i++; break; }
          s += sql[i++];
        }
        tokens.push({ type: 'string', value: s });
        continue;
      }
      // Comment
      if (c === '-' && sql[i+1] === '-') {
        let s = '';
        while (i < sql.length && sql[i] !== '\n') s += sql[i++];
        tokens.push({ type: 'comment', value: s });
        continue;
      }
      // Number
      if (/[0-9]/.test(c)) {
        let s = '';
        while (i < sql.length && /[0-9.]/.test(sql[i])) s += sql[i++];
        tokens.push({ type: 'number', value: s });
        continue;
      }
      // Word / keyword
      if (/[a-zA-Z_]/.test(c)) {
        let s = '';
        while (i < sql.length && /[a-zA-Z0-9_]/.test(sql[i])) s += sql[i++];
        tokens.push({ type: 'word', value: s, upper: s.toUpperCase() });
        continue;
      }
      // Symbol
      tokens.push({ type: 'symbol', value: c });
      i++;
    }
    return tokens;
  }

  function validate(sql, dialect) {
    const errors = [];
    const tokens = tokenize(sql);
    if (tokens.length === 0) {
      errors.push({ msg: 'Empty SQL statement.', line: 1, col: 1 });
      return errors;
    }

    // Check for obvious issues
    let parenDepth = 0;
    let inString = false;
    let stringChar = '';
    let line = 1, col = 0;
    let lastWord = null;

    for (let i = 0; i < tokens.length; i++) {
      const t = tokens[i];
      if (t.type === 'string') {
        inString = false;
        continue;
      }
      if (t.type === 'comment') { lastWord = null; continue; }

      if (t.type === 'symbol') {
        if (t.value === '(') parenDepth++;
        if (t.value === ')') parenDepth--;
        if (parenDepth < 0) {
          errors.push({ msg: 'Unexpected closing parenthesis ) without matching (.', line, col });
          parenDepth = 0;
        }
        lastWord = null;
      }

      if (t.type === 'word') {
        const u = t.upper;
        const isKw = KEYWORDS.has(u);
        lastWord = t;

        // Check dialect quirks
        const quirks = DIALECT_QUIRKS[dialect] || {};
        for (const bad of (quirks.bad || [])) {
          if (sql.includes(bad)) {
            errors.push({ msg: `Syntax not supported in ${dialect}: "${bad}"`, line, col });
          }
        }

        // Missing SELECT keyword before columns
        if (u === 'WHERE' && !tokens.slice(0,i).some(tk => tk.type === 'word' && tk.upper === 'SELECT')) {
          errors.push({ msg: 'WHERE without SELECT — statement must start with SELECT, INSERT, UPDATE, or DELETE.', line, col });
        }
        if (u === 'GROUP' && !tokens.slice(0,i).some(tk => tk.type === 'word' && tk.upper === 'SELECT')) {
          errors.push({ msg: 'GROUP BY without SELECT.', line, col });
        }
        if (u === 'ORDER' && !tokens.slice(0,i).some(tk => tk.type === 'word' && tk.upper === 'SELECT')) {
          errors.push({ msg: 'ORDER BY without SELECT.', line, col });
        }
      }

      // Track line/col
      if (t.value && t.value.includes('\n')) {
        line++;
        col = 0;
      } else {
        col += t.value ? t.value.length : 1;
      }
    }

    if (parenDepth > 0) {
      errors.push({ msg: `Unclosed parenthesis — ${parenDepth} opening parenthesis(es) not closed.`, line, col });
    }

    // Basic structural checks
    const firstKw = tokens.find(t => t.type === 'word' && KEYWORDS.has(t.upper));
    if (!firstKw) {
      errors.push({ msg: 'Statement must start with SELECT, INSERT, UPDATE, DELETE, CREATE, or ALTER.', line, col });
    }

    return errors;
  }

  function format(sql) {
    const kw = ['SELECT','FROM','WHERE','AND','OR','JOIN','LEFT JOIN','RIGHT JOIN','INNER JOIN','OUTER JOIN','ORDER BY','GROUP BY','HAVING','LIMIT','OFFSET','INSERT INTO','VALUES','UPDATE','SET','DELETE','CREATE TABLE','ALTER TABLE','DROP TABLE','UNION','ON'];
    let result = sql.trim();
    // Uppercase keywords
    for (const k of kw) {
      const re = new RegExp('\\b' + k + '\\b', 'gi');
      result = result.replace(re, k);
    }
    // Newlines before major keywords
    const breakBefore = ['SELECT','FROM','WHERE','AND','OR','ORDER BY','GROUP BY','HAVING','LIMIT','INSERT INTO','VALUES','UPDATE','SET','DELETE','JOIN','LEFT JOIN','RIGHT JOIN','INNER JOIN','UNION'];
    for (const k of breakBefore) {
      result = result.replace(new RegExp('\\s+' + k + '\\b', 'gi'), '\n' + k);
    }
    return result.split('\n').map(l => l.trim()).filter(l => l).join('\n');
  }

  $('validate-btn').addEventListener('click', () => {
    const sql = $('sql-input').value.trim();
    if (!sql) { showToast('Paste some SQL first.'); return; }
    const dialect = $('dialect').value;
    const errors = validate(sql, dialect);
    $('ok-section').style.display = 'none';
    $('err-section').style.display = 'none';
    $('fmt-section').style.display = 'none';

    if (errors.length === 0) {
      $('ok-msg').textContent = `Valid ${dialect} SQL — no syntax errors found.`;
      $('ok-section').style.display = 'block';
    } else {
      const lines = errors.map(e => `• Line ${e.line}: ${e.msg}`).join('\n');
      $('err-out').textContent = lines;
      const quirks = DIALECT_QUIRKS[dialect];
      $('err-advice').textContent = quirks ? quirks.note : '';
      $('err-section').style.display = 'block';
    }
  });

  $('format-btn').addEventListener('click', () => {
    const sql = $('sql-input').value.trim();
    if (!sql) { showToast('Paste some SQL first.'); return; }
    $('fmt-out').textContent = format(sql);
    $('fmt-section').style.display = 'block';
    $('ok-section').style.display = 'none';
    $('err-section').style.display = 'none';
  });

  $('clear-btn').addEventListener('click', () => {
    $('sql-input').value = '';
    ['ok-section','err-section','fmt-section'].forEach(id => {
      $(id).style.display = 'none';
    });
  });
})();
</script>
