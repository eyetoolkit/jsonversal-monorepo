---
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'Base64 Image Viewer';
const description = 'Convert a base64 data URI into a viewable, downloadable image — or turn an image file on disk into a base64 data URI. Detects PNG, JPEG, GIF, WebP and SVG automatically. Runs entirely in your browser.';
---

<BaseLayout
  site="codegen"
  title={title}
  description={description}
  canonical="https://jsonversal.com/codegen/tools/base64-image/"
  keywords={['base64 image', 'data uri', 'image to base64', 'base64 decode', 'image viewer']}
  current="/codegen/tools/"
>
  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-2">
    <h2 class="h2-card">Mode</h2>
    <select id="mode" aria-label="Mode">
      <option value="decode">Base64 → Image</option>
      <option value="encode">Image → Base64</option>
    </select>
  </section>

  <section class="card mt-2" id="decode-section">
    <h2 class="h2-card">Base64 data</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" spellcheck="false" placeholder="data:image/png;base64,iVBORw0KGgo..."></textarea>
    <div class="row mt-1">
      <button class="primary" id="gen">Preview</button>
      <button class="ghost" id="sample">Load sample</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="encode-section" style="display:none;">
    <h2 class="h2-card">Image file</h2>
    <div class="row mt-1">
      <label for="file" class="sr-only">Base64 data</label> <input type="file" id="file" accept="image/*" />
      <button class="ghost" id="clear-file">Clear</button>
    </div>
    <textarea id="data-uri" class="mt-1" readonly spellcheck="false" placeholder="The data URI will appear here after you pick a file."></textarea>
  </section>

  <section class="card mt-2" id="out-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">Preview</h2>
      <div class="row" style="gap:8px;">
        <span class="text-dim" id="meta" style="font-size:.85rem;"></span>
        <button class="ghost" id="download">Download</button>
        <button class="ghost" id="copy">Copy data URI</button>
      </div>
    </div>
    <div id="preview-box" class="mt-1" style="border:1px solid var(--border);border-radius:8px;padding:16px;text-align:center;background:repeating-conic-gradient(#f2f2f2 0 25%, #ffffff 0 50%) 0 0 / 16px 16px;">
      <img id="preview" alt="Base64 image preview" style="max-width:100%;max-height:320px;" />
    </div>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <h2 class="h2-error">Error</h2>
    <pre id="err-out" class="mt-1" style="color:var(--danger);">—</pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Base64 → Image: accepts a full <code>data:</code> URI or raw base64. The MIME type comes from the URI prefix, or is sniffed from the magic bytes when missing (PNG <code>iVBORw0KGgo=</code>, JPEG <code>/9j/</code>, GIF <code>R0lGOD</code>, WebP <code>UklGR</code>, SVG <code>PHN2Zw==</code>).</li>
    <li>Size is computed from the base64 length (<code>length × 3/4</code> minus padding), so you get the decoded byte count without downloading anything.</li>
    <li>The Download button rebuilds the original bytes into a Blob and saves it with the right file extension.</li>
    <li>Image → Base64: pick a local file and it is read with <code>FileReader.readAsDataURL</code> — the result is shown as a text data URI ready to copy.</li>
    <li>Everything runs locally; no image data is ever uploaded.</li>
  </ul>

  <h2>About Base64 Image Viewer</h2>
  <p class="text-muted">Base64-encoded images show up everywhere — email HTML, CSS backgrounds, API payloads, JSON fixtures — and while they are easy to generate, they are hard to inspect: you cannot tell the format, the real size, or whether the payload is even valid just by looking at the string. This viewer decodes the payload in memory, reports the detected type and byte size, renders the actual image, and lets you download the original file again.</p>
  <p class="text-muted">The reverse direction is just as useful: when you need an image inline — a placeholder, a test fixture, or an attachment payload — pick the file and copy the generated data URI. The tool detects invalid base64, flags PDFs and other non-image payloads, and handles SVG as text so it works with the browser&rsquo;s built-in encoding APIs without any external libraries.</p>
</BaseLayout>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  textarea { min-height: 140px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .875rem; }
  pre { min-height: 40px; max-height: 200px; overflow: auto; white-space: pre-wrap; word-break: break-word; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  const PNG_1x1 = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==';

  let lastDataUri = null;

  function formatBytes(n) {
    if (n < 1024) return n + ' B';
    if (n < 1048576) return (n / 1024).toFixed(1) + ' KB';
    return (n / 1048576).toFixed(1) + ' MB';
  }

  function b64FromText(s) {
    const bytes = new TextEncoder().encode(s);
    let bin = '';
    for (const b of bytes) bin += String.fromCharCode(b);
    return btoa(bin);
  }

  function byteSize(b64) {
    return Math.floor(b64.length * 3 / 4) - (b64.endsWith('==') ? 2 : b64.endsWith('=') ? 1 : 0);
  }

  function sniffMime(b64) {
    if (b64.indexOf('iVBORw0KGgo') === 0) return 'image/png';
    if (b64.indexOf('/9j/') === 0) return 'image/jpeg';
    if (b64.indexOf('R0lGOD') === 0) return 'image/gif';
    if (b64.indexOf('UklGR') === 0) return 'image/webp';
    if (b64.indexOf('PHN2Zy') === 0) return 'image/svg+xml';
    if (b64.indexOf('JVBERi') === 0) return 'application/pdf';
    if (b64.indexOf('<svg') === 0) return 'image/svg+xml';
    return null;
  }

  function analyze(rawInput) {
    const input = String(rawInput).trim();
    if (!input) throw new Error('Paste some base64 data first.');

    let mime = null;
    let b64 = input;

    // data URI prefix?
    const m = /^data:([^;,]+)(;[^,]*,)(.*)$/s.exec(input);
    if (m) {
      if (m[2].indexOf(';base64') === -1) {
        throw new Error('Only base64-encoded data URIs are supported (data:&lt;mime&gt;;base64,...).');
      }
      mime = m[1];
      b64 = m[3];
    }

    b64 = b64.replace(/\s+/g, '');

    if (mime === null && /^<svg[\s>]/i.test(input)) {
      mime = 'image/svg+xml';
      b64 = b64FromText(input);
    }

    if (!b64) throw new Error('Empty input.');
    if (!/^[A-Za-z0-9+/]+={0,2}$/.test(b64) || b64.length % 4 !== 0) {
      throw new Error('Input is not valid base64. Check the string and try again.');
    }
    if (mime === null) {
      mime = sniffMime(b64);
      if (mime === null) {
        throw new Error('Could not detect the image type. Use a full data URI like data:image/png;base64,... so the MIME type is explicit.');
      }
    }
    if (mime === 'application/pdf') {
      throw new Error('That payload is a PDF (application/pdf), not an image. This tool only handles images.');
    }
    if (mime.indexOf('image/') !== 0) {
      throw new Error('Unsupported MIME type: ' + mime + '. Expected an image/* type.');
    }
    return { mime, b64, bytes: byteSize(b64), dataUri: 'data:' + mime + ';base64,' + b64 };
  }

  function showPreview(res) {
    $('preview').src = res.dataUri;
    $('meta').textContent = res.mime + ' · ' + formatBytes(res.bytes);
    $('out-section').style.display = 'block';
    $('err-section').style.display = 'none';
    lastDataUri = res.dataUri;
  }

  function showError(msg) {
    $('err-out').textContent = msg;
    $('err-section').style.display = 'block';
    $('out-section').style.display = 'none';
  }

  $('mode').addEventListener('change', () => {
    const enc = $('mode').value === 'encode';
    $('decode-section').style.display = enc ? 'none' : 'block';
    $('encode-section').style.display = enc ? 'block' : 'none';
    $('out-section').style.display = 'none';
    $('err-section').style.display = 'none';
  });

  $('gen').addEventListener('click', () => {
    $('err-section').style.display = 'none';
    try {
      showPreview(analyze($('input').value));
    } catch (e) {
      showError(e.message);
    }
  });

  $('sample').addEventListener('click', () => {
    $('input').value = PNG_1x1;
    $('gen').click();
  });

  $('clear').addEventListener('click', () => {
    $('input').value = '';
    $('out-section').style.display = 'none';
    $('err-section').style.display = 'none';
  });

  $('clear-file').addEventListener('click', () => {
    $('file').value = '';
    $('data-uri').value = '';
    $('out-section').style.display = 'none';
    $('err-section').style.display = 'none';
  });

  $('file').addEventListener('change', () => {
    const f = $('file').files[0];
    $('err-section').style.display = 'none';
    if (!f) return;
    if (f.type.indexOf('image/') !== 0) {
      showError('Please choose an image file (PNG, JPEG, GIF, WebP or SVG).');
      return;
    }
    const reader = new FileReader();
    reader.onload = () => {
      const uri = String(reader.result);
      const b64 = uri.split(',')[1] || '';
      $('data-uri').value = uri;
      $('preview').src = uri;
      $('meta').textContent = (f.type || 'image') + ' · ' + formatBytes(f.size) + ' · ' + formatBytes(byteSize(b64)) + ' (base64)';
      $('out-section').style.display = 'block';
      lastDataUri = uri;
    };
    reader.onerror = () => showError('Could not read the file.');
    reader.readAsDataURL(f);
  });

  $('download').addEventListener('click', () => {
    if (!lastDataUri) return;
    const m = /^data:([^;,]+);base64,(.*)$/s.exec(lastDataUri);
    if (!m) return;
    const mime = m[1];
    const bin = atob(m[2]);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    const blob = new Blob([bytes], { type: mime });
    const ext = { 'image/png': 'png', 'image/jpeg': 'jpg', 'image/gif': 'gif', 'image/webp': 'webp', 'image/svg+xml': 'svg' }[mime] || 'bin';
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'image-' + Date.now() + '.' + ext;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  $('copy').addEventListener('click', async () => {
    if (!lastDataUri) return;
    try {
      await navigator.clipboard.writeText(lastDataUri);
      $('copy').textContent = 'Copied!';
      setTimeout(() => { $('copy').textContent = 'Copy data URI'; }, 1200);
    } catch {}
  });
})();
</script>
