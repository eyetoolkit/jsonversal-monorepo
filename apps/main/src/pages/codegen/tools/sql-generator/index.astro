---
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'JSON to SQL Generator';
const description = 'Generate CREATE TABLE and INSERT statements from a JSON array. Infers column types and safely escapes string values. Runs entirely in your browser.';
const faqs = [
  {
    "question": "How do I generate SQL from natural language?",
    "answer": "Describe what you want in plain English (e.g. 'list all users who signed up in the last 30 days with more than 5 orders') and click Generate. The tool produces a SQL query for your selected dialect."
  },
  {
    "question": "Which SQL dialects are supported?",
    "answer": "MySQL, PostgreSQL, SQLite, and SQL Server are supported. The generated SQL is tailored to the selected dialect's syntax and feature set."
  }
];
---

<BaseLayout
  site="codegen"
  title={title}
  description={description}
  canonical="https://jsonversal.com/codegen/tools/sql-generator/"
  keywords={['JSON to SQL generator', 'generate SQL from JSON', 'JSON to INSERT', 'SQL from JSON', 'JSON SQL converter', 'sql-generator', 'sql-generator']}
  current="/codegen/tools/sql-generator/"
  faqs={faqs}
>
  <ToolNav currentHref={Astro.url.pathname} />

  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-2">
    <h2 class="h2-card">JSON array</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" aria-label="JSON array" spellcheck="false">[
  &#123; "id": 1, "name": "Ada Lovelace", "email": "ada@example.com", "active": true, "score": 98.5 &#125;,
  &#123; "id": 2, "name": "Grace Hopper", "email": "grace@example.com", "active": false, "score": 99.9 &#125;
]</textarea>
    <div class="row mt-1">
      <label class="text-muted" for="table">Table name</label>
      <label for="table" class="sr-only">JSON array</label> <input id="table" type="text" value="users" style="max-width:160px;" spellcheck="false" />
      <label class="text-muted" for="dialect">Dialect</label>
      <label for="dialect" class="sr-only">Dialect</label> <select id="dialect">
        <option value="mysql">MySQL</option>
        <option value="sqlite">SQLite</option>
        <option value="postgres">PostgreSQL</option>
      </select>
      <button class="primary" id="gen">Generate SQL</button>
    </div>
  </section>

  <section class="card mt-2" id="out-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">SQL</h2>
      <div class="row" style="gap:8px;">
        <span class="text-dim" id="meta" style="font-size:.85rem;"></span>
        <button class="ghost" id="copy">Copy</button>
      </div>
    </div>
    <pre id="output" class="mt-1">—</pre>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <h2 class="h2-error">Error</h2>
    <pre id="err-out" class="mt-1" style="color:var(--danger);">—</pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Paste a JSON array of objects — keys become columns, and types are inferred across all rows (integer → <code>INTEGER</code>, float → <code>REAL</code>/<code>DOUBLE</code>, string → <code>TEXT</code>/<code>VARCHAR</code>, boolean → <code>BOOLEAN</code>).</li>
    <li>Nested objects/arrays become <code>TEXT</code> columns holding the JSON-encoded value.</li>
    <li>String values are escaped by doubling single quotes; booleans become <code>TRUE</code>/<code>FALSE</code>.</li>
    <li>Missing keys are emitted as <code>NULL</code>, so every row has the same column set.</li>
  </ul>

  <h2>About JSON to SQL Generator</h2>
  <p class="text-muted">When you receive data as JSON — an export, an API response, a fixture — but need it in a relational database, writing the DDL and INSERT statements by hand is tedious and error-prone. This tool derives the table structure from the data itself: every key becomes a column, and the type for each column is decided by looking at the values across all rows, so one stray string doesn&rsquo;t make the whole column TEXT.</p>
  <p class="text-muted">The generated statements target common dialects (MySQL, SQLite, PostgreSQL) and are safe to run: identifiers are validated, string literals are single-quote-escaped, and NULLs are explicit. This is a great way to seed test databases, convert spreadsheet-derived JSON, or move fixture data into SQL. For production use, review the column widths and add primary keys, constraints, and indexes — this tool focuses on getting the data in.</p>
</BaseLayout>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  textarea { min-height: 200px; }
  pre { min-height: 80px; max-height: 520px; overflow: auto; white-space: pre-wrap; word-break: break-word; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  function escSql(s) {
    return String(s).replace(/'/g, "''");
  }

  function inferType(values, dialect) {
    let hasNum = false, hasFloat = false, hasStr = false, hasBool = false, allNull = true;
    for (const v of values) {
      if (v === null || v === undefined) continue;
      allNull = false;
      if (typeof v === 'number') { hasNum = true; if (!Number.isInteger(v)) hasFloat = true; }
      else if (typeof v === 'boolean') hasBool = true;
      else hasStr = true;
    }
    if (allNull) return dialect === 'postgres' ? 'TEXT' : 'TEXT';
    if (hasStr) return dialect === 'mysql' ? 'VARCHAR(255)' : 'TEXT';
    if (hasBool) return 'BOOLEAN';
    if (hasFloat) return dialect === 'sqlite' ? 'REAL' : 'DOUBLE';
    if (hasNum) return 'INTEGER';
    return 'TEXT';
  }

  function lit(v, dialect) {
    if (v === null || v === undefined) return 'NULL';
    if (typeof v === 'number') return String(v);
    if (typeof v === 'boolean') return v ? 'TRUE' : 'FALSE';
    if (typeof v === 'object') return "'" + escSql(JSON.stringify(v)) + "'";
    return "'" + escSql(v) + "'";
  }

  function quoteId(name, dialect) {
    const c = dialect === 'mysql' ? '`' : '"';
    return c + String(name).replace(/[^a-zA-Z0-9_]/g, '_') + c;
  }

  $('gen').addEventListener('click', () => {
    const raw = $('input').value.trim();
    $('err-section').style.display = 'none';
    if (!raw) { showToast('Paste a JSON array first.'); return; }
    try {
      const data = JSON.parse(raw);
      if (!Array.isArray(data) || !data.length) throw new Error('Input must be a non-empty JSON array of objects.');
      const table = $('table').value.trim() || 'table';
      const dialect = $('dialect').value;
      const columns = [];
      for (const row of data) {
        if (row && typeof row === 'object' && !Array.isArray(row)) {
          for (const k of Object.keys(row)) {
            if (!columns.includes(k)) columns.push(k);
          }
        }
      }
      if (!columns.length) throw new Error('No object keys found.');

      const types = {};
      for (const col of columns) {
        types[col] = inferType(data.map(r => r && typeof r === 'object' ? r[col] : undefined), dialect);
      }

      const out = [];
      out.push(`CREATE TABLE ${quoteId(table, dialect)} (`);
      out.push(columns.map(c => `  ${quoteId(c, dialect)} ${types[c]}`).join(',\n'));
      out.push(');');
      out.push('');
      for (const row of data) {
        const vals = columns.map(c => {
          const v = row && typeof row === 'object' ? row[c] : undefined;
          return lit(v, dialect);
        });
        out.push(`INSERT INTO ${quoteId(table, dialect)} (${columns.map(c => quoteId(c, dialect)).join(', ')}) VALUES (${vals.join(', ')});`);
      }
      $('output').textContent = out.join('\n');
      $('meta').textContent = `${data.length} rows · ${columns.length} columns`;
      $('out-section').style.display = 'block';
    } catch (e) {
      $('err-out').textContent = e.message;
      $('err-section').style.display = 'block';
      $('out-section').style.display = 'none';
    }
  });

  $('copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText($('output').textContent);
      $('copy').textContent = 'Copied!';
      setTimeout(() => { $('copy').textContent = 'Copy'; }, 1200);
    } catch {}
  });
})();
</script>
