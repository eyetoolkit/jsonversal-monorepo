---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolCard from '@versal/ui/ToolCard.astro';

const tools = [
  {
    title: 'LLM Token & Pricing Calculator',
    description: 'Estimate tokens and cost across GPT, Claude, Llama and Gemini.',
    href: '/tools/llm-token-calculator/',
    status: 'live' as const,
  },
  {
    title: 'Structured Output JSON Schema Generator',
    description: 'Create strict JSON Schema for LLM structured output.',
    href: '/tools/json-schema-generator/',
    status: 'live' as const,
  },
  {
    title: 'JSON Schema Sample Data Generator',
    description: 'Generate sample JSON that satisfies your schema — mock data in seconds.',
    href: '/tools/json-schema-sample-generator/',
    status: 'live' as const,
  },
  {
    title: 'JSON to Pydantic Model',
    description: 'Generate Pydantic v2 BaseModel classes from a JSON sample.',
    href: '/tools/json-to-pydantic/',
    status: 'live' as const,
  },
  {
    title: 'JSON to Zod Schema',
    description: 'Infer a Zod validation schema from a JSON sample.',
    href: '/tools/json-to-zod/',
    status: 'live' as const,
  },
  {
    title: 'JSON to TypeScript Interface',
    description: 'Generate type-safe TypeScript interfaces from JSON.',
    href: '/tools/json-to-typescript/',
    status: 'live' as const,
  },
  {
    title: 'JSONPath Tester',
    description: 'Test JSONPath expressions against your JSON and see every match.',
    href: '/tools/jsonpath-tester/',
    status: 'live' as const,
  },
  {
    title: 'JSON Diff',
    description: 'Compare two JSON documents and list every added, removed, changed value.',
    href: '/tools/json-diff/',
    status: 'live' as const,
  },
  {
    title: 'JSON Formatter & Validator',
    description: 'Pretty-print, validate, and minify JSON — with error line/column hints and document stats.',
    href: '/tools/json-formatter/',
    status: 'live' as const,
  },
  {
    title: 'JSON to Go Struct',
    description: 'Generate Go structs with json tags from a JSON sample.',
    href: '/tools/json-to-go/',
    status: 'live' as const,
  },
  {
    title: 'JSON to C# Class',
    description: 'Generate C# POCO classes with Newtonsoft attributes from JSON.',
    href: '/tools/json-to-csharp/',
    status: 'live' as const,
  },
  {
    title: 'UUID v7 Generator & Timestamp Decoder',
    description: 'Generate RFC 9562 UUID v7 in bulk and decode the embedded timestamp.',
    href: '/tools/uuid-v7/',
    status: 'live' as const,
  },
  {
    title: 'Markdown Editor & Live Preview',
    description: 'Write Markdown and watch the HTML preview render as you type — safely.',
    href: '/tools/markdown-preview/',
    status: 'live' as const,
  },
  {
    title: 'Text Diff',
    description: 'Compare two texts with side-by-side and git-style unified diff output.',
    href: '/tools/text-diff/',
    status: 'live' as const,
  },
  {
    title: 'JSON Escape & Unescape',
    description: 'Escape plain text into a JSON string literal and decode escaped literals.',
    href: '/tools/json-escape/',
    status: 'live' as const,
  },
  {
    title: 'JSON Sorter & Deduper',
    description: 'Sort object keys and arrays, dedupe items, and pretty-print with stats.',
    href: '/tools/json-sorter/',
    status: 'live' as const,
  },
];
---

<BaseLayout site="main" current="/">
  <h1>JSON & LLM developer tools that run in your browser.</h1>
  <p class="text-muted">
    No signup, no upload, no accounts. Every tool on jsonversal runs 100% on your device — paste JSON, infer schemas, count LLM tokens, and estimate API costs without your data ever leaving your browser.
  </p>

  <h2>Tools</h2>
  <div class="grid">
    {tools.map(tool => (
      <ToolCard {...tool} />
    ))}
  </div>

  <h2>More from the jsonversal brand matrix</h2>
  <div class="grid">
    <ToolCard
      title="DevOps Tools (devops)"
      description="YAML/JSON converter, Base64, crontab, JWT decoder, regex tester."
      href="/devops/"
    />
    <ToolCard
      title="Code Generators (codegen)"
      description=".gitignore, license, README, CI workflow, commit message."
      href="/codegen/"
    />
    <ToolCard
      title="Security Tools (sec)"
      description="Hash, AES encryption, password strength, CSP generator, CSR decoder."
      href="/sec/"
    />
  </div>
</BaseLayout>