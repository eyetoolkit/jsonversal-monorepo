<script is:inline>
(function(){
  var KEY='versal-theme';
  var saved=localStorage.getItem(KEY);
  if(saved) document.body.setAttribute('data-theme',saved);
  var btn=document.getElementById('vTheme');
  if(btn){btn.addEventListener('click',function(){var cur=document.body.getAttribute('data-theme')==='dark'?'light':'dark';document.body.setAttribute('data-theme',cur);localStorage.setItem(KEY,cur);});}
  var ji=document.getElementById('jin'),jo=document.getElementById('jout');
  function recalc(){
    try{
      var o=JSON.parse(ji.value);
      var keys=function sortKeys(x){if(Array.isArray(x))return x.map(sortKeys);if(x&&typeof x==='object'){var r={};Object.keys(x).sort().forEach(function(k){r[k]=sortKeys(x[k])});return r;}return x;}(o);
      jo.value=JSON.stringify(keys,null,2);
      document.getElementById('demoResult').innerHTML='Valid JSON · '+(JSON.stringify(o).length)+' bytes · sorted &amp; pretty<small>strict parser · line/column error reporting</small>';
    }catch(e){
      jo.value='// '+e.message;
    }
  }
  ji.addEventListener('input',recalc); recalc();
})();
</script>
