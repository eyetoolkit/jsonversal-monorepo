---
import BaseLayout from '@versal/ui/BaseLayout';
import Hero from '@versal/ui/Hero.astro';
import ToolGrid from '@versal/ui/ToolGrid.astro';
import ToolCard from '@versal/ui/ToolCard.astro';

const tools = [
  {
    title: 'LLM Token & Pricing Calculator',
    description: 'Estimate tokens and cost across GPT, Claude, Llama and Gemini.',
    href: '/tools/llm-token-calculator/',
    status: 'live' as const,
  },
  {
    title: 'Structured Output JSON Schema Generator',
    description: 'Create strict JSON Schema for LLM structured output.',
    href: '/tools/json-schema-generator/',
    status: 'live' as const,
  },
  {
    title: 'JSON Schema Sample Data Generator',
    description: 'Generate sample JSON that satisfies your schema — mock data in seconds.',
    href: '/tools/json-schema-sample-generator/',
    status: 'live' as const,
  },
  {
    title: 'JSON to Pydantic Model',
    description: 'Generate Pydantic v2 BaseModel classes from a JSON sample.',
    href: '/tools/json-to-pydantic/',
    status: 'live' as const,
  },
  {
    title: 'JSON to Zod Schema',
    description: 'Infer a Zod validation schema from a JSON sample.',
    href: '/tools/json-to-zod/',
    status: 'live' as const,
  },
  {
    title: 'JSON Formatter & Validator',
    description: 'Pretty-print, validate, and minify JSON with configurable indentation.',
    href: '/tools/json-formatter/',
    status: 'live' as const,
  },
  {
    title: 'JSON to TypeScript Interface',
    description: 'Convert JSON to TypeScript types and interfaces instantly.',
    href: '/tools/json-to-typescript/',
    status: 'live' as const,
  },
  {
    title: 'JSON to Go Struct',
    description: 'Generate Go struct types from JSON with json tags.',
    href: '/tools/json-to-go/',
    status: 'live' as const,
  },
  {
    title: 'JSON to C# Class',
    description: 'Generate C# POCO classes from any JSON sample.',
    href: '/tools/json-to-csharp/',
    status: 'live' as const,
  },
  {
    title: 'JSON Diff',
    description: 'Compare two JSON documents and see the differences instantly.',
    href: '/tools/json-diff/',
    status: 'live' as const,
  },
  {
    title: 'UUID v7 Generator & Timestamp Decoder',
    description: 'Generate RFC 9562 UUID v4 and v7 identifiers. Validate any UUID.',
    href: '/tools/uuid-v7/',
    status: 'live' as const,
  },
];

const faqs = [
  {
    question: 'Is my data sent to a server?',
    answer: 'No. Every tool on jsonversal runs entirely in your browser using the Web Crypto API, File API, and Clipboard API. Nothing is ever uploaded — not even the JSON you paste in.',
  },
  {
    question: 'Do I need to create an account?',
    answer: 'No account, no email, no API key. All tools are free to use with no signup required.',
  },
  {
    question: 'What happens to my data after I close the page?',
    answer: 'Nothing. Your input is processed in-memory and discarded when you navigate away or close the tab. There is no server-side storage.',
  },
  {
    question: 'Can I use these tools offline?',
    answer: 'Yes. Once the page loads, all tools work offline. There are no external API calls or CDN dependencies at runtime.',
  },
  {
    question: 'Which JSON Schema specification is supported?',
    answer: 'JSON Schema draft-07, draft-2019-09, and draft-2020-12 are supported for both validation and generation.',
  },
];
---

<BaseLayout site="main" current="/" title="Free Browser-Based Developer Tools" description="Free browser-based JSON & LLM developer tools. JSON to Zod, JSON Schema, LLM token calculator, JSON to TypeScript. No signup, no upload — your data never leaves your device." keywords={["JSON formatter","JSON validator","JSON to Zod","LLM token calculator","developer tools","structured output","JSON Schema generator"]} faqs={faqs}>
  <Hero
    overline="jsonversal — free in-browser toolkit"
    sub="No signup, no upload, no accounts. Every tool runs 100% on your device — paste JSON, infer schemas, count LLM tokens, and estimate API costs without your data ever leaving your browser."
  >
    JSON &amp; LLM developer tools that <span class="grad">run in your browser.</span>
    <Fragment slot="actions">
      <a class="button button-primary" href="/tools/">Explore 69 tools</a>
      <a class="button button-ghost" href="/tools/json-schema-generator/">Try JSON Schema Generator</a>
    </Fragment>
    <Fragment slot="chips">
      <span class="chip"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg><strong>100% local</strong> — nothing uploaded</span>
      <span class="chip"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><strong>0 sign-up</strong> — no accounts</span>
      <span class="chip"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg><strong>Free &amp; unlimited</strong> — for devs</span>
    </Fragment>
  </Hero>

  <div class="section-head">
    <span class="overline">Core toolkit</span>
    <h2>JSON &amp; LLM tools</h2>
    <p>Format, validate, transform and generate JSON — plus LLM token counting, schema generation and structured output helpers.</p>
  </div>
  <ToolGrid tools={tools} />

  <div class="section-head">
    <span class="overline">Why local-first</span>
    <h2>Your data never leaves your browser — GDPR-friendly by design</h2>
    <p>
      Most online tools upload your input, process it on a server and hand something back.
      jsonversal does the opposite: every tool is a self-contained page that runs on your device.
      There is no upload step, no queue, and no server-side copy — and no third-party CDN
      watching you load it.
    </p>
  </div>
  <div class="grid">
    <article class="card value-card">
      <span class="value-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
          <path d="m9 12 2 2 4-4" />
        </svg>
      </span>
      <h3>Nothing is uploaded</h3>
      <p>
        Tools run on the Web Crypto, File and Clipboard APIs inside your tab. Paste a JWT,
        a private key or a customer payload — it is never sent anywhere, so there is no
        server-side log to leak and nothing to delete.
      </p>
    </article>

    <article class="card value-card">
      <span class="value-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3c2.6 3.2 2.6 14.8 0 18M12 3c-2.6 3.2-2.6 14.8 0 18" />
        </svg>
      </span>
      <h3>No third-party CDNs</h3>
      <p>
        Fonts and libraries are served from this domain. Loading them from someone else's CDN
        would hand that provider your IP address on every page load — which is exactly the
        transfer European courts have ruled against.
      </p>
    </article>

    <article class="card value-card">
      <span class="value-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
          <circle cx="9" cy="7" r="4" />
          <path d="m17 11 2 2 4-4" />
        </svg>
      </span>
      <h3>No accounts, no profiling</h3>
      <p>
        No sign-up, no ad networks, no cross-site tracking — and no analytics at all.
        We do not count page views, so there is no visitor profile to build and
        no data to sell.
      </p>
    </article>
  </div>

  <div class="brand-strip">
    <h2>More developer toolkits</h2>
    <div class="grid">
      <ToolCard
        title="DevOps Tools"
        description="YAML/JSON converter, Base64, crontab, JWT decoder, regex tester and more."
        href="/devops/"
      />
      <ToolCard
        title="Code Generators"
        description=".gitignore, license, README, CI workflow, commit message and more."
        href="/codegen/"
      />
      <ToolCard
        title="Security Tools"
        description="Hash, AES encryption, password strength, CSP generator, CSR decoder."
        href="/sec/"
      />
    </div>
  </div>
</BaseLayout>

<style>
  .value-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .value-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--accent-soft);
    color: var(--accent-text);
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
  }
  .value-card h3 { margin: 4px 0 0; }
  .value-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: .92rem;
    line-height: 1.6;
  }
</style>
