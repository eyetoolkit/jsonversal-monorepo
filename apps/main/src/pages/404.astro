---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolCard from '@versal/ui/ToolCard.astro';
import { allTools } from '@versal/config/all-tools';
const toolCount = allTools.length;

const sections = [
  {
    title: 'JSON / LLM Tools',
    description: 'Format, validate, diff and transform JSON — plus token counting and schema generation.',
    href: '/tools/',
  },
  {
    title: 'Security Tools',
    description: 'Hashing, AES encryption, password strength, TOTP, JWT inspecting and more.',
    href: '/sec/',
  },
  {
    title: 'DevOps Tools',
    description: 'YAML/JSON converter, Base64, crontab, JWT decoder, regex tester and more.',
    href: '/devops/',
  },
  {
    title: 'Code Generators',
    description: '.gitignore, license, README, CI workflow, commit message and more.',
    href: '/codegen/',
  },
];
---
<BaseLayout site="main">
<section class="nf">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>We couldn&rsquo;t find that page</h1>
    <p class="nf-lead">
      The address may be mistyped, or the page may have moved. Nothing is lost — every tool on
      this site runs inside your browser, so there was never a server-side copy of your work.
    </p>
    <div class="nf-actions">
      <a class="button button-primary" href="/tools/">Browse all {toolCount} tools</a>
      <a class="button button-ghost" href="/">Back to homepage</a>
    </div>
  </div>

  <div class="section-head">
    <span class="overline">Pick a section</span>
    <h2>Jump to a toolkit</h2>
    <p>{toolCount} tools across four areas — all free, no signup, no upload.</p>
  </div>
  <div class="grid">
    {sections.map(s => <ToolCard title={s.title} description={s.description} href={s.href} />)}
  </div>
</BaseLayout>

<style>
  .nf { text-align: center; padding: 72px 0 56px; max-width: 640px; margin: 0 auto; }
  .nf-code { margin: 0; font-family: var(--font-mono, ui-monospace, Menlo, Consolas, monospace); font-size: clamp(64px, 14vw, 128px); font-weight: 800; line-height: 1; letter-spacing: -.04em; background: var(--accent-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nf h1 { margin: 20px 0 0; font-size: clamp(1.5rem, 4vw, 2.25rem); }
  .nf-lead { margin: 14px 0 0; color: var(--text-muted); font-size: 1.05rem; line-height: 1.65; }
  .nf-actions { margin-top: 28px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .button { padding: 12px 24px; border-radius: 10px; font-weight: 600; font-size: 0.95rem; text-decoration: none; transition: transform .06s ease, box-shadow .15s ease; }
  .button:active { transform: translateY(1px); }
  .button-primary { background: var(--accent-gradient); color: #fff; box-shadow: 0 6px 20px rgba(99,102,241,.3); }
  .button-ghost { border: 1px solid var(--line); color: var(--accent); background: transparent; }
  .section-head { text-align: center; margin: 48px 0 24px; }
  .overline { text-transform: uppercase; letter-spacing: .14em; font-size: .75rem; color: var(--muted); font-weight: 600; }
  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
</style>