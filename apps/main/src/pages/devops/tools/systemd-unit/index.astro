---
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'Systemd Unit Generator';
const description = 'Build a valid systemd unit file — environment, restart policy, hardening, network wait — and enable it with one command. Runs entirely in your browser.';
---

<BaseLayout
  site="devops"
  title={title}
  description={description}
  canonical="https://jsonversal.com/devops/tools/systemd-unit/"
  keywords={['systemd unit generator', 'service file', 'systemctl', 'hardening', 'unit file']}
  current="/devops/tools/"
>
  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-2">
    <h2 class="h2-card">Unit</h2>
    <div class="row">
      <label class="text-muted" for="unit-name">Unit name</label>
      <input id="unit-name" type="text" value="myapp" style="max-width:180px;" />
      <label class="text-muted" for="description">Description</label>
      <label for="description" class="sr-only">Unit</label> <input id="description" type="text" value="My application service" style="max-width:280px;" />
    </div>
    <div class="row mt-2">
      <label class="text-muted" for="exec-start">ExecStart</label>
      <input id="exec-start" type="text" value="/usr/bin/node /srv/myapp/server.js" style="max-width:380px;" />
    </div>
    <div class="row mt-2">
      <label class="text-muted" for="workdir">WorkingDirectory</label>
      <label for="workdir" class="sr-only">Workdir</label> <input id="workdir" type="text" value="/srv/myapp" style="max-width:220px;" />
      <label class="text-muted" for="user">User</label>
      <label for="user" class="sr-only">User</label> <input id="user" type="text" value="myapp" style="max-width:140px;" />
      <label class="text-muted" for="group">Group</label>
      <label for="group" class="sr-only">Group</label> <input id="group" type="text" value="myapp" style="max-width:140px;" />
    </div>
    <div class="row mt-2">
      <label class="text-muted" for="restart">Restart</label>
      <label for="restart" class="sr-only">Restart</label> <select id="restart" style="max-width:160px;">
        <option value="no">no</option>
        <option value="on-failure" selected>on-failure</option>
        <option value="always">always</option>
        <option value="on-abnormal">on-abnormal</option>
      </select>
      <label class="text-muted" for="restart-sec">RestartSec</label>
      <input id="restart-sec" type="number" min="0" value="5" style="max-width:80px;" />
    </div>
    <div class="mt-2">
      <label class="text-muted" for="env">Environment (one KEY=value per line)</label>
      <label for="env" class="sr-only">Env</label>
    <textarea id="env" rows="4" class="mt-1">PORT=3000
NODE_ENV=production</textarea>
    </div>
    <div class="row mt-2">
      <label class="toggle"><input id="env-file" type="checkbox" /> EnvironmentFile=/etc/&lt;unit&gt;.conf</label>
      <label class="toggle"><input id="hardening" type="checkbox" checked /> Hardening group</label>
      <label class="toggle"><input id="network-wait" type="checkbox" /> Wait for network</label>
      <label class="toggle"><input id="install" type="checkbox" checked /> Install section (WantedBy=multi-user.target)</label>
    </div>
    <div id="hardening-fields" class="row mt-2">
      <label class="text-muted" for="read-write">ReadWritePaths</label>
      <input id="read-write" type="text" value="/var/lib/myapp" style="max-width:260px;" />
    </div>
    <div class="row mt-2">
      <button class="primary" id="gen">Generate Unit File</button>
      <button class="ghost" id="copy">Copy</button>
    </div>
  </section>

  <section class="card mt-2" id="out-section" style="display:none;">
    <h2 class="h2-card">myapp.service</h2>
    <pre id="output" class="mt-1">—</pre>
    <p class="text-muted mt-1" id="hint"></p>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <h2 class="h2-card">Error</h2>
    <pre id="err-out" style="color:var(--danger);">—</pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Fill in the unit name, command, and environment. <strong>Restart</strong> and <strong>RestartSec</strong> control the restart policy.</li>
    <li><strong>Hardening group</strong> adds NoNewPrivileges, PrivateTmp, ProtectSystem=strict, ProtectHome, and a ReadWritePaths whitelist.</li>
    <li><strong>Wait for network</strong> adds <code>After=network-online.target</code> and <code>Wants=network-online.target</code>; the <strong>Install</strong> section wires <code>WantedBy=multi-user.target</code>.</li>
    <li>After generating, run the hint below: <code>sudo systemctl daemon-reload</code> followed by <code>sudo systemctl enable --now &lt;unit&gt;</code>.</li>
  </ul>

  <h2>About Systemd Unit Generator</h2>
  <p class="text-muted">Systemd unit files are small but easy to get subtly wrong — a missing User, a Restart value that never recovers, or no hardening on a public-facing daemon. This generator emits a conventional <code>[Unit]</code>/<code>[Service]</code>/<code>[Install]</code> file with the options spelled exactly as systemd expects them.</p>
  <p class="text-muted">The hardening group follows the baseline recommended for most services: no new privileges, a private tmp, a read-only system and home, and an explicit list of writable paths. Adjust ReadWritePaths to match where your app writes data, keep secrets out of Environment lines (prefer EnvironmentFile with restrictive permissions), and verify the unit with <code>systemd-analyze verify</code> before enabling it.</p>
</BaseLayout>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  input[type=text], input[type=number], select, textarea { max-width: 100%; }
  pre { min-height: 120px; max-height: 520px; overflow: auto; white-space: pre-wrap; word-break: break-word; font-size: .8rem; }
  .mt-2 { margin-top: 16px; }
  .toggle { display: flex; align-items: center; gap: 8px; font-size: .9rem; }
  .toggle input[type=checkbox] { width: auto; accent-color: var(--accent); }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  $('hardening').addEventListener('change', () => {
    $('hardening-fields').style.display = $('hardening').checked ? 'flex' : 'none';
  });

  $('gen').addEventListener('click', () => {
    try {
      const unit = $('unit-name').value.trim().replace(/\.service$/, '');
      if (!unit) throw new Error('Unit name is required.');
      if (!/^[a-zA-Z0-9_.:@\\-]+$/.test(unit)) throw new Error('Unit name contains invalid characters.');
      const desc = $('description').value.trim();
      const execStart = $('exec-start').value.trim();
      if (!execStart) throw new Error('ExecStart is required.');
      const workdir = $('workdir').value.trim();
      const user = $('user').value.trim();
      const group = $('group').value.trim();
      const restart = $('restart').value;
      const restartSec = parseInt($('restart-sec').value, 10);
      const envFile = $('env-file').checked;
      const hardening = $('hardening').checked;
      const netWait = $('network-wait').checked;
      const install = $('install').checked;

      const envLines = $('env').value.split('\n').map(s => s.trim()).filter(Boolean);

      const L = [];
      L.push('[Unit]');
      if (desc) L.push('Description=' + desc);
      if (netWait) {
        L.push('After=network-online.target');
        L.push('Wants=network-online.target');
      }
      L.push('');
      L.push('[Service]');
      if (user) L.push('User=' + user);
      if (group) L.push('Group=' + group);
      if (workdir) L.push('WorkingDirectory=' + workdir);
      for (const e of envLines) L.push('Environment=' + e);
      if (envFile) L.push('EnvironmentFile=/etc/' + unit + '.conf');
      L.push('ExecStart=' + execStart);
      L.push('Restart=' + restart);
      if (!isNaN(restartSec) && restartSec >= 0) L.push('RestartSec=' + restartSec);
      if (hardening) {
        L.push('NoNewPrivileges=yes');
        L.push('PrivateTmp=yes');
        L.push('ProtectSystem=strict');
        L.push('ProtectHome=yes');
        const rw = $('read-write').value.trim();
        if (rw) L.push('ReadWritePaths=' + rw);
      }
      if (install) {
        L.push('');
        L.push('[Install]');
        L.push('WantedBy=multi-user.target');
      }

      $('output').textContent = L.join('\n');
      $('out-section').style.display = 'block';
      $('err-section').style.display = 'none';
      $('hint').textContent = 'Enable with: sudo systemctl daemon-reload && sudo systemctl enable --now ' + unit;
    } catch (e) {
      $('err-out').textContent = e.message;
      $('err-section').style.display = 'block';
      $('out-section').style.display = 'none';
    }
  });

  $('copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText($('output').textContent);
      $('copy').textContent = 'Copied!';
      setTimeout(() => { $('copy').textContent = 'Copy'; }, 1200);
    } catch {}
  });
})();
</script>
