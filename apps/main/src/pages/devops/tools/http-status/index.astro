---
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'HTTP Status Codes Reference';
const description = 'Quick reference for HTTP status codes grouped by class, with live search and a one-line description for every code.';
---

<BaseLayout site="devops" title={title} description={description}
  canonical="https://jsonversal.com/devops/tools/http-status/"
  keywords={['HTTP status codes', 'HTTP response codes', 'status code reference', 'REST API debugging', '1xx 2xx 3xx 4xx 5xx']}
  current="/devops/tools/">

  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>

  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <div class="card">
    <label for="search" class="sr-only">Search</label> <input id="search" type="search" placeholder="Search by code or name, e.g. 404, redirect, timeout, forbidden..." />
    <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;">
      <button class="primary" id="f-all" data-filter="all">All</button>
      <button class="ghost" id="f-1xx" data-filter="1xx">1xx</button>
      <button class="ghost" id="f-2xx" data-filter="2xx">2xx</button>
      <button class="ghost" id="f-3xx" data-filter="3xx">3xx</button>
      <button class="ghost" id="f-4xx" data-filter="4xx">4xx</button>
      <button class="ghost" id="f-5xx" data-filter="5xx">5xx</button>
    </div>
  </div>

  <div class="card mt-2" id="results-section">
    <div id="result-list" class="status-list"></div>
    <div id="no-results" class="text-dim" style="display:none;text-align:center;padding:16px 0;">No status codes match your search.</div>
  </div>

  <h2>About HTTP Status Codes</h2>
  <p class="text-muted">HTTP status codes are three-digit numbers that a server returns with every response, grouped by their first digit: 1xx is informational (the request is being processed, e.g. 100 Continue), 2xx means success (200 OK, 201 Created), 3xx means the client must take additional action, usually a redirect (301 Moved Permanently, 304 Not Modified), 4xx means the request was invalid from the client's side (400 Bad Request, 404 Not Found), and 5xx means the server failed while handling an otherwise valid request (500 Internal Server Error, 503 Service Unavailable). Knowing the class at a glance tells you which side of the connection to investigate first.</p>
  <p class="text-muted">This reference is most useful when debugging APIs and troubleshooting failures: curl or your browser's network panel shows the code, and the description here tells you what it means and where to look next. A few common traps are worth remembering: 200 means the request was fulfilled, while 201 specifically means a resource was created — many APIs return 200 for POSTs that should be 201; 429 Too Many Requests means you are rate-limited and should respect the Retry-After header instead of hammering the endpoint; 418 I'm a Teapot is an April Fools' joke that real servers sometimes return deliberately; and 404 can mean "not found" or, when a server wants to hide the existence of a resource, a masked 403.</p>
</BaseLayout>

<style>
  .status-item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 8px 4px;
    border-bottom: 1px solid var(--border);
  }
  .status-item:last-child { border-bottom: none; }
  .code-badge {
    flex: 0 0 auto;
    min-width: 44px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: .78rem;
    font-weight: 600;
    color: #fff;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .code-badge.c1xx { background: #0e7490; }
  .code-badge.c2xx { background: #16a34a; }
  .code-badge.c3xx { background: #d97706; }
  .code-badge.c4xx { background: #ea580c; }
  .code-badge.c5xx { background: #dc2626; }
  .status-body { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; font-size: .9rem; }
</style>

<script is:inline client:load>
(function () {
  const $ = (id) => document.getElementById(id);

  const STATUSES = [
    { code: 100, name: 'Continue', desc: 'The server has received the request headers and the client may proceed with the request body.' },
    { code: 101, name: 'Switching Protocols', desc: 'The server agrees to switch protocols, e.g. upgrading to WebSocket.' },
    { code: 200, name: 'OK', desc: 'The request succeeded; the meaning of the payload depends on the HTTP method used.' },
    { code: 201, name: 'Created', desc: 'The request succeeded and a new resource was created, usually after a POST or PUT.' },
    { code: 202, name: 'Accepted', desc: 'The request was accepted for processing, but processing is not yet complete.' },
    { code: 203, name: 'Non-Authoritative Information', desc: 'The response was modified by a proxy and is not guaranteed to come from the origin server.' },
    { code: 204, name: 'No Content', desc: 'The request succeeded, but there is no content to send back in the body.' },
    { code: 205, name: 'Reset Content', desc: 'The server instructs the client to reset the document that sent this request.' },
    { code: 206, name: 'Partial Content', desc: 'The server is delivering only part of the resource, as requested via the Range header.' },
    { code: 207, name: 'Multi-Status', desc: 'WebDAV: the response body carries status information for multiple independent operations.' },
    { code: 208, name: 'Already Reported', desc: 'WebDAV: a member of a DAV binding was listed earlier in the multi-status response.' },
    { code: 226, name: 'IM Used', desc: 'The server fulfilled the request using an instance manipulation of the resource.' },
    { code: 300, name: 'Multiple Choices', desc: 'The resource has multiple representations; the client should pick one, often from a Location header.' },
    { code: 301, name: 'Moved Permanently', desc: 'The resource has permanently moved; future requests should use the new URL in Location.' },
    { code: 302, name: 'Found', desc: 'The resource is temporarily at a different URL; most clients follow it with a GET.' },
    { code: 303, name: 'See Other', desc: 'The response to the request can be found at another URI, which should be retrieved with GET.' },
    { code: 304, name: 'Not Modified', desc: 'The cached copy is still valid, so the server sends no body — use the cache.' },
    { code: 305, name: 'Use Proxy', desc: 'The requested resource must be accessed through the proxy given in the Location header.' },
    { code: 307, name: 'Temporary Redirect', desc: 'The resource is temporarily elsewhere; the client must repeat the request with the same method.' },
    { code: 308, name: 'Permanent Redirect', desc: 'The resource has permanently moved; repeat the request with the same method and body.' },
    { code: 400, name: 'Bad Request', desc: 'The server could not understand the request due to malformed syntax or invalid parameters.' },
    { code: 401, name: 'Unauthorized', desc: 'Authentication is required and has failed or not been provided yet.' },
    { code: 402, name: 'Payment Required', desc: 'Reserved for future use; originally intended for digital payment schemes.' },
    { code: 403, name: 'Forbidden', desc: 'The server understood the request but refuses to authorize it.' },
    { code: 404, name: 'Not Found', desc: 'The server cannot find the requested resource; the URL may be wrong or the resource removed.' },
    { code: 405, name: 'Method Not Allowed', desc: 'The HTTP method is not supported for this resource (e.g. DELETE on a GET-only endpoint).' },
    { code: 406, name: 'Not Acceptable', desc: 'The server cannot produce a response matching the client\'s Accept headers.' },
    { code: 407, name: 'Proxy Authentication Required', desc: 'Authentication is required by the proxy between the client and the server.' },
    { code: 408, name: 'Request Timeout', desc: 'The server timed out waiting for the rest of the request from the client.' },
    { code: 409, name: 'Conflict', desc: 'The request conflicts with the current state of the resource, e.g. a duplicate unique key.' },
    { code: 410, name: 'Gone', desc: 'The resource is gone permanently, with no forwarding address; the condition is expected to last.' },
    { code: 411, name: 'Length Required', desc: 'The server refuses the request without a defined Content-Length header.' },
    { code: 412, name: 'Precondition Failed', desc: 'A precondition header (e.g. If-Match) evaluated to false on the server.' },
    { code: 413, name: 'Payload Too Large', desc: 'The request body is larger than the server is willing or able to process.' },
    { code: 414, name: 'URI Too Long', desc: 'The requested URI is longer than the server can interpret.' },
    { code: 415, name: 'Unsupported Media Type', desc: 'The request body format is not supported by the server for the target resource.' },
    { code: 416, name: 'Range Not Satisfiable', desc: 'The Range header cannot be satisfied; the server returns a Content-Range with the actual size.' },
    { code: 417, name: 'Expectation Failed', desc: 'A requirement in the Expect request header could not be met by the server.' },
    { code: 418, name: "I'm a Teapot", desc: 'An April Fools\' joke: the server refuses to brew coffee because it is, in fact, a teapot.' },
    { code: 421, name: 'Misdirected Request', desc: 'The request was sent to a server that cannot produce a response for the target URI.' },
    { code: 422, name: 'Unprocessable Content', desc: 'The request is well-formed but contains semantic errors (commonly used for validation failures).' },
    { code: 423, name: 'Locked', desc: 'WebDAV: the target resource is locked and cannot be modified.' },
    { code: 424, name: 'Failed Dependency', desc: 'WebDAV: the request failed because a previous request it depended on failed.' },
    { code: 425, name: 'Too Early', desc: 'The server is unwilling to risk processing a request that might be replayed.' },
    { code: 426, name: 'Upgrade Required', desc: 'The client should switch to a different protocol, listed in the Upgrade header.' },
    { code: 428, name: 'Precondition Required', desc: 'The origin server requires the request to be conditional, typically using If-Match.' },
    { code: 429, name: 'Too Many Requests', desc: 'The client has sent too many requests in a given time window; respect the Retry-After header.' },
    { code: 431, name: 'Request Header Fields Too Large', desc: 'The request headers are too large for the server to process.' },
    { code: 451, name: 'Unavailable For Legal Reasons', desc: 'The server refuses to serve the resource for legal reasons, such as censorship demands.' },
    { code: 500, name: 'Internal Server Error', desc: 'An unexpected condition prevented the server from fulfilling the request.' },
    { code: 501, name: 'Not Implemented', desc: 'The server does not support the functionality required to fulfill the request.' },
    { code: 502, name: 'Bad Gateway', desc: 'A gateway or proxy received an invalid response from the upstream server.' },
    { code: 503, name: 'Service Unavailable', desc: 'The server is temporarily unable to handle the request, often due to overload or maintenance.' },
    { code: 504, name: 'Gateway Timeout', desc: 'A gateway or proxy did not receive a timely response from the upstream server.' },
    { code: 505, name: 'HTTP Version Not Supported', desc: 'The server does not support the HTTP protocol version used in the request.' },
    { code: 506, name: 'Variant Also Negotiates', desc: 'A configuration error: the chosen variant is configured to engage in content negotiation itself.' },
    { code: 507, name: 'Insufficient Storage', desc: 'WebDAV: the server cannot store the representation needed to complete the request.' },
    { code: 508, name: 'Loop Detected', desc: 'WebDAV: an infinite loop was detected while processing the request.' },
    { code: 510, name: 'Not Extended', desc: 'Further extensions to the request are required for the server to fulfill it.' },
    { code: 511, name: 'Network Authentication Required', desc: 'The client must authenticate to gain network access, e.g. a captive portal.' }
  ];

  let filter = 'all';

  function className(code) { return 'c' + Math.floor(code / 100) + 'xx'; }

  function render() {
    const q = $('search').value.trim().toLowerCase();
    const items = STATUSES.filter(function (s) {
      if (filter !== 'all' && className(s.code) !== 'c' + filter) return false;
      if (!q) return true;
      return String(s.code).indexOf(q) !== -1 ||
        s.name.toLowerCase().indexOf(q) !== -1 ||
        s.desc.toLowerCase().indexOf(q) !== -1;
    });
    $('no-results').style.display = items.length ? 'none' : '';
    $('result-list').innerHTML = items.map(function (s) {
      return '<div class="status-item">' +
        '<span class="code-badge ' + className(s.code) + '">' + s.code + '</span>' +
        '<div class="status-body"><strong>' + s.name + '</strong>' +
        '<span class="text-dim">' + s.desc + '</span></div>' +
        '</div>';
    }).join('');
  }

  function setFilter(f) {
    filter = f;
    ['all', '1xx', '2xx', '3xx', '4xx', '5xx'].forEach(function (k) {
      const btn = $('f-' + k);
      if (k === f) { btn.className = 'primary'; }
      else { btn.className = 'ghost'; }
    });
    render();
  }

  $('search').addEventListener('input', render);
  ['all', '1xx', '2xx', '3xx', '4xx', '5xx'].forEach(function (k) {
    $('f-' + k).addEventListener('click', function () { setFilter(k); });
  });

  render();
})();
</script>
