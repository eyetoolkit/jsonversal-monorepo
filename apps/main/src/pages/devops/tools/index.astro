---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolGrid from '@versal/ui/ToolGrid.astro';

const tools = [
  { title: 'YAML ↔ JSON Converter', description: 'Convert YAML to JSON and JSON to YAML. Pretty-print and validate.', href: '/devops/tools/yaml-json/' },
  { title: 'JSON Tree Viewer', description: 'Inspect any JSON as a collapsible, color-coded tree.', href: '/devops/tools/json-viewer/' },
  { title: 'Base64 Encoder / Decoder', description: 'Encode text to Base64 or decode Base64 back to text. URL-safe variant supported.', href: '/devops/tools/base64/' },
  { title: 'URL Encoder / Decoder', description: 'Percent-encode or decode URLs and query-string components.', href: '/devops/tools/url-codec/' },
  { title: 'JWT Decoder', description: 'Decode and inspect the header and payload of any JSON Web Token without verification.', href: '/devops/tools/jwt-decoder/' },
  { title: 'Unix Timestamp Converter', description: 'Convert between Unix timestamps and human-readable local/UTC dates.', href: '/devops/tools/timestamp/' },
  { title: 'Regex Tester & Playground', description: 'Test any regex against sample text with real-time match highlighting and capture groups.', href: '/devops/tools/regex-advanced/' },
  { title: 'Crontab Explainer', description: 'Translate a crontab expression into human-readable schedule and list next 10 runs.', href: '/devops/tools/crontab/' },
  { title: 'Crontab Parser', description: 'Translate crontab expressions into plain English and preview the next 10 run times.', href: '/devops/tools/cron-parser/' },
  { title: 'Regex Visualizer', description: 'Test a regex against sample input, highlight matches, and explain the pattern.', href: '/devops/tools/regex/' },
  { title: 'UUID v4 Generator', description: 'Generate RFC 4122 UUID v4 in bulk, with uppercase, no-hyphen, and URN formats.', href: '/devops/tools/uuid-generator/' },
  { title: 'HTTP Status Codes', description: 'Search and filter every HTTP status code with its meaning.', href: '/devops/tools/http-status/' },
  { title: 'CIDR / Subnet Calculator', description: 'Network address, broadcast, usable hosts, and masks for any IPv4 CIDR.', href: '/devops/tools/cidr-calculator/' },
  { title: 'Kubernetes YAML Generator', description: 'Scaffold Deployment, Service, and Ingress manifests from a form.', href: '/devops/tools/k8s-generator/' },
  { title: 'Common Ports Reference', description: 'Look up well-known TCP/UDP ports: SSH, HTTP, databases, Kubernetes.', href: '/devops/tools/ports-reference/' },
  { title: 'Nginx Config Generator', description: 'Generate nginx server blocks for static sites or reverse proxies with HTTPS, gzip, and security headers.', href: '/devops/tools/nginx-config/' },
  { title: 'Systemd Unit Generator', description: 'Build systemd unit files with environment, restart policy, and hardening options.', href: '/devops/tools/systemd-unit/' },
  { title: 'Log Line Parser', description: 'Parse nginx, Apache, JSON, or custom-regex log lines into a color-coded table with stats.', href: '/devops/tools/log-parser/' },
  { title: 'Basic Auth Header Generator', description: 'Generate and decode HTTP Basic Authentication headers. Encodes username:password to Base64.', href: '/devops/tools/basic-auth-generator/' },
  { title: 'Number Base Converter', description: 'Convert between binary, octal, decimal, hex, and ASCII with exact 64-bit BigInt math.', href: '/devops/tools/number-base/' },
];
---

<BaseLayout site="devops" title="All DevOps Tools" current="/devops/tools/" canonical="https://jsonversal.com/devops/tools/">
  <div class="tool-head">
    <h1>DevOps Tools</h1>
    <p class="desc">Everything runs locally. Convert, decode and inspect your configs with the filter to find a specific tool.</p>
  </div>

  <ToolGrid tools={tools} />
</BaseLayout>