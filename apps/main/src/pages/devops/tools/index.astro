---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolCard from '@versal/ui/ToolCard.astro';

const tools = [
  { title: 'YAML ↔ JSON Converter', description: 'Two-way conversion, pretty-print, validate.', href: '/devops/tools/yaml-json/' },
  { title: 'JSON Tree Viewer', description: 'Collapsible, color-coded tree for any JSON document.', href: '/devops/tools/json-viewer/' },
  { title: 'Base64 Encoder / Decoder', description: 'Plain and URL-safe Base64.', href: '/devops/tools/base64/' },
  { title: 'URL Encoder / Decoder', description: 'Percent-encode/decode full URLs or query components.', href: '/devops/tools/url-codec/' },
  { title: 'JWT Decoder', description: 'Decode header and payload of any JWT.', href: '/devops/tools/jwt-decoder/' },
  { title: 'Unix Timestamp Converter', description: 'Seconds/ms to local & UTC dates and back.', href: '/devops/tools/timestamp/' },
  { title: 'Crontab Explainer', description: 'Human-readable schedule + next 10 runs.', href: '/devops/tools/crontab/' },
  { title: 'Regex Visualizer', description: 'Test regex against sample input, highlight matches.', href: '/devops/tools/regex/' },
  { title: 'UUID v4 Generator', description: 'Generate RFC 4122 UUID v4 in bulk with case/format options.', href: '/devops/tools/uuid-generator/' },
  { title: 'HTTP Status Codes', description: 'Search and filter every HTTP status code with descriptions.', href: '/devops/tools/http-status/' },
  { title: 'CIDR / Subnet Calculator', description: 'Network address, broadcast, host ranges, masks for any CIDR.', href: '/devops/tools/cidr-calculator/' },
  { title: 'Kubernetes YAML Generator', description: 'Scaffold Deployment / Service / Ingress manifests.', href: '/devops/tools/k8s-generator/' },
  { title: 'Common Ports Reference', description: 'Search well-known TCP/UDP ports: SSH, HTTP, databases, K8s.', href: '/devops/tools/ports-reference/' },
  { title: 'Nginx Config Generator', description: 'Server blocks for static sites or reverse proxies with HTTPS, gzip, caching.', href: '/devops/tools/nginx-config/' },
  { title: 'Systemd Unit Generator', description: 'Unit files with environment, restart policy, and hardening.', href: '/devops/tools/systemd-unit/' },
  { title: 'Log Line Parser', description: 'Parse nginx, Apache, JSON, or custom-regex logs into tables and stats.', href: '/devops/tools/log-parser/' },
  { title: 'Number Base Converter', description: 'Binary, octal, decimal, hex, and ASCII with exact 64-bit math.', href: '/devops/tools/number-base/' },
];
---

<BaseLayout site="devops" title="All DevOps Tools" current="/devops/tools/">
  <h1>DevOps Tools</h1>
  <p class="text-muted">Every tool runs in your browser. No uploads, no secrets leaked.</p>
  <div class="grid">
    {tools.map(tool => <ToolCard {...tool} />)}
  </div>
</BaseLayout>