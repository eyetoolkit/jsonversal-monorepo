---
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'Base64 Encoder / Decoder';
const description = 'Encode any text to Base64, or decode Base64 back to text. Supports standard and URL-safe variants.';
---

<BaseLayout site="devops" title={title} description={description}
  canonical="https://jsonversal.com/devops/tools/base64/"
  keywords={['Base64 encode', 'Base64 decode', 'URL-safe Base64', 'base64 converter']}
  current="/devops/tools/base64/"
  faqs={[{question:"Is my data safe when using this tool?",answer:"100% safe. All processing happens entirely in your browser — nothing is uploaded, sent to a server, or stored anywhere."},{question:"Do I need to sign up?",answer:"No signup. All tools are free with no registration, no cookies, no tracking."},{question:"Size limits?",answer:"No arbitrary limits. Runs entirely in your browser memory."}]}
  faqs={[{question:"Is my data safe when using this tool?",answer:"100% safe. All processing happens entirely in your browser — nothing is uploaded, sent to a server, or stored anywhere."},{question:"Do I need to sign up or create an account?",answer:"No signup required. All tools are completely free with no registration, no email, no cookies, and no tracking."},{question:"Are there size limits?",answer:"No arbitrary limits — conversion happens entirely in memory in your browser. Tested with documents over 10MB."}]}
  faqs={[{question:"Is my data safe when using this tool?",answer:"100% safe. All processing happens entirely in your browser — nothing is uploaded, sent to a server, or stored anywhere. Your JSON, API keys, passwords, and configuration data never leave your device."},{question:"Do I need to sign up or create an account?",answer:"No signup required. All tools are completely free to use with no registration, no email, no cookies, and no tracking. Open the page and start using it immediately."},{question:"Are there size limits?",answer:"No arbitrary limits — conversion happens entirely in memory in your browser. We've tested with documents over 10MB. Your device's RAM is the only practical constraint."}]}
  faqs={[{question:"Is my data safe when using this tool?",answer:"100% safe. All processing happens entirely in your browser — nothing is uploaded, sent to a server, or stored anywhere. Your JSON, API keys, passwords, and configuration data never leave your device."},{question:"Do I need to sign up or create an account?",answer:"No signup required. All tools are completely free to use with no registration, no email, no cookies, and no tracking. Open the page and start using it immediately."},{question:"Are there size limits?",answer:"No arbitrary limits — conversion happens entirely in memory in your browser. We've tested with documents over 10MB. Your device's RAM is the only practical constraint."}]}>

  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>

  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;">
        <strong>Input</strong>
        <label class="text-muted" style="font-size:.8rem;">
          <input type="checkbox" id="urlsafe" /> URL-safe
        </label>
      </div>
      <label for="input" class="sr-only">Input</label>
    <textarea id="input" placeholder="Text or Base64..." style="margin-top:12px;min-height:260px;"></textarea>
      <div style="margin-top:8px;display:flex;gap:8px;">
        <button class="primary" id="encode">→ Encode</button>
        <button class="ghost" id="decode">← Decode</button>
        <button class="ghost" id="clear">Clear</button>
      </div>
    </div>

    <div class="card">
      <div><strong>Output</strong></div>
      <pre id="output" style="min-height:260px;margin-top:12px;white-space:pre-wrap;">—</pre>
      <button class="ghost" id="copy" style="margin-top:8px;">Copy</button>
    </div>
  </div>

  <h2>Notes</h2>
  <ul>
    <li>Standard Base64 uses <code>+</code>, <code>/</code>, <code>=</code>. URL-safe replaces them with <code>-</code>, <code>_</code> and drops padding.</li>
    <li>Supports Unicode text via UTF-8 encoding.</li>
  </ul>

  <h2>About Base64 Encoder / Decoder</h2>
  <p class="text-muted">Base64 is an encoding that converts arbitrary binary data into a safe ASCII representation using a 64-character alphabet (A–Z, a–z, 0–9, plus + and /) with = padding. It is not compression: the output is roughly 33% larger than the original bytes, but it guarantees that data survives transport through text-only channels. This tool encodes text as UTF-8 and decodes Base64 back to the original string.</p>
  <p class="text-muted">Reach for Base64 when you must embed or transmit binary data inside text-based protocols: email attachments, data URIs in HTML and CSS, or binary blobs in JSON fields. The URL-safe variant replaces + and / with - and _ and strips the = padding, so the output can appear safely in URLs, query strings, and filenames. Remember that Base64 is an encoding, not encryption — anyone can decode it, so never rely on it to protect secrets or passwords.</p>
</BaseLayout>


<script is:inline client:load>
(function () {
  const $ = (id) => document.getElementById(id);
  function toB64(text, urlsafe) {
    const bytes = new TextEncoder().encode(text);
    let bin = '';
    bytes.forEach(b => bin += String.fromCharCode(b));
    let s = btoa(bin);
    if (urlsafe) s = s.replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    return s;
  }
  function fromB64(b64, urlsafe) {
    if (urlsafe) b64 = b64.replace(/-/g, '+').replace(/_/g, '/');
    while (b64.length % 4) b64 += '=';
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  }

  $('encode').addEventListener('click', () => {
    try { $('output').textContent = toB64($('input').value, $('urlsafe').checked); }
    catch (e) { $('output').textContent = 'Error: ' + e.message; }
  });
  $('decode').addEventListener('click', () => {
    try { $('output').textContent = fromB64($('input').value.trim(), $('urlsafe').checked); }
    catch (e) { $('output').textContent = 'Error: ' + e.message; }
  });
  $('clear').addEventListener('click', () => { $('input').value = ''; $('output').textContent = '—'; });
  $('copy').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText($('output').textContent); $('copy').textContent = 'Copied!'; setTimeout(() => $('copy').textContent = 'Copy', 1200); } catch {}
  });
})();
</script>