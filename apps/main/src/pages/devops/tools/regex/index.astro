---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "Regex Tester  — Test Regular Expressions";
const description = "Test regular expressions with live match highlighting, capture groups and explanations. Supports JavaScript flags: global, case-insensitive and multiline.";
const faqs = [
  {
    "question": "How do I test a regular expression online?",
    "answer": "Enter your regex pattern in the top input and your test string below. Matches are highlighted in real time as you type. The tool supports JavaScript-compatible regex syntax with flags like g (global), i (case-insensitive), and m (multiline)."
  },
  {
    "question": "Why is my regex not matching?",
    "answer": "Check that you are using the correct syntax for JavaScript regex. Escape special characters with a backslash. For example, use \\d instead of [0-9] shorthand classes, and escape dots as \\. to match literal periods. Hover over the pattern error indicator for specific feedback."
  },
  {
    "question": "Can I test regex against multiple strings at once?",
    "answer": "Yes. Enter one or more test strings separated by newlines. All matches across all lines are highlighted simultaneously, with match groups shown for each occurrence."
  }
];
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';
---

<ToolPage
  site="devops"
  title={title}
  description={description}
  canonical="https://jsonversal.com/devops/tools/regex/"
  current="/devops/tools/regex/"
  faqs={faqs}
    about={[
        [
          "Reading a pattern before you write one",
          [
            "A regular expression is read left to right, and each token consumes input or groups it. `\\d` is one digit, `\\w` is a word character, `.` is any character except a newline, and a quantifier such as `+` or `{3,}` applies to the token immediately before it. Getting that last relationship right is most of the difficulty in writing patterns.",
            "Anchors change the scope of the match rather than what it matches: `^` requires the start of the string (or line, with the multiline flag) and `$` the end. For validation, an unanchored pattern that matches part of a string is almost never what you want."
          ]
        ],
        [
          "Greediness and backtracking",
          [
            "A quantifier is greedy by default — `.*` consumes as much as possible and then gives characters back when the rest of the pattern fails. When results are longer than expected, that backtracking is usually the cause, and `.*?` is the first thing to try.",
            "Nested quantifiers such as `(a+)+` can trigger catastrophic backtracking on non-matching input, freezing the page for seconds or minutes. If a pattern is slow rather than wrong, look for nested repetition first."
          ]
        ],
        [
          "Flavours are not interchangeable",
          [
            "JavaScript, Python and PCRE agree on the basics and disagree on the edges: `\\d` excludes some Unicode digits in some flavours, lookbehind support varies, and named group syntax differs. Test a pattern in the engine that will actually run it."
          ]
        ]
      ]}
  >

  <div class="card">
    <div style="display:grid;grid-template-columns:1fr auto auto;gap:12px;align-items:center;">
      <input id="pattern" aria-label="Regular expression" type="text" value="(\w+)@(\w+\.\w+)" style="font-family:var(--font-mono);" />
      <select id="flags" aria-label="Flags">
        <option value="g">g (global)</option>
        <option value="gi">gi (global + case-insensitive)</option>
        <option value="gm">gm (global + multiline)</option>
        <option value="gs">gs (global + dotAll)</option>
      </select>
    </div>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" placeholder="Paste text to test against..." style="margin-top:12px;min-height:160px;">Contact us at [email protected] or [email protected] today.</textarea>
    <button class="primary mt-2" id="test">Run</button>
  </div>

  <div class="card mt-2">
    <strong>Highlighted matches</strong>
    <div id="result" class="mt-2" style="padding:12px;background:var(--bg);border-radius:var(--radius-sm);min-height:60px;font-family:var(--font-mono);white-space:pre-wrap;"></div>
  </div>

  <div class="card mt-2">
    <strong>Capture groups</strong>
    <pre id="groups" class="mt-2">—</pre>
  </div>

  <h2>Regex cheat sheet</h2>
  <ul>
    <li><code>.</code> any char · <code>&#92;w</code> word · <code>&#92;d</code> digit · <code>&#92;s</code> whitespace</li>
    <li><code>*</code> 0+ · <code>+</code> 1+ · <code>?</code> 0 or 1 · <code>{"{n,m}"}</code> range</li>
    <li><code>^</code> start · <code>$</code> end · <code>[abc]</code> char class · <code>[^abc]</code> negated</li>
    <li><code>(x)</code> group · <code>(?:x)</code> non-capturing · <code>x|y</code> or</li>
  </ul>

  <h2>About Regex Visualizer</h2>
  <p class="text-muted">A regular expression (regex) is a compact pattern language for describing text: character classes, quantifiers, anchors, alternation, and capture groups combine to match everything from email addresses to log lines. This visualizer runs your pattern against sample input, highlights every match, and shows what each capture group captured so you can see exactly how the engine interprets the pattern.</p>
  <p class="text-muted">Reach for regex when you need text validation, log parsing, extraction, or search-and-replace in scripts and code. Be careful with greedy quantifiers like .* which consume as much as possible  — add ? to make them lazy when needed. Also mind the risks: patterns with nested quantifiers can cause catastrophic backtracking (ReDoS) on untrusted input, and different engines differ in features, so a pattern using lookaheads or backreferences may work in PCRE or JavaScript but not in RE2, Go, or MySQL.</p>
</ToolPage>


<script is:inline client:load>
(function () {
  const $ = (id) => document.getElementById(id);
  const PALETTE = ['#10b981', '#f59e0b', '#ef4444', '#6366f1', '#06b6d4', '#ec4899'];

  function run() {
    const pat = $('pattern').value;
    const flags = $('flags').value;
    const text = $('input').value;
    let re;
    try { re = new RegExp(pat, flags); }
    catch (e) {
      $('result').innerHTML = '<span style="color:var(--danger)">Invalid regex: ' + e.message + '</span>';
      $('groups').textContent = '—';
      return;
    }
    const matches = [];
    let m;
    if (flags.includes('g')) {
      while ((m = re.exec(text)) !== null) { matches.push(m); if (m.index === re.lastIndex) re.lastIndex++; }
    } else {
      m = re.exec(text); if (m) matches.push(m);
    }

    // Build highlighted HTML
    const parts = [];
    let cursor = 0;
    matches.forEach((match, idx) => {
      if (match.index > cursor) parts.push({ kind: 'text', value: text.slice(cursor, match.index) });
      parts.push({ kind: 'match', value: match[0], idx });
      cursor = match.index + match[0].length;
    });
    if (cursor < text.length) parts.push({ kind: 'text', value: text.slice(cursor) });
    $('result').innerHTML = parts.map(p => p.kind === 'match'
      ? `<mark style="background:${PALETTE[p.idx % PALETTE.length]};color:#000;border-radius:3px;padding:0 2px;">${escapeHtml(p.value)}</mark>`
      : escapeHtml(p.value)).join('') || '(no match)';

    // Summarize capture groups
    if (matches.length === 0) { $('groups').textContent = '—'; return; }
    const lines = matches.map((match, i) => {
      const groups = match.slice(1).map((g, gi) => `  $${gi+1}=${JSON.stringify(g)}`).join('\n');
      return `#${i+1} full=${JSON.stringify(match[0])}\n${groups || '  (no named capture groups)'}`;
    });
    $('groups').textContent = lines.join('\n\n');
  }

  function escapeHtml(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  $('test').addEventListener('click', run);
  [$('pattern'), $('flags'), $('input')].forEach(el => el.addEventListener('input', () => run()));
  if (typeof document !== 'undefined') run();
})();
</script>