---
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'Crontab Explainer';
const description = 'Translate a crontab expression into human-readable schedule and list the next 10 scheduled runs.';
---

<BaseLayout site="devops" title={title} description={description}
  canonical="https://jsonversal.com/devops/tools/crontab/"
  keywords={['crontab', 'cron', 'cron schedule']}
  current="/devops/tools/">

  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>

  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <div class="card">
    <label class="text-muted" for="expr">Cron expression</label>
    <label for="expr" class="sr-only">Expression</label> <input id="expr" type="text" value="0 9 * * *" style="margin-top:8px;font-family:var(--font-mono);" />
    <div class="text-muted" style="font-size:.8rem;margin-top:4px;">
      Format: <code>min hour dom month dow</code> (5-field) or <code>sec min hour dom month dow</code> (6-field).
    </div>
    <button class="primary mt-2" id="parse">Explain</button>
    <button class="ghost mt-2" id="sample">Load sample</button>
  </div>

  <div class="row" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px;">
    <div class="card">
      <strong>Human-readable</strong>
      <pre id="readable" class="mt-2">—</pre>
    </div>
    <div class="card">
      <strong>Next 10 runs (local time)</strong>
      <pre id="next" class="mt-2">—</pre>
    </div>
  </div>

  <h2>Quick reference</h2>
  <ul>
    <li><code>*</code> — every unit</li>
    <li><code>*/5</code> — every 5th</li>
    <li><code>,</code> — list (e.g. <code>1,3,5</code>)</li>
    <li><code>-</code> — range (e.g. <code>1-5</code>)</li>
    <li>Dow: 0/7 = Sun, 1 = Mon, … 6 = Sat</li>
  </ul>

  <h2>About Crontab Explainer</h2>
  <p class="text-muted">A crontab expression describes a repeating schedule with five whitespace-separated fields: minute, hour, day of month, month, and day of week, with a sixth field adding seconds in some implementations. Wildcards, lists, ranges, and step values let you express anything from a nightly backup to a quarterly report run. This explainer parses the expression, shows what each field means, and lists the next ten times the job will fire.</p>
  <p class="text-muted">Use it when you are troubleshooting scheduled jobs: jobs that never run, run at the wrong time, or run more often than expected are usually explained by a subtle field mistake. Note that cron interprets times in the local timezone of the daemon rather than the user's, and on most systems there is no per-job timezone field without extensions like CRON_TZ. Also remember that shorthands such as @daily, @hourly, or @reboot are convenience strings supported by cronie and Vixie cron, not part of the standard five-field format.</p>
</BaseLayout>

<script is:inline client:load>
(function () {
  const $ = (id) => document.getElementById(id);

  function parseField(str, min, max, names) {
    const allowed = new Set();
    str.split(',').forEach(part => {
      let [range, step] = part.split('/');
      step = step ? parseInt(step, 10) : 1;
      let start, end;
      if (range === '*') { start = min; end = max; }
      else if (range.includes('-')) {
        const [a, b] = range.split('-');
        start = names ? names.indexOf(a.toLowerCase()) : parseInt(a, 10);
        end   = names ? names.indexOf(b.toLowerCase()) : parseInt(b, 10);
      } else {
        start = end = names ? names.indexOf(range.toLowerCase()) : parseInt(range, 10);
      }
      if (isNaN(start) || isNaN(end)) return;
      for (let v = start; v <= end; v += step) allowed.add(v);
    });
    return allowed;
  }

  function parseCron(expr) {
    const parts = expr.trim().split(/\s+/);
    if (parts.length < 5 || parts.length > 6) throw new Error('Need 5 or 6 fields');
    let secSet;
    let [f1, f2, f3, f4, f5, f6] = parts;
    if (parts.length === 6) { secSet = parseField(f1, 0, 59); f1 = f2; f2 = f3; f3 = f4; f4 = f5; f5 = f6; }
    const minute = parseField(f1, 0, 59);
    const hour   = parseField(f2, 0, 23);
    const dom    = parseField(f3, 1, 31);
    const month  = parseField(f4, 1, 12);
    const dow    = parseField(f5, 0, 6, ['sun','mon','tue','wed','thu','fri','sat']);
    return { secSet, minute, hour, dom, month, dow, six: parts.length === 6 };
  }

  function matchesFields(d, cron) {
    return cron.minute.has(d.getMinutes())
        && cron.hour.has(d.getHours())
        && cron.dom.has(d.getDate())
        && cron.month.has(d.getMonth() + 1)
        && cron.dow.has(d.getDay());
  }

  function nextRuns(cron, n = 10) {
    const runs = [];
    const cursor = new Date();
    cursor.setMilliseconds(0);
    if (cron.six) { cursor.setSeconds(cursor.getSeconds() + 1); }
    else { cursor.setSeconds(0); cursor.setMinutes(cursor.getMinutes() + 1); }

    let safety = 0;
    while (runs.length < n && safety++ < 60 * 24 * 365 * 10) {
      if (matchesFields(cursor, cron)) runs.push(new Date(cursor));
      if (cron.six) { cursor.setSeconds(cursor.getSeconds() + 1); }
      else { cursor.setMinutes(cursor.getMinutes() + 1); }
    }
    return runs;
  }

  function gen() {
    const expr = $('expr').value;
    try {
      const cron = parseCron(expr);
      const parts = expr.trim().split(/\s+/);
      const descParts = ['minute', 'hour', 'dom', 'month', 'dow'];
      let desc = 'Fields:\n';
      for (let i = 0; i < descParts.length; i++) desc += '  ' + descParts[i] + ': ' + (cron.six ? parts[i+1] : parts[i]) + '\n';
      $('readable').textContent = desc + '\nNext run preview below.';
      const runs = nextRuns(cron, 10);
      $('next').textContent = runs.map(d => d.toLocaleString()).join('\n');
    } catch (e) {
      $('readable').textContent = 'Parse error: ' + e.message;
      $('next').textContent = '—';
    }
  }

  $('parse').addEventListener('click', gen);
  $('expr').addEventListener('input', gen);
  $('sample').addEventListener('click', () => { $('expr').value = '0 9 * * 1-5'; gen(); });

  gen();
})();
</script>