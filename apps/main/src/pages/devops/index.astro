---
import '@versal/ui/versal-brand.css';

const tools = [
  { title: 'Base64 Encoder / Decoder', description: 'Encode any text to Base64, or decode Base64 back. Standard and URL-safe.', href: '/devops/tools/base64/' },
  { title: 'Basic Auth Header Generator', description: 'Generate and decode HTTP Basic Auth headers for curl, Postman, APIs.', href: '/devops/tools/basic-auth-generator/' },
  { title: 'CIDR / Subnet Calculator', description: 'Network, broadcast, host range, mask, address count for any CIDR block.', href: '/devops/tools/cidr-calculator/' },
  { title: 'Crontab Explainer', description: 'Translate cron expressions into plain English and list next 10 runs.', href: '/devops/tools/crontab/' },
  { title: 'Kubernetes YAML Generator', description: 'Scaffold Deployment, Service, Ingress manifests from a small form.', href: '/devops/tools/k8s-generator/' },
  { title: 'Log Line Parser', description: 'Parse nginx, Apache, JSON, or custom-regex log lines into a colour-coded table.', href: '/devops/tools/log-parser/' },
  { title: 'Number Base Converter', description: 'Binary, octal, decimal, hex, ASCII with exact 64-bit BigInt math.', href: '/devops/tools/number-base/' },
  { title: 'QR Code Generator', description: 'URL, text, WiFi, contacts. Custom size and colour. Download as PNG or SVG.', href: '/devops/tools/qr-code-generator/' },
  { title: 'Regex Tester', description: 'Live match highlighting, capture groups, explanations.', href: '/devops/tools/regex/' },
  { title: 'Regex Tester — Advanced', description: 'Groups, indices, captured values, match counts, common pattern presets.', href: '/devops/tools/regex-advanced/' },
  { title: 'Unix Timestamp Converter', description: 'Seconds or milliseconds, local or UTC, ISO 8601 and RFC 2822.', href: '/devops/tools/timestamp/' },
  { title: 'URL Encoder & Decoder', description: 'Percent-encode / decode URLs, query strings, form data, path segments.', href: '/devops/tools/url-codec/' },
  { title: 'UUID v4 Generator', description: 'Single or bulk, uppercase, no-hyphen or URN. Validate any UUID version.', href: '/devops/tools/uuid-generator/' },
  { title: 'YAML ↔ JSON Converter', description: 'Convert YAML to JSON and JSON to YAML. Pretty-print, validate, minify.', href: '/devops/tools/yaml-json/' },
  { title: 'JSON Tree Viewer', description: 'Paste any JSON and explore it as a collapsible, colour-coded tree.', href: '/devops/tools/json-viewer/' },
];
