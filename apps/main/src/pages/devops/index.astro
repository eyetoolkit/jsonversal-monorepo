<script is:inline>
(function(){
  var KEY='versal-theme';
  var saved=localStorage.getItem(KEY);
  if(saved) document.body.setAttribute('data-theme',saved);
  var btn=document.getElementById('vTheme');
  if(btn){btn.addEventListener('click',function(){var cur=document.body.getAttribute('data-theme')==='dark'?'light':'dark';document.body.setAttribute('data-theme',cur);localStorage.setItem(KEY,cur);});}
  var yi=document.getElementById('yamlIn'),jo=document.getElementById('jsonOut');
  function yamlToJson(y){
    var lines=y.replace(/\t/g,'  ').split('\n').filter(function(l){return l.trim() && !l.trim().startsWith('#');});
    var out=[], stack=[{indent:-1,arr:false,key:null,obj:{}}], cur=stack[0].obj;
    lines.forEach(function(line){
      var ind=0; while(line[ind]==' ') ind++;
      var body=line.slice(ind);
      while(stack.length>1 && ind<=stack[stack.length-1].indent){ stack.pop(); cur=stack[stack.length-1].obj; }
      var top=stack[stack.length-1];
      if(body.trimStart().startsWith('- ')){
        var v=body.trimStart().slice(2).trim();
        if(top.arr) top.arr.push(/^[a-z0-9_]+:/i.test(v)?'':parseVal(v));
      } else {
        var m=body.match(/^([\w\-]+)\s*:\s*(.*)$/);
        if(!m) return;
        var k=m[1], v=m[2].trim();
        if(v===''){
          var holder={indent:ind,arr:false,key:k,obj:{}};
          stack.push(holder); cur=k;
        } else {
          top.obj[k]=parseVal(v);
        }
      }
    });
    function parseVal(v){
      if(v==='true') return true;
      if(v==='false') return false;
      if(v==='null') return null;
      if(/^-?\d+$/.test(v)) return parseInt(v);
      if(/^-?\d*\.\d+$/.test(v)) return parseFloat(v);
      return v.replace(/^["']|["']$/g,'');
    }
    return JSON.stringify(cur,null,2);
  }
  function recalc(){ try{ jo.value=yamlToJson(yi.value);}catch(e){jo.value='// '+e.message;} }
  if(yi) yi.addEventListener('input',recalc);
  recalc();
})();
</script>
</body>
</html>