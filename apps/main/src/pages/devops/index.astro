---
import BaseLayout from '@versal/ui/BaseLayout';
import Hero from '@versal/ui/Hero.astro';
import ToolGrid from '@versal/ui/ToolGrid.astro';
import ToolCard from '@versal/ui/ToolCard.astro';

const tools = [
  { title: 'Base64 Encoder / Decoder', description: 'Encode any text to Base64, or decode Base64 back to text. Supports standard and URL-safe variants.', href: '/devops/tools/base64/' },
  { title: 'Basic Auth Header Generator', description: 'Generate HTTP Basic Auth headers from any username and password, and decode existing values back to credentials. Works with curl, Postman and API clients.', href: '/devops/tools/basic-auth-generator/' },
  { title: 'CIDR / Subnet Calculator', description: 'Calculate network address, broadcast, host ranges, masks, and address counts for any CIDR block. Runs entirely in your browser.', href: '/devops/tools/cidr-calculator/' },
  { title: 'Crontab Explainer', description: 'Translate a crontab expression into human-readable schedule and list the next 10 scheduled runs.', href: '/devops/tools/crontab/' },
  { title: 'Crontab Parser — Explain cron expressions', description: 'Translate crontab expressions (5-field or 6-field) into plain English and preview the next 10 run times. Works for Linux cron, Kubernetes CronJobs and CI.', href: '/devops/tools/cron-parser/' },
  { title: 'JSON Tree Viewer', description: 'Paste any JSON and explore it as a collapsible, color-coded tree — objects, arrays, keys, and values at a glance.', href: '/devops/tools/json-viewer/' },
  { title: 'Kubernetes YAML Generator', description: 'Scaffold Kubernetes Deployment, Service, and Ingress manifests from a small form. Copy the YAML straight into kubectl. Runs entirely in your browser.', href: '/devops/tools/k8s-generator/' },
  { title: 'Log Line Parser', description: 'Parse nginx, Apache, JSON, or custom-regex log lines into a color-coded table with stats. Runs entirely in your browser.', href: '/devops/tools/log-parser/' },
  { title: 'Number Base Converter', description: 'Convert between binary, octal, decimal, hex, and ASCII text with exact 64-bit BigInt math. Runs entirely in your browser.', href: '/devops/tools/number-base/' },
  { title: 'QR Code Generator — Create QR Codes Free', description: 'Generate QR codes for URLs, text, WiFi, contacts, and more. Customize size and colors. Download as PNG or SVG. 100% browser-based, nothing uploaded.', href: '/devops/tools/qr-code-generator/' },
  { title: 'Regex Tester — Test Regular Expressions', description: 'Test regular expressions with live match highlighting, capture groups and explanations. Supports JavaScript flags: global, case-insensitive and multiline.', href: '/devops/tools/regex/' },
  { title: 'Regex Tester with Explanations & Groups', description: 'Test JavaScript and Python regex with live match highlighting. See groups, indices, captured values and match counts, plus common pattern presets.', href: '/devops/tools/regex-advanced/' },
  { title: 'Unix Timestamp Converter', description: 'Convert Unix timestamps (seconds or milliseconds) to local or UTC dates and back. Auto-detects units, shows ISO 8601 and RFC 2822. Applies time offsets.', href: '/devops/tools/timestamp/' },
  { title: 'URL Encoder & Decoder', description: 'Percent-encode or decode URLs, query strings, form data and path segments. Supports full-URL and component encoding, plus hex and octal escapes. No upload.', href: '/devops/tools/url-codec/' },
  { title: 'UUID v4 Generator', description: 'Generate RFC 4122 UUID v4 identifiers — single or in bulk, uppercase, no-hyphen or URN format. Validate any UUID version and variant. 100% client-side.', href: '/devops/tools/uuid-generator/' },
  { title: 'YAML ↔ JSON Converter', description: 'Convert YAML to JSON and JSON to YAML. Pretty-print, validate, and minify. All in your browser.', href: '/devops/tools/yaml-json/' },
];
---

<BaseLayout site="devops" current="/devops/">
  <Hero
    overline="DevOps · operations tooling in your browser"
    sub="No signup, no upload. Every tool runs 100% locally — your configs, secrets and logs never leave your device."
  >
    DevOps tools that <span class="grad">run in your browser.</span>
    <Fragment slot="actions">
      <a class="button button-primary" href="/devops/tools/">Browse all devops tools</a>
      <a class="button button-ghost" href="/devops/tools/yaml-json/">Convert YAML ↔ JSON</a>
    </Fragment>
  </Hero>

  <div class="section-head">
    <span class="overline">DevOps toolkit</span>
    <h2>Convert, decode &amp; inspect</h2>
    <p>YAML/JSON, Base64, JWT, crontab, regex, CIDR, Kubernetes, nginx and more — all processed on-device.</p>
  </div>
  <ToolGrid tools={tools} />

  <div class="brand-strip">
    <h2>Related — from the jsonversal brand</h2>
    <div class="grid">
      <ToolCard title="JSON / LLM Tools" description="jsonversal — JSON to TypeScript, UUID v7, LLM token calculator." href="/tools/" />
      <ToolCard title="Code Generators" description="codegen — .gitignore, license, CI workflow generator." href="/codegen/" />
      <ToolCard title="Security Tools" description="sec — Hash, AES, password strength, CSP generator." href="/sec/" />
    </div>
  </div>
</BaseLayout>