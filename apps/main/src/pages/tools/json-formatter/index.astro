---
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'JSON Formatter & Validator';
const description = 'Pretty-print, validate, and minify JSON with configurable indentation, detailed error positions, and document statistics. Runs entirely in your browser.';
const howtos = [
  {
    name: 'How to format JSON in 3 steps',
    description: 'Format any JSON document with this free browser-based tool.',
    steps: [
      { name: 'Paste your JSON', text: 'Paste your raw or minified JSON into the input textarea above.' },
      { name: 'Choose indentation', text: 'Select 2 spaces, 4 spaces, or a tab character from the indent dropdown.' },
      { name: 'Click Format', text: 'Click Format to pretty-print your JSON. Use Minify to compress it back.' },
    ],
  },
];
const faqs = [
  {
    "question": "How do I format JSON online for free?",
    "answer": "Paste your JSON into the input box above and click Format. Choose 2 spaces, 4 spaces, or a tab. The formatter validates your JSON first — if it is invalid you will see the exact error with line and column. Everything runs in your browser, nothing is uploaded."
  },
  {
    "question": "Can I pretty print minified JSON?",
    "answer": "Yes. Paste any minified (single-line) JSON and click Format. The tool parses and re-serializes it with clean indentation, making nested structures readable while preserving data exactly."
  },
  {
    "question": "How do I validate JSON without uploading it?",
    "answer": "The tool validates JSON locally in your browser. If invalid, the error shows the exact line and column so you can jump straight to the problem. Nothing leaves your device."
  },
  {
    "question": "Can I minify JSON to a single line?",
    "answer": "Yes. Click Minify to strip all whitespace. Produces the smallest valid JSON, useful for API payloads, URL query parameters, or log entries."
  },
];
---

<BaseLayout
  site="main"
  title={title}
  description={description}
  canonical="https://jsonversal.com/tools/json-formatter/"
  current="/tools/json-formatter/"
  keywords={['JSON formatter', 'JSON validator', 'pretty print JSON', 'JSON minifier']}
  howtos={howtos}
  faqs={faqs}
>
  <ToolNav currentHref={Astro.url.pathname} />

  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-2">
    <h2 class="h2-card">Input JSON</h2>
    <label for="input" class="sr-only">JSON input</label>
    <textarea
      id="input"
      spellcheck="false"
      aria-label="JSON input"
      placeholder='{"id": 1, "name": "Ada", "active": true }'
    ></textarea>
    <div class="row mt-1">
      <div class="tool-group">
        <label class="text-muted" for="indent">Indent</label>
        <select id="indent" class="select-inline">
          <option value="2">2 spaces</option>
          <option value="4" selected>4 spaces</option>
          <option value="tab">Tab</option>
        </select>
      </div>
      <button class="primary" id="format">Format</button>
      <button class="ghost" id="minify">Minify</button>
      <button class="ghost" id="sample">Sample</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="out-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">Output</h2>
      <div class="row" style="gap:8px;">
        <span class="text-dim" id="stats" style="font-size:.85rem;"></span>
        <button class="ghost" id="copy">Copy</button>
      </div>
    </div>
    <pre id="output"></pre>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <h2 class="h2-error">Invalid JSON</h2>
    <pre id="err-out"></pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Paste JSON, pick an indentation, and click <strong>Format</strong> — the tool parses and re-serializes with your chosen indent.</li>
    <li><strong>Minify</strong> strips all whitespace to produce the smallest valid JSON.</li>
    <li>If the input is invalid, the error shows the exact line and column so you can jump straight to the problem.</li>
    <li>Statistics update automatically after each run.</li>
  </ul>

  <h2>About JSON Formatter & Validator</h2>
  <p class="text-muted">Formatting never changes the meaning of a document — it only re-serializes the parsed value. Use it before code review, API debugging, or sharing payloads. Minify when you need the smallest representation for a URL parameter or log entry. Since everything runs in your browser, sensitive configurations and private API responses stay on your device.</p>
</BaseLayout>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .tool-group { display: flex; align-items: center; gap: 8px; }
  textarea { min-height: 200px; }
  pre { min-height: 80px; max-height: 480px; overflow: auto; white-space: pre-wrap; word-break: break-word; }
  .select-inline {
    font-family: var(--font-mono);
    background: var(--surface-alt);
    border: 1px solid var(--border-input);
    color: var(--text);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: .9rem;
    cursor: pointer;
  }
</style>

<script is:inline>
(function () {
  function lineCol(text, pos) {
    var lines = text.slice(0, pos).split('\n');
    return { line: lines.length, col: lines[lines.length - 1].length + 1 };
  }

  function stats(v, d) {
    d = d || 1;
    var nodes = 0, keys = 0, depth = d;
    (function walk(x) {
      nodes++;
      if (x && typeof x === 'object') {
        if (Array.isArray(x)) x.forEach(walk);
        else { keys += Object.keys(x).length; Object.values(x).forEach(walk); }
      }
    })(v);
    return { nodes: nodes - 1, keys: keys, depth: depth };
  }

  function run(mode) {
    var raw = document.getElementById('input').value;
    if (!raw.trim()) { showToast('Paste some JSON first.'); return; }
    try {
      var obj = JSON.parse(raw);
      var choice = document.getElementById('indent').value;
      var indent = choice === 'tab' ? '\t' : parseInt(choice, 10);
      var out = JSON.stringify(obj, null, indent);
      document.getElementById('output').textContent = out;
      var s = stats(obj);
      document.getElementById('stats').textContent =
        s.keys + ' keys · ' + s.nodes + ' nodes · depth ' + s.depth + ' · ' + out.length + ' chars';
      document.getElementById('out-section').style.display = 'block';
      document.getElementById('err-section').style.display = 'none';
    } catch (e) {
      var msg = e.message || String(e);
      var m = msg.match(/position (\d+)/);
      if (m) {
        var lc = lineCol(raw, parseInt(m[1], 10);
        msg += ' (line ' + lc.line + ', column ' + lc.col + ')';
      }
      document.getElementById('err-out').textContent = msg;
      document.getElementById('err-section').style.display = 'block';
      document.getElementById('out-section').style.display = 'none';
    }
  }

  document.getElementById('format').addEventListener('click', function () { run('format'); });
  document.getElementById('minify').addEventListener('click', function () { run('minify'); });

  document.getElementById('copy').addEventListener('click', async function () {
    try {
      await navigator.clipboard.writeText(document.getElementById('output').textContent);
      var btn = document.getElementById('copy');
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = 'Copy'; }, 1200);
    } catch (e) {
      showToast('Copy failed.');
    }
  });

  document.getElementById('sample').addEventListener('click', function () {
    document.getElementById('input').value = JSON.stringify({ id: 1, name: 'Ada', active: true, scores: [98, 87], address: { city: 'New York', zip: 10001 }, tags: ['premium'] }, null, 2);
  });

  document.getElementById('clear').addEventListener('click', function () {
    document.getElementById('input').value = '';
    document.getElementById('out-section').style.display = 'none';
    document.getElementById('err-section').style.display = 'none';
  });
})();
</script>