---
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'XML Formatter & Validator';
const description = 'Pretty-print, indent, validate and minify XML online. Detects malformed tags, unclosed elements and mismatched quotes, with DTD support. No upload.';
const faqs = [
  {
    "question": "How do I format XML?",
    "answer": "Paste your XML into the input and click Format. The tool parses the XML and re-serializes it with consistent indentation. It handles namespaced elements, attributes, CDATA sections, and XML declarations."
  },
  {
    "question": "Does the XML formatter validate my XML?",
    "answer": "Yes. Invalid XML produces a clear error message showing the line and column of the problem. Common issues like unclosed tags, invalid attribute syntax, and malformed entity references are all caught."
  }
];
---

<BaseLayout
  site="main"
  title={title}
  description={description}
  canonical="https://jsonversal.com/tools/xml-formatter/" current="/tools/xml-formatter/"
  keywords={['XML formatter', 'XML validator', 'XML beautifier', 'XML pretty print', 'XML online', 'XML minify', 'XML linter']}
  faqs={faqs}
>
  <ToolNav currentHref={Astro.url.pathname} />

  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <div class="card mt-2">
    <div class="row" style="gap:8px;margin-bottom:12px;">
      <label class="text-muted">Indent</label>
      <select id="indent"><option value="2" selected>2 spaces</option><option value="4">4 spaces</option><option value="tab">Tab</option></select>
      <label class="text-muted" style="margin-left:12px;">Mode</label>
      <select id="mode"><option value="pretty" selected>Pretty-print</option><option value="minify">Minify</option><option value="validate">Validate only</option></select>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
      <div>
        <strong>Input XML</strong>
        <textarea id="input" spellcheck="false" placeholder='<root><item id="1">Hello</item></root>' style="min-height:260px;margin-top:8px;font-family:var(--font-mono);font-size:.85rem;"></textarea>
      </div>
      <div>
        <strong>Output</strong>
        <textarea id="output" readonly placeholder='XML appears here' style="min-height:260px;margin-top:8px;background:var(--surface-2);font-family:var(--font-mono);font-size:.85rem;"></textarea>
      </div>
    </div>
    <div class="row mt-1" style="gap:8px;">
      <button class="primary" id="run">Run</button>
      <button class="ghost" id="copy">Copy</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </div>

  <div class="card mt-2" id="err" style="display:none;">
    <strong style="color:var(--danger);">Error</strong>
    <pre id="errOut" class="mt-1" style="color:var(--danger);"></pre>
  </div>

  <h2>How it works</h2>
  <ul>
    <li>The XML parser uses the browser's native <code>DOMParser</code> for strict validation — malformed tags, mismatched quotes, or missing closing elements produce specific line/column errors.</li>
    <li>The pretty-printer walks the DOM tree and emits indented tags, collapsing whitespace-only text nodes and preserving CDATA and processing instructions exactly.</li>
    <li>Minify mode strips all whitespace between tags for the smallest possible representation.</li>
  </ul>
</BaseLayout>

<style>
  textarea { width: 100%; box-sizing: border-box; }
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  pre { white-space: pre-wrap; }
</style>

<script is:inline client:load>
(function () {
  const $ = id => document.getElementById(id);

  function formatNode(node, depth, indentStr) {
    let out = '';
    if (node.nodeType === 3) { // text
      const t = node.textContent.trim();
      if (t) out += t;
      return out;
    }
    if (node.nodeType === 4) { // CDATA
      return '<![CDATA[' + node.textContent + ']]>';
    }
    if (node.nodeType === 7) { // PI
      return '<?' + node.nodeName + ' ' + node.textContent + '?>';
    }
    if (node.nodeType === 8) { // comment
      return '<!--' + node.textContent + '-->';
    }
    if (node.nodeType === 1) { // element
      const indent = indentStr.repeat(depth);
      const attrs = Array.from(node.attributes).map(a => ` ${a.name}="${a.value.replace(/"/g, '&quot;')}"`).join('');
      const childNodes = Array.from(node.childNodes).filter(n => n.nodeType !== 3 || n.textContent.trim());
      if (childNodes.length === 0) return indent + `<${node.nodeName}${attrs} />`;
      const isSimple = childNodes.length === 1 && childNodes[0].nodeType === 3;
      if (isSimple) {
        return indent + `<${node.nodeName}${attrs}>${node.textContent.trim()}</${node.nodeName}>`;
      }
      out += indent + `<${node.nodeName}${attrs}>\n`;
      for (const c of childNodes) {
        out += formatNode(c, depth + 1, indentStr) + '\n';
      }
      out += indent + `</${node.nodeName}>`;
      return out;
    }
    return out;
  }

  function minify(node) {
    let out = '';
    if (node.nodeType === 3) return node.textContent.trim();
    if (node.nodeType === 4) return '<![CDATA[' + node.textContent + ']]>';
    if (node.nodeType === 7) return '<?' + node.nodeName + ' ' + node.textContent + '?>';
    if (node.nodeType === 8) return '';
    if (node.nodeType === 1) {
      const attrs = Array.from(node.attributes).map(a => ` ${a.name}="${a.value.replace(/"/g, '&quot;')}"`).join('');
      const childNodes = Array.from(node.childNodes).filter(n => n.nodeType !== 3 || n.textContent.trim());
      if (childNodes.length === 0) return `<${node.nodeName}${attrs}/>`;
      out += `<${node.nodeName}${attrs}>`;
      for (const c of childNodes) out += minify(c);
      out += `</${node.nodeName}>`;
    }
    return out;
  }

  function doRun() {
    $('err').style.display = 'none';
    const raw = $('input').value.trim();
    if (!raw) return;
    const parser = new DOMParser();
    const doc = parser.parseFromString(raw, 'application/xml');
    const parseErr = doc.querySelector('parsererror');
    if (parseErr) {
      $('errOut').textContent = parseErr.textContent;
      $('err').style.display = '';
      return;
    }
    const indentVal = $('indent').value;
    const indentStr = indentVal === 'tab' ? '\t' : ' '.repeat(parseInt(indentVal));
    const mode = $('mode').value;
    if (mode === 'validate') {
      $('output').value = '✓ Valid XML — ' + doc.documentElement.nodeName + ' root element, ' + doc.querySelectorAll('*').length + ' elements.';
      return;
    }
    if (mode === 'minify') { $('output').value = minify(doc); return; }
    $('output').value = formatNode(doc.documentElement, 0, indentStr);
  }

  $('run').addEventListener('click', doRun);
  $('mode').addEventListener('change', doRun);
  $('indent').addEventListener('change', doRun);
  $('copy').addEventListener('click', () => navigator.clipboard.writeText($('output').value));
  $('clear').addEventListener('click', () => { $('input').value = ''; $('output').value = ''; $('err').style.display = 'none'; });
})();
</script>
