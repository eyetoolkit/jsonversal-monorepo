---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolGrid from '@versal/ui/ToolGrid.astro';

const tools = [
  {
    title: 'LLM Token & Pricing Calculator',
    description: 'Estimate tokens and cost across GPT, Claude, Llama and Gemini.',
    href: '/tools/llm-token-calculator/',
  },
  {
    title: 'Structured Output JSON Schema Generator',
    description: 'Create strict JSON Schema for LLM structured output.',
    href: '/tools/json-schema-generator/',
  },
  {
    title: 'JSON Schema Sample Data Generator',
    description: 'Generate sample JSON that satisfies your schema.',
    href: '/tools/json-schema-sample-generator/',
  },
  {
    title: 'JSON to Pydantic Model',
    description: 'Generate Pydantic v2 BaseModel classes from JSON.',
    href: '/tools/json-to-pydantic/',
  },
  {
    title: 'JSON to Zod Schema',
    description: 'Infer a Zod validation schema from a JSON sample.',
    href: '/tools/json-to-zod/',
  },
  {
    title: 'JSON to TypeScript Interface',
    description: 'Generate type-safe TypeScript interfaces from JSON.',
    href: '/tools/json-to-typescript/',
  },
  {
    title: 'JSONPath Tester',
    description: 'Test JSONPath expressions against your JSON.',
    href: '/tools/jsonpath-tester/',
  },
  {
    title: 'JSON Diff',
    description: 'Compare two JSON documents and list the differences.',
    href: '/tools/json-diff/',
  },
  {
    title: 'JSON Formatter & Validator',
    description: 'Pretty-print, validate, and minify JSON with configurable indentation.',
    href: '/tools/json-formatter/',
  },
  {
    title: 'JSON to Go Struct',
    description: 'Generate Go structs with json tags from a JSON sample.',
    href: '/tools/json-to-go/',
  },
  {
    title: 'JSON to C# Class',
    description: 'Generate C# classes with Newtonsoft attributes from JSON.',
    href: '/tools/json-to-csharp/',
  },
  {
    title: 'UUID v7 Generator & Timestamp Decoder',
    description: 'Generate RFC 9562 UUID v7 and decode its timestamp.',
    href: '/tools/uuid-v7/',
  },
  {
    title: 'Markdown Editor & Live Preview',
    description: 'Write Markdown and see a rendered HTML preview as you type.',
    href: '/tools/markdown-preview/',
  },
  {
    title: 'Text Diff',
    description: 'Compare two texts with a side-by-side view and a git-style unified diff.',
    href: '/tools/text-diff/',
  },
  {
    title: 'JSON Escape & Unescape',
    description: 'Escape plain text into a JSON string literal, or decode it back.',
    href: '/tools/json-escape/',
  },
  {
    title: 'JSON Sorter & Deduper',
    description: 'Sort object keys and array items, and dedupe duplicate values.',
    href: '/tools/json-sorter/',
  },
];
---

<BaseLayout site="main" title="All Tools" current="/tools/">
  <div class="tool-head">
    <h1>Online Developer Tools</h1>
    <p class="desc">Every tool runs 100% in your browser. No signup, no upload, unlimited and free. Use the filter to find what you need.</p>
  </div>

  <ToolGrid tools={tools} />
</BaseLayout>