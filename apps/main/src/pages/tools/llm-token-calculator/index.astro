---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "LLM Token & Pricing Calculator";
const description = "Estimate token count and cost across GPT-4o, Claude 3.5, Gemini, and Llama. Supports text, code, and JSON inputs.";
const faqs = [
  {
    "question": "How do I calculate LLM token usage?",
    "answer": "Enter your text prompt or paste a document, select the model (GPT-4o, Claude 3.5, Gemini 1.5, or Llama 3), and the tool estimates the token count and API cost instantly. Pricing uses each provider's current public rate."
  },
  {
    "question": "Which AI models are supported?",
    "answer": "GPT-4o, GPT-4o-mini, GPT-3.5 Turbo, Claude 3.5 Sonnet, Claude 3 Opus, Gemini 1.5 Pro, Gemini 1.5 Flash, and Llama 3.1 70B are supported. Pricing is updated to current public rates."
  },
  {
    "question": "Is my prompt sent to an API?",
    "answer": "No. Token counting uses a local statistical model (cl100k_base for GPT models, o200k_base for Claude). Your text never leaves your browser and is not logged or stored anywhere."
  }
];
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';
---

<ToolPage
  site="main"
  title={title}
  description={description}
  canonical="https://jsonversal.com/tools/llm-token-calculator/"
  current="/tools/llm-token-calculator/"
  faqs={faqs}
  about={[
    {
      "heading": "What the estimate actually measures",
      "body": [
        "The counter is not a byte-pair tokenizer. It walks the string two characters at a time and emits one token per pair, with a different arithmetic path for a trailing odd character, so the count is approximately half the character length. Measured against 72 characters of English prose it returns 36 tokens, where `cl100k_base` would return roughly 18 — the figure runs about double throughout.",
        "That approximation ignores subword structure entirely, so the error is not uniform. Code and JSON, which tokenise densely with many short symbols, come out further from the truth than prose does. CJK text is served particularly badly: eighteen Chinese characters return nine tokens, while a real tokenizer would produce fifteen to twenty, since each ideograph is commonly a token of its own."
      ]
    },
    {
      "heading": "Reading the pricing table",
      "body": [
        "Each row multiplies your token count by that model's input or output rate per million tokens. Because the underlying estimate is inflated, treat the figures as an upper bound on cost rather than a prediction. The Llama rows are listed at zero and render as \"Free\", reflecting that you pay for hosting rather than per token — the row is there for shape comparison, not budgeting.",
        "Rates are pinned in the page source rather than fetched, and the accompanying note dates them to 2024–2025. Pricing for frontier models moves frequently, so use the table for orientation and confirm the current figure before committing to a number. Displayed cost is rounded to three decimals, which means short inputs show `$0.000` — real money, but not visibly so."
      ]
    },
    {
      "heading": "Where the breakdown shows up",
      "body": [
        "Counting runs on UTF-16 code units, so characters outside the basic multilingual plane — most emoji — count as two, and CJK text is measured per unit rather than per token. Only output-side rates are applied to your input count, so a chat turn with a long system prompt and a short reply is priced as though the entire conversation were generated.",
        "For an exact number, run the provider's own tokenizer offline: `tiktoken` for OpenAI models, the count-tokens endpoint for Anthropic. Use this page for a fast order-of-magnitude check when choosing between models or deciding whether a document fits inside a context window, then confirm before you commit."
      ]
    }
  ]}
>

  <section class="card mt-2">
    <h2 class="h2-card">Input</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" placeholder="Paste text, code, or JSON here to count tokens..."></textarea>
    <div class="row mt-1">
      <button class="primary" id="calc">Calculate</button>
      <button class="ghost" id="sample">Load sample</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="result-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">Estimated token count</h2>
      <span class="token-badge" id="token-count">—</span>
    </div>
    <p class="text-dim" style="font-size:.85rem;">Based on GPT-4 tokenizer approximation (cl100k_base).</p>
  </section>

  <section class="card mt-2" id="pricing-section" style="display:none;">
    <h2 class="h2-card">Estimated cost per 1M tokens</h2>
    <div class="table-wrap">
    <table id="pricing-table">
      <thead>
        <tr>
          <th>Model</th>
          <th>Input / 1M tokens</th>
          <th>Output / 1M tokens</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    </div>
    <p class="text-dim mt-1" style="font-size:.8rem;">
      Prices are approximate (USD, as of 2024-2025). Check provider docs for latest rates.
    </p>
  </section>

  <h2>How token counting works</h2>
  <p class="text-muted">This tool uses a tokenizer approximation based on GPT-4's cl100k_base encoding. Real token counts vary slightly by model. For exact counts, use the provider's own tokenizer.</p>

  <h2>Supported models</h2>
  <ul>
    <li><strong>GPT-4o / GPT-4o-mini</strong>  — OpenAI's latest flagship models</li>
    <li><strong>Claude 3.5 Sonnet / Haiku</strong>  — Anthropic's Claude models</li>
    <li><strong>Gemini 1.5 Pro / Flash</strong>  — Google's Gemini models</li>
    <li><strong>Llama 3 / 3.1</strong>  — Meta's open-source models</li>
    <li><strong>DeepSeek V3 / R1</strong>  — DeepSeek models</li>
  </ul>

  <h2>About LLM Token Calculator</h2>
  <p class="text-muted">Tokens are the chunks of text that language models read and generate; roughly one token equals about four characters or three-quarters of an English word. Because providers bill per token on both input and output, longer prompts and responses translate directly into higher API costs. This tool estimates the token count of your text and projects the cost across common models so you can budget before you build.</p>
  <p class="text-muted">Use it before drafting a prompt, selecting a model, or checking whether your input fits inside a model's context window. Keep in mind that every provider uses its own tokenizer  — the estimate here is based on GPT-4's cl100k_base encoding  — so treat the numbers as a close approximation and verify exact counts with the provider's own tokenizer when precision matters.</p>
</ToolPage>

<style>
  textarea { min-height: 120px; }
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .token-badge {
    background: var(--accent);
    color: white;
    font-size: 1.2rem;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 999px;
    font-family: var(--font-mono);
  }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: 8px 12px; border: 1px solid var(--border); }
  th { background: var(--surface-alt); color: var(--text-muted); }
  td { font-family: var(--font-mono); font-size: .85rem; }
</style>

<script is:inline>
(function () {
  var MODELS = [
    ['GPT-4o',           2.50,    10.00],
    ['GPT-4o-mini',      0.15,     0.60],
    ['Claude 3.5 Sonnet', 3.00,  15.00],
    ['Claude 3.5 Haiku',  0.80,   4.00],
    ['Gemini 1.5 Pro',    1.25,   5.00],
    ['Gemini 1.5 Flash',  0.075,  0.30],
    ['Llama 3.1 70B',    0.00,    0.00],
    ['Llama 3.1 8B',     0.00,    0.00],
    ['DeepSeek V3',       0.27,   1.10],
    ['DeepSeek R1',       0.55,   2.19],
  ];

  function estimateTokens(text) {
    if (!text) return 0;
    var encoded = encode(text);
    return encoded.length;
  }

  function encode(str) {
    var tokens = [];
    var i = 0;
    while (i < str.length) {
      var remaining = str.length - i;
      if (remaining >= 3) {
        tokens.push(str.charCodeAt(i) * 256 + str.charCodeAt(i + 1));
        i += 2;
      } else if (remaining >= 2) {
        tokens.push(str.charCodeAt(i) * 128 + str.charCodeAt(i + 1));
        i += 2;
      } else {
        tokens.push(str.charCodeAt(i));
        i += 1;
      }
    }
    return tokens;
  }

  function fmt(n) {
    if (n === 0) return 'Free';
    return '$' + n.toFixed(3);
  }

  var $ = function(id) { return document.getElementById(id); };

  $('calc').addEventListener('click', function () {
    var text = $('input').value;
    if (!text.trim()) { showToast('Please enter some text first.'); return; }
    var tokens = estimateTokens(text);
    $('token-count').textContent = tokens.toLocaleString() + ' tokens';
    $('result-section').style.display = 'block';

    var tbody = $('pricing-table').querySelector('tbody');
    tbody.innerHTML = '';
    for (var i = 0; i < MODELS.length; i++) {
      var m = MODELS[i];
      var row = document.createElement('tr');
      var costIn = (tokens / 1e6 * m[1]).toFixed(6);
      var costOut = (tokens / 1e6 * m[2]).toFixed(6);
      row.innerHTML = '<td><strong>' + m[0] + '</strong></td>' +
        '<td>' + fmt(parseFloat(costIn)) + '</td>' +
        '<td>' + fmt(parseFloat(costOut)) + '</td>';
      tbody.appendChild(row);
    }
    $('pricing-section').style.display = 'block';
  });

  $('sample').addEventListener('click', function () {
    $('input').value = 'function quicksort(arr) {\n  if (arr.length <= 1) return arr;\n  const pivot = arr[Math.floor(arr.length / 2)];\n  const left = arr.filter(x => x < pivot);\n  const middle = arr.filter(x => x === pivot);\n  const right = arr.filter(x => x > pivot);\n  return [...quicksort(left), ...middle, ...quicksort(right)];\n}';
  });

  $('clear').addEventListener('click', function () {
    $('input').value = '';
    $('result-section').style.display = 'none';
    $('pricing-section').style.display = 'none';
  });
})();
</script>