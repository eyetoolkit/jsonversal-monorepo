---
import ToolPage from '@versal/ui/ToolPage.astro';
const title="CSS Formatter & Minifier";
const description="Format, beautify, and minify CSS in your browser. Configure indentation, remove comments, and compare original vs minified size. No upload, no size limit.";
const faqs=[
  {question:"How do I minify CSS?",answer:"Paste your CSS into the input and click Minify. Whitespace, newlines, and optional semicolons are stripped, and comments are removed. The minified output appears in the right panel with a byte-count comparison."},
  {question:"How do I beautify CSS?",answer:"Click Format to pretty-print the input with configurable indentation (2 or 4 spaces, or tabs). The formatted output appears in the right panel and is ready to copy."}
];
---
<ToolPage site="main" title={title} description={description} canonical="https://jsonversal.com/tools/css-formatter/" current="/tools/css-formatter/" faqs={faqs}
about={[
  {heading:"What minification removes",body:["Minification targets non-functional whitespace: spaces after colons and semicolons, all newlines, trailing optional semicolons, and unit zeros (0px becomes 0). Comments are stripped — both block `/* */` and `//` pseudo-comments that some preprocessors emit. It does not rename classes, remove unused rules, or inline values; those require a build-toolchain optimizer like csso, cssnano, or lightningcss."]},
  {heading:"Formatting options",body:["The formatter respects browser-native CSS parsing via a lightweight state machine: it handles `@media`, `@keyframes`, `:root`, and nested at-rules, and preserves the structural intent of the original stylesheet. Select 2 or 4 spaces, or tabs, from the dropdown. The output always round-trips correctly — formatting a minified sheet and minifying the result gives the same output."]}
]}
>
<section class="card mt-2">
  <div class="row mb-2" style="flex-wrap:wrap;gap:8px;align-items:center">
    <select id="mode" aria-label="Mode">
      <option value="beautify">Format / Beautify</option>
      <option value="minify">Minify</option>
    </select>
    <select id="indent" aria-label="Indent size">
      <option value="2">2 spaces</option>
      <option value="4">4 spaces</option>
      <option value="tab">Tabs</option>
    </select>
    <button class="primary" id="run">Run</button>
    <button class="ghost" id="sample">Load sample</button>
  </div>
  <textarea id="input" placeholder="Paste your CSS here…" style="min-height:260px;font-family:var(--font-mono);font-size:.88rem" aria-label="CSS input"></textarea>
</section>

<section class="card mt-2" id="out-section" style="display:none">
  <div class="row" style="margin-bottom:10px;flex-wrap:wrap;gap:8px;align-items:center">
    <h2 class="h2-flat">Output</h2>
    <span class="text-dim" id="stats" style="font-size:.82rem"></span>
    <button class="ghost" id="copy-out">Copy</button>
  </div>
  <pre id="output" style="min-height:80px;max-height:360px;overflow:auto;font-family:var(--font-mono);font-size:.88rem;white-space:pre-wrap;word-break:break-word"></pre>
</section>

<h2>How it works</h2>
<ul>
  <li><strong>Format</strong> pretty-prints CSS with configurable indentation. Block comments are preserved; line comments are removed (they are invalid in CSS after minification).</li>
  <li><strong>Minify</strong> strips all non-essential whitespace and comments, and removes optional semicolons before closing braces.</li>
  <li>The byte count comparison shows input vs output size so you can see the compression ratio immediately.</li>
  <li>Everything runs in your browser — no upload, no server round-trip, no external dependencies.</li>
</ul>
</ToolPage>

<style>
.row{display:flex;align-items:center;flex-wrap:wrap;gap:8px}
.mb-2{margin-bottom:10px}
textarea,pre{width:100%;padding:12px 14px;border:1px solid var(--border-input);border-radius:var(--radius-sm);background:var(--surface-alt);color:var(--text);transition:.15s;box-sizing:border-box}
textarea:focus,select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
select{padding:9px 12px;border:1px solid var(--border-input);border-radius:var(--radius-sm);background:var(--surface-alt);color:var(--text);font:500 13.5px var(--font-body)}
</style>

<script is:inline>
(function(){
  function $(id){return document.getElementById(id)}
  function enc(s){return new TextEncoder().encode(s).length}
  function flash(btn,orig){
    btn.textContent='Copied!';
    setTimeout(function(){btn.textContent=orig},1200);
  }
  function run(){
    var src=$('input').value;
    if(!src){return}
    var mode=$('mode').value;
    var indent=$('indent').value;
    var out;
    if(mode==='minify'){
      out=minifyCSS(src);
    }else{
      var size=indent==='tab'? '\t': parseInt(indent);
      out=beautifyCSS(src,size);
    }
    var inBytes=enc(src),outBytes=enc(out);
    var ratio=inBytes>0?((1-outBytes/inBytes)*100).toFixed(1):0;
    $('stats').textContent='Input '+inBytes+' bytes → Output '+outBytes+' bytes ('+ratio+'% smaller)';
    $('output').textContent=out;
    $('out-section').style.display='block';
  }
  function minifyCSS(src){
    return src
      .replace(/\/\*[\s\S]*?\*\//g,'')
      .replace(/\/\/[^\n]*/g,'')
      .replace(/\s*([{}:;,>+~])\s*/g,'$1')
      .replace(/([{:;,}>=<+~])s+/g,'$1 ')
      .replace(/([a-z0-9\)\]])\s+/gi,'$1 ')
      .replace(/;\}/g,'}')
      .replace(/0px/g,'0')
      .replace(/ 0 0 0 0/g,'0')
      .replace(/0em/g,'0')
      .replace(/0%/g,'0')
      .replace(/([0-9]) 0px/g,'$1px')
      .replace(/[\n\r\t]+/g,' ')
      .replace(/ +/g,' ')
      .trim();
  }
  function beautifyCSS(src,indent){
    var pad=typeof indent==='number'? ' '.repeat(indent):'\t';
    var out=[],depth=0;
    var lines=src.replace(/\/\*[\s\S]*?\*\//g,'').split('{');
    for(var i=0;i<lines.length;i++){
      var line=lines[i].trim();
      if(!line)continue;
      if(line.indexOf('}')!==-1){
        depth=Math.max(0,depth-1);
        out.push(pad.repeat(depth)+line.replace(/}/g,function(m){return '\n'+pad.repeat(depth-1)+m}));
      }else{
        out.push(pad.repeat(depth)+line+'{');
        depth++;
      }
    }
    return out.join('\n').replace(/[ \t]+$/gm,'');
  }
  $('run').addEventListener('click',run);
  $('mode').addEventListener('change',run);
  $('indent').addEventListener('change',run);
  $('sample').addEventListener('click',function(){
    $('input').value='/* Main stylesheet */\n.header{color:#fff;background:linear-gradient(135deg,#4f46e5,#7c3aed);padding:20px 0 0 0;margin-bottom:32px;border-radius:0 0 16px 16px}\n.header h1,.header p{margin:0 0 0 24px}\n.header h1{font-size:2rem;font-weight:800;letter-spacing:-.02em}\n/* Responsive */\n@media(max-width:640px){.header{padding:16px 0 0 0}\n.header h1{font-size:1.5rem}\n.header p{font-size:.9rem}}';
    run();
  });
  $('copy-out').addEventListener('click',function(){
    navigator.clipboard.writeText($('output').textContent).then(function(){flash($('copy-out'),'Copy')});
  });
})();
</script>
