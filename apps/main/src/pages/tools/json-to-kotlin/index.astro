---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "JSON to Kotlin Data Class Generator";
const description = "Convert JSON into Kotlin data classes with typed, nullable-aware fields and List generics. Handles nesting and arrays. Runs entirely in your browser.";
const faqs = [
  {
    question: "Will the data classes serialise with kotlinx.serialization or Gson?",
    answer: "The output is plain Kotlin data classes with typed vals. With kotlinx.serialization you add @Serializable and @SerialName(\"key\") where a property name differs from its JSON key; with Gson, @SerializedName(\"key\") does the same. The field types already match the JSON values."
  },
  {
    question: "How are null and nullable fields handled?",
    answer: "A null value in the sample becomes `Any?`, because Kotlin cannot know the intended non-null type from a null alone. A property that is genuinely optional in your real data should be `Type?`; the generator marks only nulls as `Any?` and leaves every other field non-null."
  }
];
---

<ToolPage
  site="main"
  title={title}
  description={description}
  canonical="https://jsonversal.com/tools/json-to-kotlin/"
  current="/tools/json-to-kotlin/"
  faqs={faqs}
  about={[
    {
      heading: "Type inference",
      body: [
        "Integers become `Int`, widening to `Long` past 2,147,483,647; fractional numbers become `Double`; booleans become `Boolean`; strings become `String`. A JSON array becomes `List<T>`, folding object elements into one data class and collapsing primitives to their common type.",
        "A null in the sample becomes `Any?` — Kotlin has no JSON `null` representation, and a single null reveals nothing about the intended type, so `Any?` is the honest placeholder you then refine to the real type."
      ]
    },
    {
      heading: "Naming and structure",
      body: [
        "Each object becomes a `data class`, named after the key that held it with the first letter capitalised. Fields keep the JSON key as the property name when it is a legal Kotlin identifier; otherwise it is sanitised and you would add a serial name annotation.",
        "Data classes nest freely, so a deeply nested payload becomes a tree of small classes. Collisions across keys that capitalise alike get a numeric suffix rather than two classes with the same name."
      ]
    },
    {
      heading: "What you get",
      body: [
        "The output is a set of `data class` definitions — a ready-to-paste model layer skeleton, not a validation or adapter layer. You would add serialisation annotations and `Type?` for fields that are optional in production but were present in the sample.",
        "Conversion runs entirely in your browser: the JSON is parsed and walked by JavaScript, nothing is uploaded, and there is no server call."
      ]
    }
  ]}
>

  <section class="card mt-2">
    <h2 class="h2-card">Input JSON</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" placeholder='&#123;&#10;  "id": 42,&#10;  "name": "Alice",&#10;  "active": true,&#10;  "tags": ["a", "b"],&#10; "address": &#123; "city": "NYC", "zip": 10001 &#125;&#10;&#125;'></textarea>
    <div class="row mt-1">
      <button class="primary" id="convert">Generate Kotlin</button>
      <button class="ghost" id="sample">Load sample</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="output-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">Kotlin Data Classes</h2>
      <button class="ghost" id="copy" style="margin-left:auto;">Copy</button>
    </div>
    <pre id="output" class="output-text">—</pre>
  </section>

  <section class="card mt-2" id="error-section" style="display:none;">
    <h2 class="h2-error">Error</h2>
    <pre id="error-out" class="output-text" style="color:var(--danger);">—</pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Paste a JSON sample and click <strong>Generate Kotlin</strong>.</li>
    <li>Each object becomes a <code>data class</code>; arrays become <code>List&lt;T&gt;</code>; nulls become <code>Any?</code>.</li>
    <li>Nothing leaves your browser.</li>
  </ul>

  <h2>Type mapping</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>JSON value</th><th>Kotlin type</th></tr></thead>
    <tbody>
      <tr><td><code>42</code></td><td><code>Int</code> (or <code>Long</code>)</td></tr>
      <tr><td><code>3.14</code></td><td><code>Double</code></td></tr>
      <tr><td><code>"hi"</code></td><td><code>String</code></td></tr>
      <tr><td><code>true</code></td><td><code>Boolean</code></td></tr>
      <tr><td><code>null</code></td><td><code>Any?</code></td></tr>
      <tr><td><code>[&#123;...&#125;]</code></td><td><code>List&lt;Nested&gt;</code></td></tr>
    </tbody>
  </table>
  </div>

  <h2>About JSON to Kotlin</h2>
  <p class="text-muted">Kotlin data classes are the natural fit for JSON models, but hand-writing them for a nested payload is repetitive. This generator reads a sample and emits data classes you can paste into a model package, with types inferred from the values it sees.</p>
  <p class="text-muted">Inference reflects only the sample: a field missing from the sample is missing from the output, a null becomes <code>Any?</code>, and a heterogeneous array becomes <code>List&lt;Any&gt;</code>. Add serial-name annotations where your property names differ from the JSON keys.</p>
</ToolPage>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  textarea { min-height: 200px; }
  .output-text { min-height: 80px; white-space: pre; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: 8px 12px; border: 1px solid var(--border); }
  th { background: var(--surface-alt); color: var(--text-muted); }
  td code { background: none; border: none; padding: 0; font-size: .85rem; }
</style>

<script is:inline>
(function () {
  const $ = (id) => document.getElementById(id);
  function isPlainObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v); }
  function sanitize(raw, prefix) {
    let n = String(raw == null ? '' : raw).replace(/[^A-Za-z0-9_]/g, '_').replace(/^_+/, '');
    if (!n) n = prefix; return n;
  }
  function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

  function buildKotlin(root) {
    const decls = [];
    const used = new Set();

    function unique(base) {
      let n = sanitize(base, 'Item'); n = n.charAt(0).toUpperCase() + n.slice(1);
      let c = n, i = 2; while (used.has(c)) c = n + (i++); used.add(c); return c;
    }
    function mergeObjects(objs) {
      const r = {}; for (const o of objs) for (const [k, v] of Object.entries(o)) if (!(k in r)) r[k] = v; return r;
    }
    function elementType(arr, name) {
      const objs = []; const prims = new Set();
      for (const it of arr) {
        if (isPlainObject(it)) objs.push(it);
        else if (it !== null) { const t = scalar(it); if (t) prims.add(t); }
      }
      if (objs.length && prims.size === 0) return typeExpr(mergeObjects(objs), name);
      if (!objs.length && prims.size) return prims.size === 1 ? [...prims][0] : 'Any';
      return 'Any';
    }
    function scalar(v) {
      if (v === null) return null;
      if (typeof v === 'boolean') return 'Boolean';
      if (typeof v === 'number') return Number.isInteger(v) ? (Math.abs(v) > 2147483647 ? 'Long' : 'Int') : 'Double';
      if (typeof v === 'string') return 'String';
      return null;
    }
    function typeExpr(value, name) {
      if (value === null) return 'Any?';
      if (typeof value === 'boolean') return 'Boolean';
      if (typeof value === 'number') return Number.isInteger(value) ? (Math.abs(value) > 2147483647 ? 'Long' : 'Int') : 'Double';
      if (typeof value === 'string') return 'String';
      if (Array.isArray(value)) {
        if (value.length === 0) return 'List<Any>';
        return 'List<' + elementType(value, name) + '>';
      }
      if (isPlainObject(value)) { const tn = unique(name); decls.push(classDecl(value, tn)); return tn; }
      return 'Any';
    }
    function classDecl(obj, tn) {
      const entries = Object.entries(obj);
      if (entries.length === 0) return 'data class ' + tn + '()';
      const lines = entries.map(function ([k, v]) {
        const safe = sanitize(k, 'field');
        const t = v === null ? 'Any?' : typeExpr(v, capitalize(k));
        return '  val ' + safe + ': ' + t + ',';
      });
      return 'data class ' + tn + '(\n' + lines.join('\n') + '\n)';
    }

    const rootType = typeExpr(root, isPlainObject(root) ? 'Root' : 'Root');
    let out = decls.join('\n\n');
    if (!isPlainObject(root)) {
      const rn = unique('Root');
      const body = Array.isArray(root)
        ? '  val items: List<' + (root.length ? elementType(root, 'Item') : 'Any') + '>,'
        : '  val value: ' + (scalar(root) || 'Any') + ',';
      out = (out ? out + '\n\n' : '') + 'data class ' + rn + '(\n' + body + '\n)';
    }
    return out;
  }

  const input = $('input');
  const outputSection = $('output-section');
  const errorSection = $('error-section');
  const output = $('output');
  const errorOut = $('error-out');

  $('convert').addEventListener('click', function () {
    const raw = input.value.trim();
    if (!raw) { showToast('Paste some JSON first.'); return; }
    try {
      const obj = JSON.parse(raw);
      output.textContent = buildKotlin(obj);
      outputSection.style.display = 'block';
      errorSection.style.display = 'none';
    } catch (e) {
      errorOut.textContent = e.message;
      errorSection.style.display = 'block';
      outputSection.style.display = 'none';
    }
  });

  $('sample').addEventListener('click', function () {
    input.value = JSON.stringify({
      id: 42,
      name: "Alice",
      active: true,
      score: 91.5,
      tags: ["premium", "beta"],
      address: { city: "New York", zip: 10001 }
    }, null, 2);
  });

  $('clear').addEventListener('click', function () {
    input.value = '';
    outputSection.style.display = 'none';
    errorSection.style.display = 'none';
  });

  $('copy').addEventListener('click', async function () {
    try {
      await navigator.clipboard.writeText(output.textContent);
      $('copy').textContent = 'Copied!';
      setTimeout(() => $('copy').textContent = 'Copy', 1200);
    } catch {
      $('copy').textContent = 'Failed';
      setTimeout(() => $('copy').textContent = 'Copy', 1200);
    }
  });
})();
</script>
