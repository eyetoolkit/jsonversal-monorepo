---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "JSON to Rust Struct Generator";
const description = "Convert JSON into Rust structs with serde derives, snake_case fields, and Vec/Option types. Handles nesting and arrays. Runs entirely in your browser.";
const faqs = [
  {
    question: "Are the structs ready to deserialise with serde?",
    answer: "Yes. Every struct carries `#[derive(Debug, Clone, Serialize, Deserialize)]`, and a field whose name differs from its JSON key gets an explicit `#[serde(rename = \"key\")]`. Numbers are `i64`/`f64` and text is `String`, so the structs bind directly with serde_json."
  },
  {
    question: "How are null and missing fields handled?",
    answer: "A null in the sample becomes `serde_json::Value`, since Rust has no single JSON `null` type. For optional fields you would normally want `Option<T>`, but the generator cannot know the non-null type from a null alone, so it emits `Value` and you refine it. Fields absent from the sample are absent from the struct."
  }
];
---

<ToolPage
  site="main"
  title={title}
  description={description}
  canonical="https://jsonversal.com/tools/json-to-rust/"
  current="/tools/json-to-rust/"
  faqs={faqs}
  about={[
    {
      heading: "Type inference",
      body: [
        "JSON integers become `i64` and fractional numbers become `f64`; booleans become `bool` and strings become `String`. A JSON array becomes `Vec<T>`, where `T` is the merged element type — objects are folded into one struct and primitives are collapsed to their common type.",
        "A null value becomes `serde_json::Value`. This is deliberately honest: Rust has no JSON `null` type, and a single `null` in the sample gives no information about what the field should be when present, so `Value` is the safe placeholder you then specialise."
      ]
    },
    {
      heading: "Naming and rename attributes",
      body: [
        "Field names are snake_cased from the JSON key. When the key is not already snake_case — `userName`, `created-at` — the field is renamed to a valid Rust identifier and an explicit `#[serde(rename = \"originalKey\")]` is emitted so the wire format is preserved.",
        "Struct names come from the key that held the object, capitalised. Collisions across keys that capitalise alike get a numeric suffix rather than two structs with the same identifier."
      ]
    },
    {
      heading: "What you get",
      body: [
        "The output is a set of `struct` definitions plus the `use` lines serde needs. It is a starting point for a typed model, not a validation layer; you would add `#[serde(default)]`, `Option<T>` for genuinely optional fields, and custom `Deserialize` impls where the schema is loose.",
        "All conversion happens in your browser. The JSON is parsed and walked by JavaScript, nothing is transmitted, and there is no server in the path."
      ]
    }
  ]}
>

  <section class="card mt-2">
    <h2 class="h2-card">Input JSON</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" placeholder='&#123;&#10;  "id": 42,&#10;  "user_name": "Alice",&#10;  "active": true,&#10;  "items": [&#123; "sku": "x", "qty": 3 &#125;]&#10;&#125;'></textarea>
    <div class="row mt-1">
      <button class="primary" id="convert">Generate Rust</button>
      <button class="ghost" id="sample">Load sample</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="output-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">Rust Structs</h2>
      <button class="ghost" id="copy" style="margin-left:auto;">Copy</button>
    </div>
    <pre id="output" class="output-text">—</pre>
  </section>

  <section class="card mt-2" id="error-section" style="display:none;">
    <h2 class="h2-error">Error</h2>
    <pre id="error-out" class="output-text" style="color:var(--danger);">—</pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Paste a JSON sample and click <strong>Generate Rust</strong>.</li>
    <li>Each object becomes a <code>struct</code> with <code>#[derive(Serialize, Deserialize)]</code>; arrays become <code>Vec&lt;T&gt;</code>.</li>
    <li>Fields whose name differs from the JSON key get an explicit <code>#[serde(rename = "...")]</code>.</li>
    <li>Nothing leaves your browser.</li>
  </ul>

  <h2>Type mapping</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>JSON value</th><th>Rust type</th></tr></thead>
    <tbody>
      <tr><td><code>42</code></td><td><code>i64</code></td></tr>
      <tr><td><code>3.14</code></td><td><code>f64</code></td></tr>
      <tr><td><code>"hi"</code></td><td><code>String</code></td></tr>
      <tr><td><code>true</code></td><td><code>bool</code></td></tr>
      <tr><td><code>null</code></td><td><code>serde_json::Value</code></td></tr>
      <tr><td><code>[&#123;...&#125;]</code></td><td><code>Vec&lt;Nested&gt;</code></td></tr>
    </tbody>
  </table>
  </div>

  <h2>About JSON to Rust</h2>
  <p class="text-muted">rust-serde models are usually written by reading a JSON sample and transcribing it by hand, which is tedious for nested payloads. This generator walks the sample and emits structs you can drop into a module, complete with the derives and rename attributes serde needs.</p>
  <p class="text-muted">As with any sample-driven generator, inference reflects only what the sample shows. A null becomes <code>Value</code>, a heterogeneous array becomes <code>Vec&lt;Value&gt;</code>, and a missing field is simply absent. Refine optional fields to <code>Option&lt;T&gt;</code> once you know the real schema.</p>
</ToolPage>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  textarea { min-height: 200px; }
  .output-text { min-height: 80px; white-space: pre; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: 8px 12px; border: 1px solid var(--border); }
  th { background: var(--surface-alt); color: var(--text-muted); }
  td code { background: none; border: none; padding: 0; font-size: .85rem; }
</style>

<script is:inline>
(function () {
  const $ = (id) => document.getElementById(id);
  function isPlainObject(v) { return v !== null && typeof v === 'object' && !Array.isArray(v); }
  function snake(s) {
    return String(s)
      .replace(/([a-z0-9])([A-Z])/g, '$1_$2')
      .replace(/([A-Z]+)([A-Z][a-z])/g, '$1_$2')
      .replace(/[^A-Za-z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '')
      .toLowerCase();
  }
  function sanitize(raw, prefix) {
    let n = String(raw == null ? '' : raw).replace(/[^A-Za-z0-9_]/g, '_').replace(/^_+/, '');
    if (!n) n = prefix;
    return n;
  }

  function buildRust(root) {
    const decls = [];
    const used = new Set();
    let usesValue = false;
    let usesSerde = false;

    function unique(base) {
      let n = sanitize(base, 'Item');
      n = n.charAt(0).toUpperCase() + n.slice(1);
      let c = n, i = 2; while (used.has(c)) c = n + (i++); used.add(c); return c;
    }
    function mergeObjects(objs) {
      const r = {}; for (const o of objs) for (const [k, v] of Object.entries(o)) if (!(k in r)) r[k] = v; return r;
    }
    function elementType(arr, name) {
      const objs = []; const prims = new Set();
      for (const it of arr) {
        if (isPlainObject(it)) objs.push(it);
        else if (it !== null) { const t = scalar(it); if (t) prims.add(t); }
      }
      if (objs.length && prims.size === 0) return typeExpr(mergeObjects(objs), name);
      if (!objs.length && prims.size) return prims.size === 1 ? [...prims][0] : 'Value';
      usesValue = true; return 'Value';
    }
    function scalar(v) {
      if (v === null) return null;
      if (typeof v === 'boolean') return 'bool';
      if (typeof v === 'number') return Number.isInteger(v) ? 'i64' : 'f64';
      if (typeof v === 'string') return 'String';
      return null;
    }
    function typeExpr(value, name) {
      if (value === null) { usesValue = true; return 'Value'; }
      if (typeof value === 'boolean') return 'bool';
      if (typeof value === 'number') return Number.isInteger(value) ? 'i64' : 'f64';
      if (typeof value === 'string') return 'String';
      if (Array.isArray(value)) {
        if (value.length === 0) { usesValue = true; return 'Vec<Value>'; }
        return 'Vec<' + elementType(value, name) + '>';
      }
      if (isPlainObject(value)) {
        const tn = unique(name); decls.push(structDecl(value, tn)); return tn;
      }
      usesValue = true; return 'Value';
    }
    function structDecl(obj, tn) {
      const entries = Object.entries(obj);
      if (entries.length === 0) return '#[derive(Debug, Clone, Serialize, Deserialize)]\nstruct ' + tn + ' {}';
      const lines = entries.map(function ([k, v]) {
        const fname = snake(k) || sanitize(k, 'field');
        const t = v === null ? 'Value' : typeExpr(v, capitalize(k));
        if (v === null) usesValue = true;
        const rename = fname === k ? '' : '  #[serde(rename = "' + k + '")]\n';
        return rename + '  pub ' + fname + ': ' + t + ',';
      });
      return '#[derive(Debug, Clone, Serialize, Deserialize)]\nstruct ' + tn + ' {\n' + lines.join('\n') + '\n}';
    }
    function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

    let header = '';
    const rootType = typeExpr(root, isPlainObject(root) ? 'Root' : 'Root');
    let out = decls.join('\n\n');
    if (!isPlainObject(root)) {
      const rn = unique('Root');
      const body = Array.isArray(root)
        ? '  pub items: Vec<' + (root.length ? elementType(root, 'Item') : 'Value') + '>,'
        : '  pub value: ' + (scalar(root) || 'Value') + ',';
      out = (out ? out + '\n\n' : '') + '#[derive(Debug, Clone, Serialize, Deserialize)]\nstruct ' + rn + ' {\n' + body + '\n}';
    }
    usesSerde = true;
    if (usesSerde) header += 'use serde::{Serialize, Deserialize};\n';
    if (usesValue) header += 'use serde_json::Value;\n';
    return header + '\n' + out;
  }

  const input = $('input');
  const outputSection = $('output-section');
  const errorSection = $('error-section');
  const output = $('output');
  const errorOut = $('error-out');

  $('convert').addEventListener('click', function () {
    const raw = input.value.trim();
    if (!raw) { showToast('Paste some JSON first.'); return; }
    try {
      const obj = JSON.parse(raw);
      output.textContent = buildRust(obj);
      outputSection.style.display = 'block';
      errorSection.style.display = 'none';
    } catch (e) {
      errorOut.textContent = e.message;
      errorSection.style.display = 'block';
      outputSection.style.display = 'none';
    }
  });

  $('sample').addEventListener('click', function () {
    input.value = JSON.stringify({
      id: 42,
      user_name: "Alice",
      active: true,
      score: 91.5,
      items: [{ sku: "x-1", qty: 3 }, { sku: "x-2", qty: 1 }]
    }, null, 2);
  });

  $('clear').addEventListener('click', function () {
    input.value = '';
    outputSection.style.display = 'none';
    errorSection.style.display = 'none';
  });

  $('copy').addEventListener('click', async function () {
    try {
      await navigator.clipboard.writeText(output.textContent);
      $('copy').textContent = 'Copied!';
      setTimeout(() => $('copy').textContent = 'Copy', 1200);
    } catch {
      $('copy').textContent = 'Failed';
      setTimeout(() => $('copy').textContent = 'Copy', 1200);
    }
  });
})();
</script>
