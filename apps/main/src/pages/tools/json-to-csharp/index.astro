---
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';

const title = 'JSON to C# Class';
const description = 'Generate C# classes with Newtonsoft.Json attributes from a JSON sample. Handles nested classes, collections, and null fields. Runs entirely in your browser.';
const faqs = [
  {
    "question": "How do I convert JSON to C# classes?",
    "answer": "Paste your JSON into the input and click Generate. The tool outputs C# POCO (plain old CLR object) classes with Newtonsoft.Json attributes, compatible with System.Text.Json and JsonSerializer."
  },
  {
    "question": "Can I generate records instead of classes?",
    "answer": "Yes. Toggle between class and record output. Records are useful for immutable data models in C# 9+. Both formats include the necessary using statements and namespace."
  }
];
---

<BaseLayout
  site="main"
  title={title}
  description={description}
  canonical="https://jsonversal.com/tools/json-to-csharp/"
  keywords={['JSON to C# class', 'JSON to C#', 'generate C# from JSON', 'C# class generator', 'JSON to .NET', 'C# POCO from JSON', 'JSON to C# converter']}
  current="/tools/json-to-csharp/"
  faqs={faqs}
>
  <ToolNav currentHref={Astro.url.pathname} />

  <nav aria-label="Breadcrumb" class="crumbs">
    <a href="/">Home</a><span class="sep">·</span><a href="/tools/">Tools</a><span class="sep">·</span><span class="current">{title}</span>
  </nav>
  <h1>{title}</h1>
  <p class="text-muted">{description}</p>

  <section class="card mt-2">
    <h2 class="h2-card">Input JSON</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" spellcheck="false" placeholder='&#123;&#10;  "id": 42,&#10;  "name": "Alice",&#10;  "email": "alice@example.com",&#10;  "active": true&#10;&#125;'></textarea>
    <div class="row mt-1">
      <button class="primary" id="convert">Convert to C# Class</button>
      <button class="ghost" id="sample">Load sample</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="out-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">C# Class</h2>
      <button class="ghost" id="copy">Copy</button>
    </div>
    <pre id="output" class="mt-1">—</pre>
  </section>

  <section class="card mt-2" id="err-section" style="display:none;">
    <h2 class="h2-error">Error</h2>
    <pre id="err-out" class="mt-1" style="color:var(--danger);">—</pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Paste any valid JSON — classes are inferred from the values: numbers, strings, booleans, arrays, and nested objects.</li>
    <li>Whole numbers become <code>int</code>, decimals become <code>double</code>, and <code>null</code> becomes <code>object</code>.</li>
    <li>Arrays become <code>List&lt;T&gt;</code>; arrays of objects become <code>List&lt;Type&gt;</code>.</li>
    <li>Every property gets a <code>[JsonProperty("...")]</code> attribute so Newtonsoft.Json maps the original key exactly.</li>
  </ul>

  <h2>Type mapping rules</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>JSON value</th><th>C# type</th></tr></thead>
    <tbody>
      <tr><td><code>42</code></td><td><code>int</code></td></tr>
      <tr><td><code>3.14</code></td><td><code>double</code></td></tr>
      <tr><td><code>"hello"</code></td><td><code>string</code></td></tr>
      <tr><td><code>true</code> / <code>false</code></td><td><code>bool</code></td></tr>
      <tr><td><code>null</code></td><td><code>object</code></td></tr>
      <tr><td><code>[1, 2, 3]</code></td><td><code>List&lt;int&gt;</code></td></tr>
      <tr><td><code>[&#123;...&#125;, &#123;...&#125;]</code></td><td><code>List&lt;Type&gt;</code></td></tr>
      <tr><td><code>&#123;"a": 1&#125;</code></td><td><code>class</code></td></tr>
    </tbody>
  </table>
  </div>

  <h2>About JSON to C# Class</h2>
  <p class="text-muted">Deserializing JSON in .NET usually means writing POCO classes first, and hand-typing them for a large API response wastes time and invites typos. This tool generates plain C# classes from a JSON sample, complete with <code>[JsonProperty]</code> attributes so property names map back to the original keys — handy when the JSON uses snake_case, kebab-case, or abbreviations that differ from idiomatic C# property names. Nested objects become nested classes and arrays become <code>List&lt;T&gt;</code>.</p>
  <p class="text-muted">The output mirrors only what the sample shows: fields missing from the sample are absent from the class, and fields that appear as <code>null</code> become <code>object</code>. After generating, review the result and make value types nullable (<code>int?</code>) where a field can legitimately be absent, or switch to <code>System.Text.Json</code> by replacing the attributes with <code>[JsonPropertyName]</code>. Everything runs on your device, so private payloads stay private.</p>
</BaseLayout>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  textarea { min-height: 180px; }
  pre { min-height: 80px; max-height: 520px; overflow: auto; white-space: pre-wrap; word-break: break-word; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: 8px 12px; border: 1px solid var(--border); }
  th { background: var(--surface-alt); color: var(--text-muted); }
  td code { background: none; border: none; padding: 0; font-size: .85rem; }
</style>

<script is:inline>
(function () {
  const $ = id => document.getElementById(id);

  const defs = [];

  function pascal(s) {
    return s.replace(/[^a-zA-Z0-9]+/g, ' ').split(' ')
      .filter(Boolean)
      .map(w => w.charAt(0).toUpperCase() + w.slice(1))
      .join('');
  }

  function propName(key) {
    let n = pascal(key);
    if (!n) n = 'Property';
    return n;
  }

  function csType(v, key) {
    if (v === null) return 'object';
    if (typeof v === 'boolean') return 'bool';
    if (typeof v === 'number') return Number.isInteger(v) ? 'int' : 'double';
    if (typeof v === 'string') return 'string';
    if (Array.isArray(v)) {
      if (v.length === 0) return 'List<object>';
      const merged = {};
      let hasObj = false;
      const scalarTypes = new Set();
      for (const item of v) {
        if (item !== null && typeof item === 'object' && !Array.isArray(item)) {
          hasObj = true;
          for (const [k, val] of Object.entries(item)) {
            if (!(k in merged)) merged[k] = val;
          }
        } else {
          scalarTypes.add(csType(item, key));
        }
      }
      if (hasObj) {
        const t = propName(key) + 'Item';
        defs.push([t, merged]);
        return 'List<' + t + '>';
      }
      if (scalarTypes.size === 1) return 'List<' + [...scalarTypes][0] + '>';
      return 'List<object>';
    }
    if (typeof v === 'object') {
      const t = propName(key);
      defs.push([t, v]);
      return t;
    }
    return 'object';
  }

  function renderDef(name, obj) {
    const lines = [`public class ${name}`, '{'];
    for (const [k, v] of Object.entries(obj)) {
      lines.push('    [JsonProperty("' + k + '")]');
      lines.push('    public ' + csType(v, k) + ' ' + propName(k) + ' { get; set; }');
      lines.push('');
    }
    while (lines.length && lines[lines.length - 1] === '') lines.pop();
    lines.push('}');
    return lines.join('\n');
  }

  function convert(raw) {
    defs.length = 0;
    const obj = JSON.parse(raw);
    if (obj === null || typeof obj !== 'object' || Array.isArray(obj)) {
      throw new Error('Top-level value must be a JSON object.');
    }
    defs.push(['Root', obj]);
    const out = [];
    for (let i = 1; i < defs.length; i++) out.push(renderDef(defs[i][0], defs[i][1]));
    out.push(renderDef(defs[0][0], defs[0][1]));
    return out.join('\n\n');
  }

  $('convert').addEventListener('click', () => {
    const raw = $('input').value.trim();
    if (!raw) { showToast('Please paste some JSON first.'); return; }
    try {
      $('output').textContent = convert(raw);
      $('out-section').style.display = 'block';
      $('err-section').style.display = 'none';
    } catch (e) {
      $('err-out').textContent = e.message;
      $('err-section').style.display = 'block';
      $('out-section').style.display = 'none';
    }
  });

  $('copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText($('output').textContent);
      $('copy').textContent = 'Copied!';
      setTimeout(() => { $('copy').textContent = 'Copy'; }, 1200);
    } catch {}
  });

  $('sample').addEventListener('click', () => {
    $('input').value = JSON.stringify({
      id: 42,
      name: 'Alice',
      email: 'alice@example.com',
      active: true,
      balance: 99.5,
      score: null,
      roles: ['admin', 'editor'],
      address: { street: '123 Main St', city: 'New York', zip: 10001 },
      orders: [
        { id: 9001, total: 12.5, items: ['widget'] },
        { id: 9002, total: 3.0, items: [] }
      ]
    }, null, 2);
  });

  $('clear').addEventListener('click', () => {
    $('input').value = '';
    $('out-section').style.display = 'none';
    $('err-section').style.display = 'none';
  });
})();
</script>
