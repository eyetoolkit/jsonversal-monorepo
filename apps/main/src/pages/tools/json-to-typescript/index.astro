---
import ToolPage from '@versal/ui/ToolPage.astro';

const title = "JSON to TypeScript Interface";
const description = "Convert JSON data into clean TypeScript interfaces. Includes nested types, optional fields, arrays, and union types. Runs entirely in your browser.";
const faqs = [
  {
    "question": "How do I convert JSON to TypeScript types?",
    "answer": "Paste a JSON sample into the input and click Generate Types. The tool analyses the data types and structure, then outputs a TypeScript interface definition you can copy directly into your project."
  },
  {
    "question": "Are the types accurate?",
    "answer": "Types are inferred from your sample. Arrays get a union of all item types found. Optional keys are inferred from null values. For exact required vs optional fields, provide a representative JSON sample that covers all expected cases."
  }
];
import ToolNav from '@versal/ui/ToolNav.astro';
import BaseLayout from '@versal/ui/BaseLayout';
---

<ToolPage
  site="main"
  title={title}
  description={description}
  canonical="https://jsonversal.com/tools/json-to-typescript/"
  current="/tools/json-to-typescript/"
  faqs={faqs}
  about={[
    {
      "heading": "How interfaces are derived",
      "body": [
        "The generator emits named `interface` declarations rather than inline type literals, so a nested object becomes its own interface referenced by name. Names come from capitalising the first character of the key, which leaves `user_name` as `user_name` — unlike the Go and C# generators, underscores and inner casing are preserved exactly, so the output mirrors the wire format without needing a mapping layer.",
        "Arrays of objects are handled by merging every element into one shape, the first value winning for any key that appears with differing types across elements, then annotating the field with that merged interface. Keys that are not legal identifiers are emitted as quoted string keys, which TypeScript accepts without complaint."
      ]
    },
    {
      "heading": "Optionality and unions",
      "body": [
        "A `null` value produces an optional property typed `null`, so the field is both optional and useless for further access — replace it with the union you actually expect, such as `string | null`. Nothing else is marked optional automatically, and that is the more common failure: a field absent from your sample is simply missing from the interface, and a sample rarely covers every response variant an API can produce.",
        "The `Make all optional` button rewrites property lines with a regular expression matching an identifier followed by a colon. Quoted keys are skipped, so a schema containing keys like `odd-key` will only have its plain-identifier fields made optional. The button decides which direction to toggle by checking whether the output already contains `?:`, so pressing it twice returns to the original state."
      ]
    },
    {
      "heading": "Arrays, unions and name collisions",
      "body": [
        "An array of objects produces one merged element interface — every element is folded into a single shape, with the first value winning for any key that appears with differing types across elements — and the field is annotated `Element[]`. A heterogeneous array becomes a parenthesised union, `(number | string | Mixed)[]`, so the brackets bind to the whole union rather than to its last member. An empty array becomes `unknown[]`, and an empty object becomes a `type X = Record<string, unknown>` alias rather than an empty interface.",
        "Interface names are derived from the key, capitalised, so two keys that capitalise alike — `items` and `Items` — would declare the same identifier twice. A suffix is appended instead, and a key that is not a legal identifier is stripped to one that is, so `odd-key` yields `Oddkey`. Inferring from a sample remains the core caveat: when you need an exact contract rather than a starting point, write the interface against the JSON Schema Validator output."
      ]
    }
  ]}
>

  <section class="card mt-2">
    <h2 class="h2-card">Input JSON</h2>
    <label for="input" class="sr-only">Input</label>
    <textarea id="input" placeholder='&#123;&#10;  "id": 42,&#10;  "name": "Alice",&#10;  "email": "alice@example.com",&#10;  "active": true&#10;&#125;'></textarea>
    <div class="row mt-1">
      <button class="primary" id="convert">Convert to TypeScript</button>
      <button class="ghost" id="sample">Load sample</button>
      <button class="ghost" id="clear">Clear</button>
    </div>
  </section>

  <section class="card mt-2" id="output-section" style="display:none;">
    <div class="row" style="margin-bottom:12px;">
      <h2 class="h2-flat">TypeScript Interface</h2>
      <div class="row" style="gap:8px;">
        <button class="ghost" id="copy-ts">Copy</button>
        <button class="ghost" id="toggle-optional">Make all optional</button>
      </div>
    </div>
    <pre id="output" class="mt-1">—</pre>
  </section>

  <section class="card mt-2" id="error-section" style="display:none;">
    <h2 class="h2-error">Error</h2>
    <pre id="error-out" class="mt-1" style="color:var(--danger);">—</pre>
  </section>

  <h2>How it works</h2>
  <ul>
    <li>Paste any valid JSON on the left.</li>
    <li>Click <strong>Convert to TypeScript</strong>  — the interface appears instantly.</li>
    <li>All types are inferred from the JSON values: numbers, strings, booleans, arrays, objects, and <code>null</code>.</li>
    <li>Click <strong>Make all optional</strong> to prefix every field with <code>?</code>.</li>
  </ul>

  <h2>Type mapping rules</h2>
  <div class="table-wrap">
  <table>
    <thead><tr><th>JSON value</th><th>TypeScript type</th></tr></thead>
    <tbody>
      <tr><td><code>42</code>, <code>3.14</code></td><td><code>number</code></td></tr>
      <tr><td><code>"hello"</code></td><td><code>string</code></td></tr>
      <tr><td><code>true</code> / <code>false</code></td><td><code>boolean</code></td></tr>
      <tr><td><code>null</code></td><td><code>null</code></td></tr>
      <tr><td><code>[1, 2, 3]</code></td><td><code>number[]</code></td></tr>
      <tr><td><code>[&#123;...&#125;, &#123;...&#125;]</code> (array of objects)</td><td><code>NestedType[]</code></td></tr>
      <tr><td><code>&#123;"a": 1&#125;</code></td><td><code>NestedObject &#123; a: number &#125;</code></td></tr>
    </tbody>
  </table>
  </div>

  <h2>About JSON to TypeScript Interface</h2>
  <p class="text-muted">Generating TypeScript interfaces from JSON turns raw data samples into compile-time-checked type definitions. It is especially useful when consuming third-party APIs, database records, or LLM responses where you know the shape of the data but do not want to type it out by hand. This tool infers interfaces, nested types, arrays, and unions directly from the JSON you paste.</p>
  <p class="text-muted">Use it whenever you need a quick, accurate type for a JSON payload, or as a starting point that you then refine. Keep in mind that inferred types reflect only what the sample shows: fields absent from the sample are missing from the interface, null values become optional fields, and heterogeneous arrays become union types  — so inspect the output and add optional fields or generics where your real data varies.</p>
</ToolPage>

<style>
  .row { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  textarea { min-height: 180px; }
  pre { min-height: 80px; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .9rem; }
  th, td { text-align: left; padding: 8px 12px; border: 1px solid var(--border); }
  th { background: var(--surface-alt); color: var(--text-muted); }
  td code { background: none; border: none; padding: 0; font-size: .85rem; }
</style>

<script is:inline>
(function () {
  // Returns a type expression for `value`. Any named interface it needs is
  // appended to `decls`, children before parents, so every name it references
  // is also declared.
  function jsonToTs(root, rootName) {
    rootName = rootName || 'RootObject';
    const decls = [];
    const used = new Set();

    function isPlainObject(v) {
      return v !== null && typeof v === 'object' && !Array.isArray(v);
    }

    function ensureUnique(base) {
      let candidate = base, i = 2;
      while (used.has(candidate)) candidate = base + (i++);
      used.add(candidate);
      return candidate;
    }

    // Interface names come from key names, so collisions are possible
    // (`items` and `Items` both capitalise to `Items`). Suffix instead of
    // emitting two declarations with the same identifier.
    function unique(base) {
      let n = String(base == null ? '' : base).replace(/[^A-Za-z0-9_$]/g, '');
      if (!n || !/^[A-Za-z_$]/.test(n)) n = 'Item' + n;
      return ensureUnique(n.charAt(0).toUpperCase() + n.slice(1));
    }

    function mergeObjects(objs) {
      const result = {};
      for (const obj of objs) {
        for (const [k, v] of Object.entries(obj)) {
          if (!(k in result)) result[k] = v;
        }
      }
      return result;
    }

    function typeExpr(value, name) {
      if (value === null) return 'null';
      if (typeof value === 'boolean') return 'boolean';
      if (typeof value === 'number') return 'number';
      if (typeof value === 'string') return 'string';
      if (Array.isArray(value)) {
        if (value.length === 0) return 'unknown[]';
        const seen = [];
        const objects = [];
        for (const item of value) {
          if (isPlainObject(item)) {
            objects.push(item);
          } else {
            const t = typeExpr(item, '');
            if (seen.indexOf(t) === -1) seen.push(t);
          }
        }
        if (objects.length > 0) {
          const inner = typeExpr(mergeObjects(objects), name);
          if (seen.indexOf(inner) === -1) seen.push(inner);
        }
        const joined = seen.length === 1 ? seen[0] : '(' + seen.join(' | ') + ')';
        return joined + '[]';
      }
      if (isPlainObject(value)) {
        const typeName = unique(name);
        decls.push(objectDecl(value, typeName));
        return typeName;
      }
      return 'unknown';
    }

    function objectDecl(obj, typeName) {
      const entries = Object.entries(obj);
      if (entries.length === 0) return 'type ' + typeName + ' = Record<string, unknown>;';
      let s = 'interface ' + typeName + ' {\n';
      for (const [k, v] of entries) {
        const safeKey = /^[a-zA-Z_$][a-zA-Z0-9_$]*$/.test(k) ? k : JSON.stringify(k);
        const isOpt = v === null;
        const t = isOpt ? 'null' : typeExpr(v, capitalize(k));
        s += '  ' + safeKey + (isOpt ? '?: ' : ': ') + t + ';\n';
      }
      return s + '}';
    }

    const rootType = typeExpr(root, isPlainObject(root) ? rootName : rootName + 'Item');
    let out = decls.join('\n\n');
    if (!isPlainObject(root)) {
      // A scalar or array root has no interface of its own; emit a named alias
      // so the output is a complete, usable declaration set.
      out = (out ? out + '\n\n' : '') + 'type ' + ensureUnique(rootName) + ' = ' + rootType + ';';
    }
    return out;
  }

  function capitalize(s) {
    return s.charAt(0).toUpperCase() + s.slice(1);
  }

  function makeAllOptional(code) {
    return code.replace(/^(\s*)(\w[\w\d]*)\s*:/gm, '$1$2?:');
  }

  const $ = (id) => document.getElementById(id);
  const input = $('input');
  const outputSection = $('output-section');
  const errorSection = $('error-section');
  const output = $('output');
  const errorOut = $('error-out');

  $('convert').addEventListener('click', function () {
    const raw = input.value.trim();
    if (!raw) { showToast('Please paste some JSON first.'); return; }
    try {
      const obj = JSON.parse(raw);
      const ts = jsonToTs(obj, 'RootObject');
      output.textContent = ts;
      outputSection.style.display = 'block';
      errorSection.style.display = 'none';
    } catch (e) {
      errorOut.textContent = e.message;
      errorSection.style.display = 'block';
      outputSection.style.display = 'none';
    }
  });

  $('sample').addEventListener('click', function () {
    input.value = JSON.stringify({
      id: 42,
      name: "Alice",
      email: "alice@example.com",
      active: true,
      age: null,
      scores: [98, 87, 95],
      address: {
        street: "123 Main St",
        city: "New York",
        zip: 10001
      },
      tags: ["premium", "beta-tester"]
    }, null, 2);
  });

  $('clear').addEventListener('click', function () {
    input.value = '';
    outputSection.style.display = 'none';
    errorSection.style.display = 'none';
  });

  $('copy-ts').addEventListener('click', async function () {
    try {
      await navigator.clipboard.writeText(output.textContent);
      $('copy-ts').textContent = 'Copied!';
      setTimeout(() => $('copy-ts').textContent = 'Copy', 1200);
    } catch {
      $('copy-ts').textContent = 'Failed';
      setTimeout(() => $('copy-ts').textContent = 'Copy', 1200);
    }
  });

  $('toggle-optional').addEventListener('click', function () {
    const original = output.textContent;
    if (original.includes('?:')) {
      output.textContent = original.replace(/^(\s*)(\w[\w\d]*)\?:/gm, '$1$2:');
      $('toggle-optional').textContent = 'Make all optional';
    } else {
      output.textContent = makeAllOptional(original);
      $('toggle-optional').textContent = 'Undo optional';
    }
  });
})();
</script>