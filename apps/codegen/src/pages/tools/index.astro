---
import BaseLayout from '@versal/ui/BaseLayout';
import ToolCard from '@versal/ui/ToolCard.astro';

const tools = [
  { title: '.gitignore Generator', description: 'Pick languages and frameworks, download a templated .gitignore.', href: '/tools/gitignore/' },
  { title: 'License Generator', description: 'MIT, Apache, GPL, BSD, MPL, Unlicense — pick one, fill year/name.', href: '/tools/license/' },
  { title: 'README Skeleton', description: 'Build a professional README with badges, sections, CI info.', href: '/tools/readme/' },
  { title: 'GitHub Actions Workflow', description: 'Scaffold CI workflows for Node / Python / Go / Rust / Docker.', href: '/tools/ci-workflow/' },
  { title: 'JSON to Python', description: 'Turn a JSON sample into a Python dict literal.', href: '/tools/json-to-python/' },
  { title: 'cURL to Fetch', description: 'Convert curl commands into modern fetch() code.', href: '/tools/curl-to-fetch/' },
  { title: '.env Template Generator', description: 'Generate an .env template from JSON or key: value pairs.', href: '/tools/env-generator/' },
  { title: 'Conventional Commit', description: 'Format commit messages as feat/fix/chore with scope and body.', href: '/tools/commit-msg/' },
];
---
<BaseLayout site="codegen" title="All Code Generators" current="/tools/">
  <h1>Code Generators</h1>
  <p class="text-muted">Every generator runs in your browser. Templates bundled locally — nothing uploaded.</p>
  <div class="grid">
    {tools.map(tool => <ToolCard {...tool} />)}
  </div>
</BaseLayout>