---
import '@versal/ui/styles';
import { tokens, sitesSEO } from '@versal/ui';
import Header from '@versal/ui/Header.astro';
import Footer from '@versal/ui/Footer.astro';
import ConsentBanner from '@versal/ui/ConsentBanner.astro';
import SearchModal from '@versal/ui/SearchModal.astro';
import RecentTools from '@versal/ui/RecentTools.astro';

export interface Props {
  site: 'main' | 'devops' | 'codegen' | 'sec';
  title?: string;
  description?: string;
  canonical?: string;
  current?: string;
  keywords?: string[];
  /**
   * FAQ 数组 —— 同时用于可见折叠区块和 FAQPage JSON-LD Rich Results
   */
  faqs?: Array<{ question: string; answer: string }>;
  /**
   * HowTo 数组 —— 分步指南结构化数据（如 "How to format JSON in 3 steps"）
   * 每项包含 name + steps（每步有 name + text）
   */
  howtos?: Array<{
    name: string;
    description?: string;
    steps: Array<{ name: string; text: string }>;
  }>;
  /**
   * 是否展示"最近使用工具"区块（默认 false；只在首页等需要复访入口的页面开启）
   */
  showRecent?: boolean;
}

const {
  site,
  title,
  description,
  canonical,
  current,
  keywords,
  faqs,
  howtos,
  showRecent = false,
} = Astro.props as Props;

const seo = sitesSEO[site];
const t = tokens.sites[site];
const pageTitle = title ? `${title} | ${t.name}` : seo.title;
const pageDesc = description || seo.description;
const pageUrl = canonical || seo.canonical;
const pageKeywords = keywords?.join(', ') || seo.keywords;

// 静态 favicon —— 按子站选对应的 SVG 文件（浏览器可缓存）
const faviconHref = `/favicon-${site}.svg`;

// ===== SEO 结构化数据：WebApplication + BreadcrumbList + FAQPage =====

// 1. WebApplication schema —— 每个页面都有
const waSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title || t.name,
  "alternateName": t.name,
  "description": pageDesc,
  "url": pageUrl,
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires a modern web browser with JavaScript enabled",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "inLanguage": "en",
  "isAccessibleForFree": true
};

// 2. BreadcrumbList —— 根据 current 路径自动推断（工具页专属）
function buildBreadcrumbs() {
  if (!current) return null;
  const rootMap: Record<string, { label: string; url: string }> = {
    tools:   { label: 'Tools',           url: 'https://jsonversal.com/tools/' },
    sec:     { label: 'Security',         url: 'https://jsonversal.com/sec/' },
    devops:  { label: 'DevOps',           url: 'https://jsonversal.com/devops/' },
    codegen: { label: 'Code Generators',  url: 'https://jsonversal.com/codegen/' },
  };
  // "/tools/json-formatter/" → ['tools', 'json-formatter']
  const segments = current.split('/').filter(Boolean);
  // landing 页自身不生成面包屑
  if (segments.length <= 1) return null;
  
  const items: Array<{label: string, url?: string}> = [
    { label: 'Home', url: 'https://jsonversal.com/' },
  ];
  
  // 第 1 段：根栏目或 "tools"
  if (segments[0] === 'tools') {
    items.push(rootMap.tools);
  } else if (rootMap[segments[0]]) {
    items.push(rootMap[segments[0]]);
    // 第 2 段如果是 "tools"（子栏目的工具 landing），也加进去
    if (segments[1] === 'tools') {
      items.push({ label: 'Tools', url: `${rootMap[segments[0]].url}tools/` });
    }
  }
  
  // 当前页面 label —— 用 prop title 或最后一段 slug
  const lastSeg = segments[segments.length - 1];
  const pageLabel = title || lastSeg.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  items.push({ label: pageLabel });
  
  return items.map((it, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": it.label,
    ...(it.url ? { "item": it.url } : {})
  }));
}

const breadcrumbList = buildBreadcrumbs();

// 3. FAQPage —— 仅当 faqs prop 有值
const faqSchema = faqs && faqs.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
} : null;

// 4. HowTo —— 分步指南（如 "How to format JSON in 3 steps"）
const howtosSchema = howtos && howtos.length ? howtos.map(h => ({
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": h.name,
  ...(h.description ? { "description": h.description } : {}),
  "step": h.steps.map((s, i) => ({
    "@type": "HowToStep",
    "position": i + 1,
    "name": s.name,
    "text": s.text,
  }))
})) : [];

// 5. 合并所有 schema 到 @graph
const schemaEntries = [waSchema];
if (breadcrumbList) schemaEntries.push({ "@type": "BreadcrumbList", itemListElement: breadcrumbList });
if (faqSchema) schemaEntries.push(faqSchema);
if (howtosSchema.length) schemaEntries.push(...howtosSchema);

const jsonLd = schemaEntries.length > 1
  ? { "@context": "https://schema.org", "@graph": schemaEntries }
  : waSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="JSONversal" />
    <link rel="canonical" href={pageUrl} />

    {/* Open Graph */}
    <meta property="og:type" content={seo.og.type} />
    <meta property="og:site_name" content={seo.og.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jsonversal" />
    <meta name="twitter:creator" content="@jsonversal" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    {seo.og.image && <meta property="og:image" content={seo.og.image} />}
    {seo.og.image && <meta name="twitter:image" content={seo.og.image} />}
    {seo.og.image && <meta property="og:image:width" content="1200" />}
    {seo.og.image && <meta property="og:image:height" content="630" />}
    {seo.og.image && <meta name="twitter:image:alt" content={`${t.name} — free browser-based developer tools`} />}

    {/* Theme color —— 随主题切换（由下方内联脚本同步更新） */}
    <meta name="theme-color" content="#0b0d12" id="meta-theme-color" />

    {/* 搜索 & 浏览器提示 */}
    <meta name="robots" content="index, follow" />
    <meta name="color-scheme" content="dark light" />

    {/* favicon —— 品牌 SVG（按子站 accent 色） */}
    <link rel="icon" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />

    {/* 自托管字体预加载 —— 仅 preload 首屏必需的正文字体；
        Mono/Italic 由 @font-face + font-display: swap 按需加载，避免与 CSS/主文档竞争带宽 */}
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />

    {/* 主题初始化 —— 必须内联且在 <head>，避免首屏闪烁（FOUC）。
        优先级：用户手动选择（localStorage）> 系统 prefers-color-scheme。
        未选择时跟随系统，并在系统主题变化时实时同步。 */}
    <script is:inline>
      (function () {
        var KEY = 'versal-theme';
        var root = document.documentElement;
        var meta = document.getElementById('meta-theme-color');
        function systemTheme() {
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        function stored() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) { return null; }
        }
        function paint(theme) {
          root.setAttribute('data-theme', theme);
          if (meta) meta.setAttribute('content', theme === 'light' ? '#ffffff' : '#0b0d12');
        }
        paint(stored() || systemTheme());

        window.__versalTheme = {
          key: KEY,
          current: function () { return root.getAttribute('data-theme') || 'dark'; },
          /* 手动切换：写入 localStorage，之后不再跟随系统 */
          set: function (theme) { paint(theme); try { localStorage.setItem(KEY, theme); } catch (e) {} },
          /* 清除手动选择，回到跟随系统 */
          reset: function () { try { localStorage.removeItem(KEY); } catch (e) {} paint(systemTheme()); }
        };

        if (window.matchMedia) {
          var mq = window.matchMedia('(prefers-color-scheme: light)');
          var onChange = function () { if (!stored()) paint(systemTheme()); };
          if (mq.addEventListener) mq.addEventListener('change', onChange);
          else if (mq.addListener) mq.addListener(onChange);
        }
      })();
    </script>

    {/* JSON-LD —— @graph 合并 WebApplication + BreadcrumbList + FAQPage（Rich Results） */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    {/* 子站可插入额外的 <head> 内容（如页面级结构化数据） */}
    <slot name="head" />
  </head>
  <body class={`site-${site}`}>
    <a class="skip-link" href="#main">Skip to content</a>

    {/* Toast 容器 —— 非阻塞通知，替代原生 alert() */}
    <div id="toast-container" role="region" aria-live="polite" aria-label="Notifications" class="toast-container"></div>

    <Header site={site} current={current} />
    <main class="container" id="main">
      <slot />

      {/* FAQ 折叠区块 —— 同时满足可访问性（<details>）和 SEO（FAQPage JSON-LD 已在 head）
          仅当工具页通过 faqs prop 传入了问答时才渲染 */}
      {faqs && faqs.length > 0 && (
        <section class="faq-block mt-3" aria-labelledby="faq-title">
          <h2 id="faq-title">Frequently Asked Questions</h2>
          <div class="faq-list">
            {faqs.map(f => (
              <details class="faq-item">
                <summary>{f.question}</summary>
                <div class="faq-answer">{f.answer}</div>
              </details>
            ))}
          </div>
        </section>
      )}

      {/* 隐私承诺 —— 所有工具页共享的差异化卖点 */}
      <section class="privacy-promise mt-3">
        <div class="privacy-badge">
          <span class="lock-icon">🔒</span>
          <div>
            <strong>Your data never leaves your device</strong>
            <p>All processing happens in your browser. No uploads, no tracking, no servers. Your API keys, configs, and private payloads stay private — 100% client-side.</p>
          </div>
        </div>
      </section>
    </main>
    <Footer site={site} />

    {/*
      本站刻意不加载任何分析脚本：全站零 cookie、零第三方请求。
      这一事实同时写在 /privacy/ 与 /licenses/ 上，属于对外法律声明。
      若将来要接入分析（如 Cloudflare Web Analytics），必须先一并更新
      这两页的披露（含法律依据与保留期限），再在此处注入信标。
    */}

    {/* 全站搜索 Modal（Ctrl/Cmd+K 唤起） */}
    <SearchModal />

    {/* 最近使用工具（localStorage 持久化） —— 仅首页等需要复访入口的页面 */}
    {showRecent && <RecentTools />}

    {/* 全站快捷键：Ctrl+Enter 触发带 data-primary-action 的主按钮；/ 聚焦搜索 */}
    <script is:inline>
      (function () {
        document.addEventListener('keydown', function (e) {
          // Ctrl/Cmd + Enter —— 在工具页触发"主操作"按钮
          if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
            var target = document.querySelector('[data-primary-action]');
            if (target) {
              e.preventDefault();
              target.click();
              return;
            }
            // 没标记 data-primary-action 时，自动找 .primary 按钮
            var btn = document.querySelector('button.primary, button[class*="primary"]:not(.ghost):not(.icon-btn)');
            if (btn) { e.preventDefault(); btn.click(); }
          }
          // "/" —— 快速聚焦搜索（不在 input/textarea 内时）
          if (e.key === '/' && !/^(input|textarea|select)$/i.test(e.target.tagName)) {
            var searchBtn = document.getElementById('open-search');
            if (searchBtn) { e.preventDefault(); searchBtn.click(); }
          }
          // Esc —— 关闭搜索 Modal（如果开着）—— SearchModal 自己已经处理
        });
      })();
    </script>

    {/* Service Worker 注册 —— 离线缓存核心页 + 字体 */}
    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol !== 'file:') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { scope: '/' })
            .then(function (reg) {
              // 检查 SW 更新
              reg.addEventListener('updatefound', function () {
                var sw = reg.installing;
                sw.addEventListener('statechange', function () {
                  if (sw.state === 'activated' && navigator.serviceWorker.controller) {
                    // 新 SW 激活，提示用户刷新（轻微延迟避免抢占）
                    setTimeout(function () {
                      if (window.showToast) {
                        window.showToast('New version available — refresh to update.', { type: 'info', duration: 5000 });
                      }
                    }, 800);
                  }
                });
              });
            })
            .catch(function (e) { /* 静默失败，不影响主流程 */ });
        });
      }
    </script>

    {/* Toast 通知工具 —— 全局可用，替代 alert() / confirm()
        用法：showToast('message') 或 showToast('message', { type: 'error' })
        type: 'error' (default) | 'success' | 'info' | 'warning' */}
    <script is:inline>
    (function () {
      var DEFAULT_DURATION = 2800;
      var MAX_TOASTS = 3;

      function ensureContainer() {
        var c = document.getElementById('toast-container');
        if (!c) {
          c = document.createElement('div');
          c.id = 'toast-container';
          c.setAttribute('role', 'region');
          c.setAttribute('aria-live', 'polite');
          c.setAttribute('aria-label', 'Notifications');
          document.body.appendChild(c);
        }
        return c;
      }

      function showToast(message, opts) {
        opts = opts || {};
        var type = opts.type || 'error';
        var duration = opts.duration !== undefined ? opts.duration : DEFAULT_DURATION;

        var container = ensureContainer();

        // 限制同时显示的 toast 数量
        while (container.children.length >= MAX_TOASTS) {
          container.removeChild(container.firstChild);
        }

        var toast = document.createElement('div');
        toast.className = 'toast toast-' + type;
        toast.setAttribute('role', type === 'error' ? 'alert' : 'status');
        toast.textContent = message;

        var close = document.createElement('button');
        close.className = 'toast-close';
        close.setAttribute('aria-label', 'Dismiss notification');
        close.innerHTML = '&times;';
        close.addEventListener('click', function () { dismiss(toast); });
        toast.appendChild(close);

        container.appendChild(toast);

        // 触发进入动画
        requestAnimationFrame(function () {
          toast.classList.add('toast-in');
        });

        var timer = setTimeout(function () { dismiss(toast); }, duration);
        toast.addEventListener('mouseenter', function () { clearTimeout(timer); });
        toast.addEventListener('mouseleave', function () {
          timer = setTimeout(function () { dismiss(toast); }, 1500);
        });
      }

      function dismiss(toast) {
        if (!toast.parentNode || toast.classList.contains('toast-out')) return;
        toast.classList.add('toast-out');
        setTimeout(function () {
          if (toast.parentNode) toast.parentNode.removeChild(toast);
        }, 220);
      }

      window.showToast = showToast;
    })();
    </script>
  </body>
</html>
