---
import '@versal/ui/styles';
import { tokens, sitesSEO } from '@versal/ui';
import Header from '@versal/ui/Header.astro';
import Footer from '@versal/ui/Footer.astro';
import ConsentBanner from '@versal/ui/ConsentBanner.astro';

export interface Props {
  site: 'main' | 'devops' | 'codegen' | 'sec';
  title?: string;
  description?: string;
  canonical?: string;
  current?: string;
  /** 工具页关键词数组（可选） */
  keywords?: string[];
}

const {
  site,
  title,
  description,
  canonical,
  current,
  keywords,
} = Astro.props as Props;

const seo = sitesSEO[site];
const t = tokens.sites[site];
const pageTitle = title ? `${title} | ${t.name}` : seo.title;
const pageDesc = description || seo.description;
const pageUrl = canonical || seo.canonical;
const pageKeywords = keywords?.join(', ') || seo.keywords;

// 品牌 favicon —— 深色圆角底 + accent 色花括号（JSON 标识），按子站色彩差异化
const faviconSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='#0b0d12'/><text x='32' y='44' font-family='ui-monospace,Menlo,Consolas,monospace' font-size='30' font-weight='700' text-anchor='middle' fill='${t.accent}'>{ }</text></svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

// Cloudflare Web Analytics —— 通过 PUBLIC_CF_WEB_ANALYTICS_TOKEN 注入，未配置则不输出
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="keywords" content={pageKeywords} />
    <link rel="canonical" href={pageUrl} />

    {/* Open Graph */}
    <meta property="og:type" content={seo.og.type} />
    <meta property="og:site_name" content={seo.og.siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={pageUrl} />

    {/* Twitter */}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />

    {/* Theme color —— 随主题切换（由下方内联脚本同步更新） */}
    <meta name="theme-color" content="#0b0d12" id="meta-theme-color" />

    {/* favicon —— 品牌 SVG（按子站 accent 色） */}
    <link rel="icon" href={faviconHref} />
    <link rel="apple-touch-icon" href={faviconHref} />

    {/* 自托管字体预加载 —— 同源字体必须带 crossorigin，否则会重复下载 */}
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable.woff2" as="font" type="font/woff2" crossorigin />

    {/* 主题初始化 —— 必须内联且在 <head>，避免首屏闪烁（FOUC）。
        优先级：用户手动选择（localStorage）> 系统 prefers-color-scheme。
        未选择时跟随系统，并在系统主题变化时实时同步。 */}
    <script is:inline>
      (function () {
        var KEY = 'versal-theme';
        var root = document.documentElement;
        var meta = document.getElementById('meta-theme-color');
        function systemTheme() {
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        function stored() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) { return null; }
        }
        function paint(theme) {
          root.setAttribute('data-theme', theme);
          if (meta) meta.setAttribute('content', theme === 'light' ? '#ffffff' : '#0b0d12');
        }
        paint(stored() || systemTheme());

        window.__versalTheme = {
          key: KEY,
          current: function () { return root.getAttribute('data-theme') || 'dark'; },
          /* 手动切换：写入 localStorage，之后不再跟随系统 */
          set: function (theme) { paint(theme); try { localStorage.setItem(KEY, theme); } catch (e) {} },
          /* 清除手动选择，回到跟随系统 */
          reset: function () { try { localStorage.removeItem(KEY); } catch (e) {} paint(systemTheme()); }
        };

        if (window.matchMedia) {
          var mq = window.matchMedia('(prefers-color-scheme: light)');
          var onChange = function () { if (!stored()) paint(systemTheme()); };
          if (mq.addEventListener) mq.addEventListener('change', onChange);
          else if (mq.addListener) mq.addListener(onChange);
        }
      })();
    </script>

    {/* Cloudflare Web Analytics —— 占位 id 由子站覆盖 */}
    <slot name="head" />
  </head>
  <body class={`site-${site}`}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header site={site} current={current} />
    <main class="container" id="main">
      <slot />
    </main>
    <Footer site={site} />
    <ConsentBanner />

    {/* Cloudflare Web Analytics beacon —— 配置 PUBLIC_CF_WEB_ANALYTICS_TOKEN 后自动注入 */}
    {cfAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfAnalyticsToken}", "spa": true}`} />
    )}
  </body>
</html>