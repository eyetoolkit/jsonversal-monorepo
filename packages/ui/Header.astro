---
import { tokens } from '@versal/config/tokens';

export interface Props {
  site: string;
  current?: string;
}

const { site, current = '' } = Astro.props as Props;
const t = tokens.sites[site];

// versal site key for [data-site] on body — align with versal-brand.css presets
const SITE_KEY: Record<string, string> = {
  main: 'json',
  devops: 'devops',
  codegen: 'codegen',
  sec: 'sec',
};
const siteKey = SITE_KEY[site] || 'json';

// nav links per sub-product
const LINKS: Record<string, Array<{ label: string; href: string }>> = {
  main: [
    { label: 'Home', href: '/' },
    { label: 'Tools', href: '/tools/' },
    { label: 'Security', href: '/sec/' },
    { label: 'DevOps', href: '/devops/' },
    { label: 'Codegen', href: '/codegen/' },
  ],
  devops: [
    { label: 'Home', href: '/' },
    { label: 'Tools', href: '/devops/tools/' },
  ],
  codegen: [
    { label: 'Home', href: '/' },
    { label: 'Tools', href: '/codegen/tools/' },
  ],
  sec: [
    { label: 'Home', href: '/' },
    { label: 'Tools', href: '/sec/tools/' },
  ],
};
const links = LINKS[site] || LINKS.main;
const productLabel = t.emoji ? `${t.name}`.toLowerCase() : siteKey;
---

<header class="v-header">
  <div class="v-header__inner">
    <a class="v-logo" href="/" data-site-key={siteKey}>
      <span class="v-logo__mark">V</span>
      <span>versal</span>
      <span class="v-logo__sep">·</span>
      <span class="v-logo__product">{siteKey}</span>
    </a>
    <nav class="v-nav">
      {links.map(l => (
        <a href={l.href} class={current && (l.href === current || (l.href !== '/' && current.startsWith(l.href))) ? 'is-active' : ''}>{l.label}</a>
      ))}
    </nav>
    <div class="v-header__end">
      <button class="v-theme" id="vTheme" aria-label="Toggle theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      </button>
      <details class="v-matrix-btn">
        <summary>All products <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg></summary>
        <div class="v-matrix-pop">
          <a href="https://mquickcalc.com"><span class="v-matrix-pop__dot" style="background:#4f46e5"></span>versal everyday<small>mquickcalc.com</small></a>
          <a href="https://finance.mquickcalc.com"><span class="v-matrix-pop__dot" style="background:#059669"></span>versal finance<small>finance.mquickcalc.com</small></a>
          <a href="https://health.mquickcalc.com"><span class="v-matrix-pop__dot" style="background:#e11d48"></span>versal health<small>health.mquickcalc.com</small></a>
          <a href="https://cover.mquickcalc.com"><span class="v-matrix-pop__dot" style="background:#0f766e"></span>versal cover<small>cover.mquickcalc.com</small></a>
          <a href="/" aria-current={site === 'main' ? 'page' : undefined}><span class="v-matrix-pop__dot" style="background:#4f46e5"></span>versal json<small>jsonversal.com</small></a>
          <a href="/devops/" aria-current={site === 'devops' ? 'page' : undefined}><span class="v-matrix-pop__dot" style="background:#14b8a6"></span>versal devops<small>jsonversal.com/devops</small></a>
          <a href="/codegen/" aria-current={site === 'codegen' ? 'page' : undefined}><span class="v-matrix-pop__dot" style="background:#f59e0b"></span>versal codegen<small>jsonversal.com/codegen</small></a>
          <a href="/sec/" aria-current={site === 'sec' ? 'page' : undefined}><span class="v-matrix-pop__dot" style="background:#ef4444"></span>versal sec<small>jsonversal.com/sec</small></a>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (function(){
    var KEY='versal-theme';
    var root=document.body;
    var saved=localStorage.getItem(KEY);
    if(saved) root.setAttribute('data-theme', saved);
    var btn=document.getElementById('vTheme');
    if(btn){
      btn.addEventListener('click',function(){
        var cur=root.getAttribute('data-theme')==='dark'?'light':'dark';
        root.setAttribute('data-theme',cur);
        localStorage.setItem(KEY,cur);
      });
    }
  })();
</script>