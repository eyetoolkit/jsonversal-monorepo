---
import { tokens } from '@versal/config/tokens';

export interface Props {
  site: string;
  current?: string;
}

const { site, current = '' } = Astro.props as Props;
const t = tokens.sites[site];
const cur = current || '';

const links = [
  { label: 'Home', href: '/', match: '/' },
  { label: 'Tools', href: '/tools/', match: '/tools/' },
  { label: 'Security', href: '/sec/', match: '/sec/' },
  { label: 'DevOps', href: '/devops/', match: '/devops/' },
  { label: 'Codegen', href: '/codegen/', match: '/codegen/' },
];
const isActive = (match: string) => (match === '/' ? cur === '/' : cur.startsWith(match));
---

<header class="site-header">
  <div class="container header-inner">
    <div class="header-left">
      <a href="/" class="brand" aria-label="jsonversal home">
        <span class="brand-mark" aria-hidden="true">{t.emoji}</span>
        <span class="brand-name">
          <span class="brand-json">json</span><span class="brand-versal">versal</span>
        </span>
      </a>
      <nav class="nav" id="site-nav" aria-label="Primary">
        {links.map(l => (
          <a
            href={l.href}
            class={isActive(l.match) ? 'nav-link active' : 'nav-link'}
          >
            {l.label}
          </a>
        ))}
      </nav>
    </div>

    <div class="header-right">
      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-label="Switch to light theme"
        title="Switch theme"
      >
        {/* 深色时显示「太阳」（点击切到浅色）；浅色时显示「月亮」 */}
        <svg class="ic-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="ic-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8" />
        </svg>
      </button>

      <button
        id="nav-toggle"
        class="nav-toggle"
        type="button"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="site-nav"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var nav = document.getElementById('site-nav');
    if (toggle && nav) {
      toggle.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      nav.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () {
          nav.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    /* 主题切换 —— 实际读写由 BaseLayout 的 __versalTheme 承担 */
    var tbtn = document.getElementById('theme-toggle');
    if (tbtn && window.__versalTheme) {
      var sync = function () {
        var light = window.__versalTheme.current() === 'light';
        tbtn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
        tbtn.setAttribute('aria-pressed', light ? 'true' : 'false');
      };
      sync();
      tbtn.addEventListener('click', function () {
        window.__versalTheme.set(window.__versalTheme.current() === 'light' ? 'dark' : 'light');
        sync();
      });
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 32px;
    min-width: 0;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    transition: border-color .15s ease, color .15s ease;
  }
  .icon-btn:hover { border-color: var(--accent); color: var(--accent-text); }

  /* 主题图标切换：深色显示太阳，浅色显示月亮。
     用 :global() 是因为 html[data-theme] 在 Astro 作用域之外。 */
  .ic-sun { display: block; }
  .ic-moon { display: none; }
  :global([data-theme="light"]) .ic-sun { display: none; }
  :global([data-theme="light"]) .ic-moon { display: block; }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none !important;
    flex-shrink: 0;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    font-size: 18px;
    background: linear-gradient(135deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  .brand-name {
    font-weight: 800;
    font-size: 1.18rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand-json { color: var(--text); }
  .brand-versal { background: var(--accent-gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }

  .nav { display: flex; align-items: center; gap: 4px; }
  .nav-link {
    color: var(--text-muted);
    font-weight: 500;
    font-size: .95rem;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    transition: color .15s ease, background .15s ease;
  }
  .nav-link:hover { color: var(--text); background: var(--surface-alt); text-decoration: none; }
  .nav-link.active { color: var(--text); background: var(--surface-2); box-shadow: inset 0 0 0 1px var(--border); }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  @media (max-width: 760px) {
    .header-left { gap: 12px; }
    .nav-toggle { display: inline-flex; }
    .nav {
      position: absolute;
      top: calc(var(--header-h) - 4px);
      left: 12px;
      right: 12px;
      flex-direction: column;
      align-items: stretch;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 10px;
      box-shadow: var(--shadow-lg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity .18s ease, transform .18s ease, visibility .18s;
    }
    .nav.open { opacity: 1; visibility: visible; transform: translateY(0); }
    .nav-link { padding: 14px 14px; font-size: 1rem; min-height: 44px; display: flex; align-items: center; }
  }
</style>