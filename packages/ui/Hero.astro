---
export interface Props {
  overline?: string;
  sub?: string;
}

const { overline, sub } = Astro.props as Props;
---

<section class="hero">
  {overline && <div class="overline">{overline}</div>}
  <h1><slot /></h1>
  {sub && <p class="sub">{sub}</p>}
  {Astro.slots.has('actions') && (
    <div class="actions"><slot name="actions" /></div>
  )}
  {Astro.slots.has('chips') && (
    <div class="chips"><slot name="chips" /></div>
  )}
</section>