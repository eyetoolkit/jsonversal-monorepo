---
// Carbon Ads — 变现第一刀（jsonversal 主站工具页）
//
// 门控设计：SERVE 为占位符时渲染空（构建照常，页面不变）；
// 把 SERVE 换成 Carbon Dashboard 的 serve code（8位大写，如 CKYDAKQ2）
// 并推送 main，CI 自动上线。只出现在工具页（经 ToolPage 引入），
// 不出现在 pdf/cloak 子域（另有 Pages 项目与 CSP）。
//
// 位置：ToolPage 末尾（工具 UI + 说明正文 + 推荐之后、FAQ 之前），
// 视觉上是页脚附近的小卡片，不干扰工具使用。
//
// CSP 注意：apps/main/public/_headers 必须放行 carbonads.net
// （本仓已预放行，见 _headers 2026-11-07 commit）。
const SERVE = 'CHANGE_ME'; // TODO: 替换为 Carbon serve code

const show = SERVE !== 'CHANGE_ME';
---

{show && (
  <div class="carbon-slot">
    <div id="carbonads"></div>
    <script
      async
      src="https://carbonads.net/script.js"
      data-serve={SERVE}
      data-placement="jsonversal.com"
    ></script>
  </div>
)}

<style>
  .carbon-slot {
    margin: 2rem 0 1rem;
    border-top: 1px solid var(--border, rgba(255, 255, 255, 0.08));
    padding-top: 1rem;
  }
  .carbon-slot #carbonads {
    max-width: 100%;
  }
  /* 尊重全站暗色主题：carbon 卡片跟随 dark 变量即可，不强改其内部结构 */
</style>
