---
import { tokens } from '@versal/config/tokens';

export interface Props {
  site: string;
}

const { site } = Astro.props as Props;
const year = new Date().getFullYear();

const SITE_KEY: Record<string, string> = {
  main: 'json', devops: 'devops', codegen: 'codegen', sec: 'sec',
};
const siteKey = SITE_KEY[site] || 'json';

const POPULAR: Record<string, Array<{ label: string; href: string }>> = {
  main: [
    { label: 'JSON Formatter', href: '/tools/json-formatter/' },
    { label: 'JSON Schema Generator', href: '/tools/json-schema-generator/' },
    { label: 'JSON → Zod', href: '/tools/json-to-zod/' },
    { label: 'LLM Token Calculator', href: '/tools/llm-token-calculator/' },
    { label: 'UUID v7', href: '/tools/uuid-v7/' },
  ],
  devops: [
    { label: 'YAML ↔ JSON', href: '/devops/tools/yaml-json/' },
    { label: 'Base64', href: '/devops/tools/base64/' },
    { label: 'Regex tester', href: '/devops/tools/regex/' },
    { label: 'CIDR', href: '/devops/tools/cidr-calculator/' },
    { label: 'Timestamp', href: '/devops/tools/timestamp/' },
  ],
  codegen: [
    { label: '.gitignore', href: '/codegen/tools/gitignore/' },
    { label: 'Docker Compose', href: '/codegen/tools/docker-compose/' },
    { label: 'JSON Schema → TS', href: '/codegen/tools/schema-to-typescript/' },
    { label: 'SQL Formatter', href: '/codegen/tools/sql-formatter/' },
    { label: 'cURL → fetch', href: '/codegen/tools/curl-to-fetch/' },
  ],
  sec: [
    { label: 'Password', href: '/sec/tools/password-generator/' },
    { label: 'Hash', href: '/sec/tools/hash-generator/' },
    { label: 'JWT decoder', href: '/sec/tools/jwt-decoder/' },
    { label: 'AES', href: '/sec/tools/aes/' },
    { label: 'RSA keygen', href: '/sec/tools/rsa-keygen/' },
  ],
};
const popular = POPULAR[site] || POPULAR.main;
---

<footer class="v-footer">
  <div class="v-wrap">
    <nav class="v-matrix-strip" aria-label="All versal products">
      <a href="https://mquickcalc.com"><span class="v-matrix-strip__dot" style="background:#4f46e5"></span>versal everyday</a>
      <a href="https://finance.mquickcalc.com"><span class="v-matrix-strip__dot" style="background:#059669"></span>versal finance</a>
      <a href="https://health.mquickcalc.com"><span class="v-matrix-strip__dot" style="background:#e11d48"></span>versal health</a>
      <a href="https://cover.mquickcalc.com"><span class="v-matrix-strip__dot" style="background:#0f766e"></span>versal cover</a>
      <a href="/" aria-current={site === 'main' ? 'page' : undefined}><span class="v-matrix-strip__dot" style="background:#4f46e5"></span>versal json</a>
      <a href="/devops/" aria-current={site === 'devops' ? 'page' : undefined}><span class="v-matrix-strip__dot" style="background:#14b8a6"></span>versal devops</a>
      <a href="/codegen/" aria-current={site === 'codegen' ? 'page' : undefined}><span class="v-matrix-strip__dot" style="background:#f59e0b"></span>versal codegen</a>
      <a href="/sec/" aria-current={site === 'sec' ? 'page' : undefined}><span class="v-matrix-strip__dot" style="background:#ef4444"></span>versal sec</a>
    </nav>

    <div class="v-footer__cols">
      <div>
        <div class="v-footer__brand"><span class="v-logo__mark">V</span>versal</div>
        <p class="v-footer__about">A toolbox brand. Eight small sites, one shared design language. Each tool runs in your browser; we don't see your input.</p>
      </div>
      <div class="v-footer__col">
        <h4>Popular</h4>
        <ul>
          {popular.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div class="v-footer__col">
        <h4>Resources</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/sitemap.xml">Sitemap</a></li>
          <li><a href="https://mquickcalc.com">Other versal tools</a></li>
        </ul>
      </div>
      <div class="v-footer__col">
        <h4>Legal</h4>
        <ul>
          <li><a href="/trust/">Trust Center</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
          <li><a href="/licenses/">Licenses</a></li>
        </ul>
      </div>
    </div>

    <div class="v-footer__bottom">
      <span>© {year} versal · jsonversal.com</span>
      <span>Runs in your browser. We see nothing.</span>
    </div>
  </div>
</footer>