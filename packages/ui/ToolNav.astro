---
// ToolNav — contextual sibling-tool navigation bar for tool pages
// Renders a horizontal nav of related tools in the same category

export interface Props {
  currentHref: string; // e.g. '/sec/tools/bcrypt/'
}

const { currentHref } = Astro.props as Props;

// Define all tools by section
const sections = {
  '/tools/': [
    { href: '/tools/json-diff/', label: 'JSON Diff — Compare Two JSON Files Online' },
    { href: '/tools/json-escape/', label: 'JSON Escape & Unescape' },
    { href: '/tools/json-formatter/', label: 'JSON Formatter & Validator' },
    { href: '/tools/json-minify/', label: 'JSON Minify & Compress' },
    { href: '/tools/json-schema-builder/', label: 'JSON Schema Builder — Visual Schema Editor' },
    { href: '/tools/json-schema-generator/', label: 'JSON Schema Generator' },
    { href: '/tools/json-schema-sample-generator/', label: 'JSON Schema Sample Data Generator' },
    { href: '/tools/json-schema-validator/', label: 'JSON Schema Validator — Draft 2020-12, Free' },
    { href: '/tools/json-sorter/', label: 'JSON Sorter & Deduper' },
    { href: '/tools/json-statistics/', label: 'JSON Statistics & Structure Analyzer' },
    { href: '/tools/json-to-csharp/', label: 'JSON to C# Class Generator — Online, Free' },
    { href: '/tools/json-to-go/', label: 'JSON to Go Struct' },
    { href: '/tools/json-to-pydantic/', label: 'JSON to Pydantic Model' },
    { href: '/tools/json-to-typescript/', label: 'JSON to TypeScript Interface' },
    { href: '/tools/json-to-zod/', label: 'JSON to Zod Schema' },
    { href: '/tools/json-repair/', label: 'JSON Repair — Fix Broken JSON' },
    { href: '/tools/json-to-java/', label: 'JSON to Java Class' },
    { href: '/tools/json-to-rust/', label: 'JSON to Rust Struct' },
    { href: '/tools/json-to-kotlin/', label: 'JSON to Kotlin Data Class' },
    { href: '/tools/jsonpath-tester/', label: 'JSONPath Tester — Test JSON Queries Online' },
    { href: '/tools/llm-token-calculator/', label: 'LLM Token Estimate & Pricing Calculator' },
    { href: '/tools/markdown-preview/', label: 'Markdown Editor & Live Preview' },
    { href: '/tools/mock-data-generator/', label: 'Mock Data Generator' },
    { href: '/tools/text-diff/', label: 'Text Diff — Compare Two Texts Line by Line' },
    { href: '/tools/uuid-v7/', label: 'UUID v7 Generator & Timestamp Decoder' },
    { href: '/tools/xml-formatter/', label: 'XML Formatter & Validator' },
    { href: '/tools/yaml-formatter/', label: 'YAML Formatter' },
  ],
  '/sec/': [
    { href: '/sec/tools/aes/', label: 'AES Encryption / Decryption' },
    { href: '/sec/tools/bcrypt/', label: 'BCrypt Hash & Verify' },
    { href: '/sec/tools/file-checksum/', label: 'File Checksum Calculator' },
    { href: '/sec/tools/hash-generator/', label: 'Hash & HMAC Generator — MD5, SHA-1 to SHA-512' },
    { href: '/sec/tools/hash/', label: 'Hash Generator — MD5, SHA-1, SHA-256 Online' },
    { href: '/sec/tools/hmac/', label: 'HMAC Generator — Sign Messages with SHA-256' },
    { href: '/sec/tools/jwt-decoder/', label: 'JWT Decoder — Decode and Verify Tokens' },
    { href: '/sec/tools/jwt-generator/', label: 'JWT Generator & Signer' },
    { href: '/sec/tools/passphrase-generator/', label: 'Passphrase Generator (Diceware-style)' },
    { href: '/sec/tools/password-generator/', label: 'Random Password Generator' },
    { href: '/sec/tools/random-token/', label: 'Random Token Generator' },
    { href: '/sec/tools/rsa-keygen/', label: 'RSA Key Pair Generator' },
    { href: '/sec/tools/secret-scanner/', label: 'Secret & API Key Scanner' },
    { href: '/sec/tools/x509-decoder/', label: 'X.509 Certificate Decoder' },
  ],
  '/devops/': [
    { href: '/devops/tools/base64/', label: 'Base64 Encoder / Decoder' },
    { href: '/devops/tools/basic-auth-generator/', label: 'Basic Auth Header Generator' },
    { href: '/devops/tools/cidr-calculator/', label: 'CIDR / Subnet Calculator' },
    { href: '/devops/tools/crontab/', label: 'Crontab Explainer' },
    { href: '/devops/tools/cron-parser/', label: 'Crontab Parser — Explain cron expressions' },
    { href: '/devops/tools/json-viewer/', label: 'JSON Tree Viewer' },
    { href: '/devops/tools/k8s-generator/', label: 'Kubernetes YAML Generator' },
    { href: '/devops/tools/log-parser/', label: 'Log Line Parser' },
    { href: '/devops/tools/number-base/', label: 'Number Base Converter' },
    { href: '/devops/tools/qr-code-generator/', label: 'QR Code Generator — Create QR Codes Free' },
    { href: '/devops/tools/regex/', label: 'Regex Tester — Test Regular Expressions' },
    { href: '/devops/tools/regex-advanced/', label: 'Regex Tester with Explanations & Groups' },
    { href: '/tools/regex-explainer/', label: 'Regex Explainer' },
    { href: '/devops/tools/timestamp/', label: 'Unix Timestamp Converter' },
    { href: '/devops/tools/url-codec/', label: 'URL Encoder & Decoder' },
    { href: '/devops/tools/uuid-generator/', label: 'UUID v4 Generator' },
    { href: '/devops/tools/yaml-json/', label: 'YAML ↔ JSON Converter' },
  ],
  '/codegen/': [
    { href: '/codegen/tools/env-generator/', label: '.env Template Generator' },
    { href: '/codegen/tools/gitignore/', label: '.gitignore Generator' },
    { href: '/codegen/tools/base64-image/', label: 'Base64 Image Viewer' },
    { href: '/codegen/tools/csv-to-json/', label: 'CSV to JSON Converter' },
    { href: '/codegen/tools/curl-to-fetch/', label: 'cURL to Fetch Converter' },
    { href: '/codegen/tools/curl-to-python/', label: 'cURL to Python (requests)' },
    { href: '/codegen/tools/docker-compose/', label: 'Docker Compose Generator' },
    { href: '/codegen/tools/html-escaper/', label: 'HTML Entity Escaper' },
    { href: '/codegen/tools/json-xml/', label: 'JSON ↔ XML Converter' },
    { href: '/codegen/tools/xml-to-json/', label: 'XML to JSON Converter' },
    { href: '/codegen/tools/json-to-yaml/', label: 'JSON to YAML Converter' },
    { href: '/codegen/tools/schema-to-typescript/', label: 'JSON Schema to TypeScript' },
    { href: '/codegen/tools/json-to-csv/', label: 'JSON to CSV Converter' },
    { href: '/codegen/tools/json-to-python/', label: 'JSON to Python Dict' },
    { href: '/codegen/tools/sql-generator/', label: 'JSON to SQL Generator' },
    { href: '/codegen/tools/llm-structured-output-validator/', label: 'LLM Structured Output Validator' },
    { href: '/codegen/tools/sql-formatter/', label: 'SQL Formatter' },
    { href: '/codegen/tools/sql-validator/', label: 'SQL Validator — Check SQL Syntax Online' },
  ],
};

// Find which section this tool belongs to
const sectionKey = Object.keys(sections).find(k => currentHref.startsWith(k));
const siblingTools = sectionKey ? sections[sectionKey as keyof typeof sections] : [];
const currentIndex = siblingTools.findIndex(t => t.href === currentHref);
---

<nav class="tool-nav" aria-label="Related tools">
  <div class="tool-nav-inner">
    {siblingTools.map((tool, i) => (
      <a
        href={tool.href}
        class={i === currentIndex ? 'tool-nav-link active' : 'tool-nav-link'}
        aria-current={i === currentIndex ? 'page' : undefined}
      >
        {tool.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .tool-nav {
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .tool-nav-inner {
    display: flex;
    gap: 2px;
    padding: 0.5rem 0;
    min-width: max-content;
  }
  .tool-nav-link {
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s, color 0.15s;
  }
  .tool-nav-link:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .tool-nav-link.active {
    background: var(--accent-soft);
    color: var(--accent-text);
    font-weight: 600;
  }
</style>
