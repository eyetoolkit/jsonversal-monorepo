---
// SearchModal — 全站工具搜索（Ctrl/Cmd+K 唤起）
// 数据源：客户端内联 TOOLS 数组（与 packages/config/all-tools.js 同步）
// 行为：
//   - Ctrl+K / Cmd+K 打开，Esc 关闭
//   - 输入即搜（无需回车）
//   - 上下箭头选项目，Enter 跳转
//   - 选中状态支持高亮 + 回车打开
//   - 焦点回到输入框时保持搜索词
//
// 用法（在 BaseLayout 内引用一次即可）：
//   <SearchModal />
---

<dialog id="search-modal" class="search-modal" aria-label="Search tools">
  <div class="search-card">
    <div class="search-row">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder="Search 69 tools... (try: jwt, uuid, json, hash)"
        autocomplete="off"
        aria-label="Search tools"
        spellcheck="false"
      />
      <kbd class="search-kbd">esc</kbd>
    </div>
    <ul class="search-results" id="search-results" role="listbox"></ul>
    <div class="search-empty" id="search-empty" hidden>No tools match your search.</div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style>
  .search-modal {
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    max-width: 100vw;
    max-height: 100vh;
    inset: 0;
  }
  .search-modal::backdrop {
    background: rgba(0, 0, 0, .55);
    backdrop-filter: blur(4px);
  }
  .search-modal[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }
  .search-card {
    width: min(640px, 92vw);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    font-size: .95rem;
  }
  .search-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }
  .search-row svg { color: var(--text-muted); flex-shrink: 0; }
  #search-input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
    outline: none;
    padding: 0;
  }
  #search-input::placeholder { color: var(--text-dim); }
  .search-kbd {
    font-family: var(--font-mono, ui-monospace, "Geist Mono", monospace);
    font-size: .72rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 6px 0;
    max-height: 60vh;
    overflow: auto;
  }
  .search-results li {
    padding: 0;
  }
  .search-results a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    color: var(--text);
    text-decoration: none !important;
    border-left: 3px solid transparent;
  }
  .search-results a:hover,
  .search-results a.active {
    background: var(--surface-2);
    border-left-color: var(--accent);
  }
  .search-results .result-section {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--text-dim);
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
    flex-shrink: 0;
  }
  .search-results .result-main {
    flex: 1;
    min-width: 0;
  }
  .search-results .result-title {
    font-weight: 600;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-results .result-desc {
    font-size: .82rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-empty {
    padding: 24px 16px;
    text-align: center;
    color: var(--text-muted);
    font-size: .9rem;
  }
  .search-foot {
    display: flex;
    gap: 16px;
    padding: 8px 16px;
    border-top: 1px solid var(--border);
    font-size: .75rem;
    color: var(--text-dim);
    background: var(--surface-alt);
  }
  .search-foot kbd {
    display: inline-block;
    font-family: var(--font-mono, ui-monospace, "Geist Mono", monospace);
    font-size: .7rem;
    padding: 1px 5px;
    margin: 0 2px;
    border-radius: 3px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
</style>

<script is:inline>
  (function () {
    const modal = document.getElementById('search-modal');
    if (!modal) return;
    const input = document.getElementById('search-input');
    const list = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');

    /** 内置工具数据（与 packages/config/all-tools.js 同步——SSR 友好） */
    const TOOLS = [
      { title: 'JSON Diff', description: 'Compare two JSON documents.', href: '/tools/json-diff/', section: 'tools', keywords: ['json diff','compare'] },
      { title: 'JSON Escape & Unescape', description: 'Escape text into a JSON string.', href: '/tools/json-escape/', section: 'tools', keywords: ['escape','unescape'] },
      { title: 'JSON Formatter & Validator', description: 'Pretty-print, validate, minify JSON.', href: '/tools/json-formatter/', section: 'tools', keywords: ['formatter','validator','pretty'] },
      { title: 'JSON Minify & Compress', description: 'Strip whitespace from JSON.', href: '/tools/json-minify/', section: 'tools', keywords: ['minify','compress'] },
      { title: 'JSON Schema Builder', description: 'Build JSON Schemas visually.', href: '/tools/json-schema-builder/', section: 'tools', keywords: ['schema builder'] },
      { title: 'JSON Schema Generator', description: 'Generate JSON Schema for LLM.', href: '/tools/json-schema-generator/', section: 'tools', keywords: ['schema','llm'] },
      { title: 'JSON Schema Sample Data', description: 'Generate sample JSON from schema.', href: '/tools/json-schema-sample-generator/', section: 'tools', keywords: ['sample','mock'] },
      { title: 'JSON Schema Validator', description: 'Validate JSON against schema.', href: '/tools/json-schema-validator/', section: 'tools', keywords: ['validator','draft-07'] },
      { title: 'JSON Sorter & Deduper', description: 'Sort object keys, dedupe items.', href: '/tools/json-sorter/', section: 'tools', keywords: ['sort','dedupe'] },
      { title: 'JSON Statistics', description: 'Analyze JSON structure.', href: '/tools/json-statistics/', section: 'tools', keywords: ['stats','analyze'] },
      { title: 'JSON to C# Class', description: 'Generate C# POCO classes.', href: '/tools/json-to-csharp/', section: 'tools', keywords: ['csharp','c#'] },
      { title: 'JSON to Go Struct', description: 'Convert JSON to Go struct.', href: '/tools/json-to-go/', section: 'tools', keywords: ['go'] },
      { title: 'JSON to Pydantic Model', description: 'Generate Pydantic v2 models.', href: '/tools/json-to-pydantic/', section: 'tools', keywords: ['pydantic','python'] },
      { title: 'JSON to TypeScript', description: 'Convert JSON to TS interface.', href: '/tools/json-to-typescript/', section: 'tools', keywords: ['typescript','ts'] },
      { title: 'JSON to Zod Schema', description: 'Infer Zod schema from JSON.', href: '/tools/json-to-zod/', section: 'tools', keywords: ['zod'] },
      { title: 'JSONPath Tester', description: 'Test JSONPath expressions.', href: '/tools/jsonpath-tester/', section: 'tools', keywords: ['jsonpath','query'] },
      { title: 'LLM Token & Pricing Calculator', description: 'Estimate tokens and cost across LLMs.', href: '/tools/llm-token-calculator/', section: 'tools', keywords: ['llm','token','gpt','claude','cost'] },
      { title: 'Markdown Editor & Live Preview', description: 'Write Markdown with live preview.', href: '/tools/markdown-preview/', section: 'tools', keywords: ['markdown','md'] },
      { title: 'Mock Data Generator', description: 'Generate realistic fake JSON.', href: '/tools/mock-data-generator/', section: 'tools', keywords: ['mock','fake'] },
      { title: 'Text Diff', description: 'Compare two texts.', href: '/tools/text-diff/', section: 'tools', keywords: ['text diff'] },
      { title: 'UUID v7 Generator', description: 'Generate RFC 9562 UUID v7.', href: '/tools/uuid-v7/', section: 'tools', keywords: ['uuid','uuid v7'] },
      { title: 'XML Formatter & Validator', description: 'Pretty-print XML.', href: '/tools/xml-formatter/', section: 'tools', keywords: ['xml'] },
      { title: 'YAML Formatter & Validator', description: 'Format YAML.', href: '/tools/yaml-formatter/', section: 'tools', keywords: ['yaml'] },
      { title: 'AES Encryption / Decryption', description: 'Encrypt/decrypt with AES.', href: '/sec/tools/aes/', section: 'sec', keywords: ['aes','encryption'] },
      { title: 'BCrypt Hash & Verify', description: 'Bcrypt password hash.', href: '/sec/tools/bcrypt/', section: 'sec', keywords: ['bcrypt','password'] },
      { title: 'File Checksum Calculator', description: 'SHA-256 of a file.', href: '/sec/tools/file-checksum/', section: 'sec', keywords: ['checksum','sha-256'] },
      { title: 'Hash & HMAC Generator', description: 'MD5/SHA/HMAC generator.', href: '/sec/tools/hash-generator/', section: 'sec', keywords: ['hash','hmac','md5'] },
      { title: 'Hash Generator', description: 'MD5/SHA-1/SHA-256 of text.', href: '/sec/tools/hash/', section: 'sec', keywords: ['hash','sha'] },
      { title: 'HMAC Generator', description: 'HMAC signatures.', href: '/sec/tools/hmac/', section: 'sec', keywords: ['hmac'] },
      { title: 'JWT Decoder', description: 'Decode JWT tokens.', href: '/sec/tools/jwt-decoder/', section: 'sec', keywords: ['jwt','decode'] },
      { title: 'JWT Generator', description: 'Sign JWTs.', href: '/sec/tools/jwt-generator/', section: 'sec', keywords: ['jwt','sign'] },
      { title: 'Passphrase Generator', description: 'Diceware passphrases.', href: '/sec/tools/passphrase-generator/', section: 'sec', keywords: ['passphrase','diceware'] },
      { title: 'Password Generator', description: 'Random passwords.', href: '/sec/tools/password-generator/', section: 'sec', keywords: ['password'] },
      { title: 'Random Token Generator', description: 'Secure random tokens.', href: '/sec/tools/random-token/', section: 'sec', keywords: ['token','random'] },
      { title: 'RSA Key Pair Generator', description: 'RSA 2048/3072/4096.', href: '/sec/tools/rsa-keygen/', section: 'sec', keywords: ['rsa','key pair'] },
      { title: 'Secret & API Key Scanner', description: 'Detect leaked credentials.', href: '/sec/tools/secret-scanner/', section: 'sec', keywords: ['secret','api key','leaked'] },
      { title: 'X.509 Certificate Decoder', description: 'Decode X.509 certs.', href: '/sec/tools/x509-decoder/', section: 'sec', keywords: ['x509','certificate'] },
      { title: 'Base64 Encoder / Decoder', description: 'Encode/decode Base64.', href: '/devops/tools/base64/', section: 'devops', keywords: ['base64'] },
      { title: 'Basic Auth Header Generator', description: 'HTTP Basic Auth headers.', href: '/devops/tools/basic-auth-generator/', section: 'devops', keywords: ['basic auth'] },
      { title: 'CIDR / Subnet Calculator', description: 'Subnet calculator.', href: '/devops/tools/cidr-calculator/', section: 'devops', keywords: ['cidr','subnet'] },
      { title: 'Crontab Explainer', description: 'Plain-English crontab.', href: '/devops/tools/crontab/', section: 'devops', keywords: ['crontab','cron'] },
      { title: 'Crontab Parser', description: 'Cron parser with preview.', href: '/devops/tools/cron-parser/', section: 'devops', keywords: ['cron','parser'] },
      { title: 'JSON Tree Viewer', description: 'JSON as collapsible tree.', href: '/devops/tools/json-viewer/', section: 'devops', keywords: ['tree','viewer'] },
      { title: 'Kubernetes YAML Generator', description: 'K8s Deployment YAML.', href: '/devops/tools/k8s-generator/', section: 'devops', keywords: ['kubernetes','k8s','yaml'] },
      { title: 'Log Line Parser', description: 'Parse nginx/Apache logs.', href: '/devops/tools/log-parser/', section: 'devops', keywords: ['log','nginx'] },
      { title: 'Number Base Converter', description: 'Binary/Octal/Decimal/Hex.', href: '/devops/tools/number-base/', section: 'devops', keywords: ['base','binary','hex'] },
      { title: 'QR Code Generator', description: 'Generate QR codes.', href: '/devops/tools/qr-code-generator/', section: 'devops', keywords: ['qr'] },
      { title: 'Regex Tester', description: 'Test regex live.', href: '/devops/tools/regex/', section: 'devops', keywords: ['regex','regexp'] },
      { title: 'Regex Tester with Explanations', description: 'Advanced regex tester.', href: '/devops/tools/regex-advanced/', section: 'devops', keywords: ['regex','advanced'] },
      { title: 'Unix Timestamp Converter', description: 'Unix ts to date.', href: '/devops/tools/timestamp/', section: 'devops', keywords: ['timestamp','unix'] },
      { title: 'URL Encoder & Decoder', description: 'Percent-encode URLs.', href: '/devops/tools/url-codec/', section: 'devops', keywords: ['url','encode'] },
      { title: 'UUID v4 Generator', description: 'Generate UUID v4.', href: '/devops/tools/uuid-generator/', section: 'devops', keywords: ['uuid','uuid v4'] },
      { title: 'YAML ↔ JSON Converter', description: 'YAML to JSON.', href: '/devops/tools/yaml-json/', section: 'devops', keywords: ['yaml','json'] },
      { title: '.env Template Generator', description: 'Generate .env template.', href: '/codegen/tools/env-generator/', section: 'codegen', keywords: ['env','dotenv'] },
      { title: '.gitignore Generator', description: 'Generate .gitignore.', href: '/codegen/tools/gitignore/', section: 'codegen', keywords: ['gitignore','git'] },
      { title: 'Base64 Image Viewer', description: 'Base64 <-> Image.', href: '/codegen/tools/base64-image/', section: 'codegen', keywords: ['base64 image','data uri'] },
      { title: 'CSV to JSON Converter', description: 'CSV/TSV to JSON.', href: '/codegen/tools/csv-to-json/', section: 'codegen', keywords: ['csv','json'] },
      { title: 'cURL to Fetch Converter', description: 'curl -> fetch().', href: '/codegen/tools/curl-to-fetch/', section: 'codegen', keywords: ['curl','fetch'] },
      { title: 'cURL to Python (requests)', description: 'curl -> Python requests.', href: '/codegen/tools/curl-to-python/', section: 'codegen', keywords: ['curl','python'] },
      { title: 'Docker Compose Generator', description: 'docker-compose.yml.', href: '/codegen/tools/docker-compose/', section: 'codegen', keywords: ['docker','compose'] },
      { title: 'HTML Entity Escaper', description: 'HTML escape.', href: '/codegen/tools/html-escaper/', section: 'codegen', keywords: ['html','escape'] },
      { title: 'JSON ↔ XML Converter', description: 'JSON <-> XML.', href: '/codegen/tools/json-xml/', section: 'codegen', keywords: ['json','xml'] },
      { title: 'JSON Schema to TypeScript', description: 'JSON Schema -> TS.', href: '/codegen/tools/schema-to-typescript/', section: 'codegen', keywords: ['schema','typescript'] },
      { title: 'JSON to CSV Converter', description: 'JSON -> CSV.', href: '/codegen/tools/json-to-csv/', section: 'codegen', keywords: ['json','csv'] },
      { title: 'JSON to Python Dict', description: 'JSON -> Python dict.', href: '/codegen/tools/json-to-python/', section: 'codegen', keywords: ['python','dict'] },
      { title: 'JSON to SQL Generator', description: 'CREATE TABLE / INSERT.', href: '/codegen/tools/sql-generator/', section: 'codegen', keywords: ['sql'] },
      { title: 'LLM Structured Output Validator', description: 'Validate LLM JSON schemas.', href: '/codegen/tools/llm-structured-output-validator/', section: 'codegen', keywords: ['llm','structured','openai'] },
      { title: 'SQL Formatter', description: 'Format SQL.', href: '/codegen/tools/sql-formatter/', section: 'codegen', keywords: ['sql','format'] },
      { title: 'SQL Validator', description: 'Validate SQL syntax.', href: '/codegen/tools/sql-validator/', section: 'codegen', keywords: ['sql','validator'] },
    ];

    function search(q) {
      const query = (q || '').toLowerCase().trim();
      if (!query) return [];
      const words = query.split(/\s+/);
      const results = [];
      for (const t of TOOLS) {
        const titleL = t.title.toLowerCase();
        const descL = t.description.toLowerCase();
        const kwL = t.keywords.join(' ').toLowerCase();
        let score = 0, allMatch = true;
        for (const w of words) {
          const inTitle = titleL.includes(w);
          const inDesc = descL.includes(w);
          const inKw = kwL.includes(w);
          if (!inTitle && !inDesc && !inKw) { allMatch = false; break; }
          if (inTitle) score += 10;
          if (inDesc) score += 3;
          if (inKw) score += 5;
          if (titleL.indexOf(w) === 0) score += 5;
        }
        if (allMatch) results.push({ ...t, _score: score });
      }
      results.sort((a, b) => b._score - a._score || a.title.localeCompare(b.title));
      return results.slice(0, 30);
    }

    let activeIdx = -1;
    let currentResults = [];

    function render(q) {
      currentResults = search(q);
      activeIdx = currentResults.length > 0 ? 0 : -1;
      if (currentResults.length === 0) {
        list.innerHTML = '';
        empty.hidden = !q;
        return;
      }
      empty.hidden = true;
      const sectionMap = { tools: 'JSON', sec: 'Security', devops: 'DevOps', codegen: 'Codegen' };
      list.innerHTML = currentResults.map((r, i) => `
        <li>
          <a href="${r.href}" data-i="${i}" class="${i === 0 ? 'active' : ''}">
            <span class="result-section">${sectionMap[r.section] || r.section}</span>
            <span class="result-main">
              <span class="result-title">${escapeHtml(r.title)}</span>
              <span class="result-desc">${escapeHtml(r.description)}</span>
            </span>
          </a>
        </li>
      `).join('');
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    }

    function setActive(i) {
      if (i < 0) i = currentResults.length - 1;
      if (i >= currentResults.length) i = 0;
      activeIdx = i;
      const links = list.querySelectorAll('a');
      links.forEach((a, idx) => a.classList.toggle('active', idx === i));
      const active = links[i];
      if (active) active.scrollIntoView({ block: 'nearest' });
    }

    function open() {
      // 从 URL ?q= 读取初值
      const params = new URLSearchParams(location.search);
      const q = params.get('q') || '';
      input.value = q;
      modal.showModal();
      render(q);
      // 选中文本，方便直接覆盖搜索
      setTimeout(() => { input.focus(); input.select(); }, 30);
      document.documentElement.style.overflow = 'hidden';
    }

    function close() {
      modal.close();
      document.documentElement.style.overflow = '';
    }

    // —— 事件 ——
    input.addEventListener('input', () => render(input.value));

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIdx + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIdx - 1); }
      else if (e.key === 'Enter') {
        e.preventDefault();
        const r = currentResults[activeIdx];
        if (r) location.href = r.href;
      } else if (e.key === 'Escape') { e.preventDefault(); close(); }
    });

    // 点击卡片外部关闭
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });
    modal.addEventListener('cancel', (e) => { e.preventDefault(); close(); });

    // 全局快捷键 Ctrl+K / Cmd+K
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.open) close(); else open();
      }
    });

    // Header 上的搜索按钮（任何带 id="open-search" 的元素）
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('#open-search');
      if (btn) { e.preventDefault(); open(); }
    });

    // 如果 URL 带 ?search=1，自动打开
    const params2 = new URLSearchParams(location.search);
    if (params2.get('search') === '1') open();
  })();
</script>