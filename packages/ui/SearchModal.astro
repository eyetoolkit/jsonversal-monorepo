---
// SearchModal — 全站工具搜索（Ctrl/Cmd+K 唤起）
// 数据源：客户端内联 TOOLS 数组（与 packages/config/all-tools.js 同步）
// 行为：
//   - Ctrl+K / Cmd+K 打开，Esc 关闭
//   - 输入即搜（无需回车）
//   - 上下箭头选项目，Enter 跳转
//   - 选中状态支持高亮 + 回车打开
//   - 焦点回到输入框时保持搜索词
//
// 用法（在 BaseLayout 内引用一次即可）：
//   <SearchModal />
---

<dialog id="search-modal" class="search-modal" aria-label="Search tools">
  <div class="search-card">
    <div class="search-row">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder="Search tools... (try: jwt, uuid, json, hash)"
        autocomplete="off"
        aria-label="Search tools"
        spellcheck="false"
      />
      <kbd class="search-kbd">esc</kbd>
    </div>
    <ul class="search-results" id="search-results" role="listbox"></ul>
    <div class="search-empty" id="search-empty" hidden>No tools match your search.</div>
    <div class="search-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  </div>
</dialog>

<style>
  .search-modal {
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    max-width: 100vw;
    max-height: 100vh;
    inset: 0;
  }
  .search-modal::backdrop {
    background: rgba(0, 0, 0, .55);
    backdrop-filter: blur(4px);
  }
  .search-modal[open] {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }
  .search-card {
    width: min(640px, 92vw);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    font-size: .95rem;
  }
  .search-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
  }
  .search-row svg { color: var(--text-muted); flex-shrink: 0; }
  #search-input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 1.05rem;
    outline: none;
    padding: 0;
  }
  #search-input::placeholder { color: var(--text-dim); }
  .search-kbd {
    font-family: var(--font-mono, ui-monospace, "Geist Mono", monospace);
    font-size: .72rem;
    padding: 2px 6px;
    border-radius: 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 6px 0;
    max-height: 60vh;
    overflow: auto;
  }
  .search-results li {
    padding: 0;
  }
  .search-results a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    color: var(--text);
    text-decoration: none !important;
    border-left: 3px solid transparent;
  }
  .search-results a:hover,
  .search-results a.active {
    background: var(--surface-2);
    border-left-color: var(--accent);
  }
  .search-results .result-section {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--text-dim);
    background: var(--surface-alt);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
    flex-shrink: 0;
  }
  .search-results .result-main {
    flex: 1;
    min-width: 0;
  }
  .search-results .result-title {
    font-weight: 600;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-results .result-desc {
    font-size: .82rem;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-empty {
    padding: 24px 16px;
    text-align: center;
    color: var(--text-muted);
    font-size: .9rem;
  }
  .search-foot {
    display: flex;
    gap: 16px;
    padding: 8px 16px;
    border-top: 1px solid var(--border);
    font-size: .75rem;
    color: var(--text-dim);
    background: var(--surface-alt);
  }
  .search-foot kbd {
    display: inline-block;
    font-family: var(--font-mono, ui-monospace, "Geist Mono", monospace);
    font-size: .7rem;
    padding: 1px 5px;
    margin: 0 2px;
    border-radius: 3px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
</style>

    <!-- 搜索数据单一源：构建时由 all-tools.js 生成；逻辑外置，跨页共享缓存 -->
    <script is:inline src="/js/versal-tools-data.js" defer></script>
    <script is:inline src="/js/versal-search-modal.js" defer></script>
