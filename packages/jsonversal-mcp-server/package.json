{
  "name": "@jsonversal/mcp-server",
  "version": "1.0.0",
  "description": "jsonversal MCP Server — 25 deterministic tools (JSON/YAML/CSV/Base64/URL/number-base/timestamp/UUID/password/JSONPath/Regex/JWT/BCrypt/hash) for AI Agents. MCP (stdio) + REST (HTTP).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jsonversal-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:mcp": "STDOUT_MODE=mcp node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node test.mjs && node test-extra.mjs",
    "test:mcp": "node test-mcp.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
